def _sub_body(msg, dk):
    """Тело ключа после префикса. Пусто, если сравнивать нечего.

    Если _dup_key вернул "" (нечитаемый объект) и текста тоже нет, вернуть
    md5("") нельзя: он одинаков у всех и даст ложный дубль.
    """
    if dk and "|" in dk:
        return dk.split("|", 1)[1]
    t = _text_norm(_msg_text(msg))
    return _md5(t) if t else ""


# Соответствие «префикс части комбо-ключа -> режим». Раньше этот словарь
# (33 записи) создавался ЛИТЕРАЛОМ внутри _combo_parts, то есть заново на
# КАЖДОЕ сообщение (и ещё раз на каждый вызов _combo_kinds/_combo_key).
# Содержимое не зависит от состояния — держим константой модуля.
_PFX_MODE = {
    "photo": "photo", "video": "video", "gif": "gif", "doc": "doc",
    "audio": "audio", "voice": "voice", "poll": "poll", "quiz": "quiz",
    "webpage": "webpage", "geo": "geo", "venue": "venue",
    "contact": "contact", "dice": "dice", "game": "game",
    "story": "story", "invoice": "invoice", "giveawayres": "giveawayres",
    "giveaway": "giveaway", "paidmedia": "paidmedia", "todo": "todo",
    "videostream": "videostream", "premium": "premium",
    "sticker": "sticker", "stickerset": "stickerset", "roundv": "roundv",
    "link": "link", "text": "text", "caption": "text",
    "alt": "doc", "ansmedia": "poll", "attmedia": "poll",
    "todoitem": "todo", "todotitle": "todo",
    "gachan": "giveaway", "gawin": "giveaway",
    "paiditem": "paidmedia", "paid": "paidmedia",
}


def _combo_parts(msg):
    """Список частей содержимого сообщения (для составного ключа).

    Пример: фото с подписью -> ['photo:123', 'caption:md5'].
    Сообщение со всем сразу -> все части. Одинаковые комбо склеятся,
    разные (иное фото или иная подпись) — нет.
    """
    parts = []
    kind = _kind_of(msg)
    text = _msg_text(msg)

    if kind == "photo":
        photo = getattr(_msg_media(msg), "photo", None)
        pid = getattr(photo, "id", 0) if photo is not None else 0
        if _safe_int(pid):
            parts.append("photo:%d" % _safe_int(pid))
        # подпись (текст рядом с медиа)
        cap = " ".join(text.split())
        if cap:
            parts.append("caption:" + _md5(cap))

    elif kind in ("video", "gif", "voice", "audio", "doc", "roundv"):
        doc = getattr(_msg_media(msg), "document", None)
        did = getattr(doc, "id", 0) if doc is not None else 0
        if _safe_int(did):
            parts.append("%s:%d:%d" % (kind, _safe_int(did), _safe_int(getattr(doc, "size", 0))))
        # alt_documents: до 10 АЛЬТЕРНАТИВНЫХ версий того же файла (одно сообщение).
        # Порядок версий не важен -> сортируем.
        alts = []
        for a in _iter_java(getattr(_msg_media(msg), "alt_documents", None)):
            # `if aid` на java.lang.Integer бросает TypeError (нет bool) —
            # тогда alt_documents терялись целиком. Только _safe_int.
            aid = _safe_int(getattr(a, "id", 0))
            if aid:
                alts.append("%d:%d" % (aid, _safe_int(getattr(a, "size", 0))))
        for a in sorted(set(alts)):
            parts.append("alt:%s" % a)
        cap = " ".join(text.split())
        if cap:
            parts.append("caption:" + _md5(cap))

    elif kind == "sticker":
        doc = getattr(_msg_media(msg), "document", None)
        did = getattr(doc, "id", 0) if doc is not None else 0
        if _safe_int(did):
            parts.append("sticker:%d" % _safe_int(did))
        cap = " ".join(text.split())
        if cap:
            parts.append("caption:" + _md5(cap))

    elif kind == "stickerset":
        doc = getattr(_msg_media(msg), "document", None)
        did = getattr(doc, "id", 0) if doc is not None else 0
        if _safe_int(did):
            parts.append("stickerset:%d" % _safe_int(did))
        cap = " ".join(text.split())
        if cap:
            parts.append("caption:" + _md5(cap))

    elif kind == "roundv":
        doc = getattr(_msg_media(msg), "document", None)
        did = getattr(doc, "id", 0) if doc is not None else 0
        if _safe_int(did):
            parts.append("roundv:%d:%d" % (_safe_int(did), _safe_int(getattr(doc, "size", 0))))
        cap = " ".join(text.split())
        if cap:
            parts.append("caption:" + _md5(cap))

    elif kind == "premium":
        doc = getattr(_msg_media(msg), "document", None)
        did = getattr(doc, "id", 0) if doc is not None else 0
        if _safe_int(did):
            parts.append("premium:%d" % _safe_int(did))
        cap = " ".join(text.split())
        if cap:
            parts.append("caption:" + _md5(cap))

    elif kind in ("poll", "quiz"):
        poll = getattr(_msg_media(msg), "poll", None)
        if poll is not None:
            q = " ".join(_to_str(getattr(poll, "question", "")).split())
            # ОТВЕТЫ опроса (до 12) — все, порядок не важен -> сортируем.
            ans = sorted(_to_str(getattr(a, "text", ""))
                         for a in _iter_java(getattr(poll, "answers", None)))
            # у ответа может быть СВОЁ медиа (pollAnswer.media)
            amed = []
            for a in _iter_java(getattr(poll, "answers", None)):
                am = getattr(a, "media", None)
                sig = _media_sig(am)
                if sig:
                    amed.append(sig)
            parts.append("%s:%s" % (kind, _md5(q + "|" + "|".join(ans))))
            for x in sorted(set(a for a in amed if a != "None|None")):
                parts.append("ansmedia:" + _md5(x))
            # ПРИКРЕПЛЁННОЕ медиа к опросу (attached_media)
            att = getattr(_msg_media(msg), "attached_media", None)
            atts = _media_sig(att)
            if atts:
                parts.append("attmedia:" + atts)

    elif kind == "geo":
        _body = _sub_body(msg, _dup_key(msg))
        if _body:
            parts.append("geo:" + _body)

    elif kind == "venue":
        _body = _sub_body(msg, _dup_key(msg))
        if _body:
            parts.append("venue:" + _body)

    elif kind == "contact":
        _body = _sub_body(msg, _dup_key(msg))
        if _body:
            parts.append("contact:" + _body)

    elif kind == "webpage":
        _body = _sub_body(msg, _dup_key(msg))
        if _body:
            parts.append("webpage:" + _body)

    elif kind == "dice":
        _body = _sub_body(msg, _dup_key(msg))
        if _body:
            parts.append("dice:" + _body)

    elif kind == "game":
        _body = _sub_body(msg, _dup_key(msg))
        if _body:
            parts.append("game:" + _body)

    elif kind == "todo":
        # СПИСОК ЗАДАЧ: заголовок + все пункты (Vector<TodoItem>), порядок не важен.
        # ВАЖНО: собственный ключ (_dup_key) тут нестабилен, поэтому строим сами.
        todo = getattr(_msg_media(msg), "todo", None)
        ttl = " ".join(_to_str(getattr(todo, "title", "")).split())
        if ttl:
            parts.append("todotitle:" + _md5(ttl))
        items = []
        # Поле называется list ИЛИ items — как в _dup_key. Без фолбэка пункты
        # не читались бы, и разные задачи с одним заголовком склеились бы.
        # `if not _tl` на java.util.List — проверка истинности Java-объекта;
        # в части сборок бросает TypeError. Надёжнее смотреть размер через
        # _iter_java (она умеет и .size(), и питоновский список).
        _tl = getattr(todo, "list", None)
        if not _iter_java(_tl):
            _tl = getattr(todo, "items", None)
        for it in _iter_java(_tl):
            items.append(_to_str(getattr(it, "title", "")))
        for x in sorted(set(i for i in items if i)):
            parts.append("todoitem:" + _md5(x))

    elif kind in ("giveaway", "giveawayres"):
        # РОЗЫГРЫШ: каналы (Vector<long>), порядок не важен -> сортировка
        m = _msg_media(msg)
        dk = _dup_key(msg)
        if dk and "|" in dk:
            parts.append("%s:%s" % (kind, dk.split("|", 1)[1]))
        chans = []
        for c in _iter_java(getattr(m, "channels", None)):
            # int() на java.lang.Long бросает TypeError -> канал терялся бы
            # в комбо-ключе, и два РАЗНЫХ розыгрыша с разными каналами дали
            # бы одинаковый C|. _safe_int приводит java-обёртки безопасно.
            _c = _safe_int(c)
            if _c:
                chans.append(str(_c))
        for x in sorted(set(chans)):
            parts.append("gachan:" + x)
        winners = []
        for w in _iter_java(getattr(m, "winners", None)):
            _w = _safe_int(w)
            if _w:
                winners.append(str(_w))
        for x in sorted(set(winners)):
            parts.append("gawin:" + x)

    elif kind == "paidmedia":
        # ПЛАТНОЕ МЕДИА: массив вложений (Vector<MessageExtendedMedia>)
        m = _msg_media(msg)
        stars = getattr(m, "stars_amount", 0)
        items = []
        for em in _iter_java(getattr(m, "extended_media", None)):
            items.append(_media_sig(getattr(em, "media", None)))
        items = sorted(set(x for x in items if x))
        if items:
            parts.append("paid:%d:%d" % (_safe_int(stars), len(items)))
            for x in items:
                parts.append("paiditem:" + _md5(x))
        elif _safe_int(stars):
            parts.append("paid:%d" % _safe_int(stars))
        # ни вложений, ни звёзд -> часть не добавляем: иначе у всех пустых
        # платных медиа был бы ключ "paid:0" и они схлопнулись бы в дубль.

    elif kind in ("story", "invoice", "videostream"):
        dk = _dup_key(msg)
        if dk and "|" in dk:
            parts.append("%s:%s" % (kind, dk.split("|", 1)[1]))

    else:
        # обычный текст (возможно со ссылками)
        norm = _text_norm(text)
        if norm:
            parts.append("text:" + _md5(norm))

    # ПОДПИСЬ: если у сообщения есть текст, но ни одна часть его не учла
    # (спец-типы: гео, опрос, дайс, веб, игра...), добавляем его отдельной частью.
    if text.strip() and not any(p.startswith("caption:") or p.startswith("text:") for p in parts):
        parts.append("caption:" + _md5(_text_norm(text)))

    # ССЫЛКИ из текста/подписи добавляются ВСЕГДА, независимо от типа сообщения.
    # ССЫЛКИ СОРТИРУЮТСЯ: порядок появления не важен, важен сам набор ссылок.
    # Так «https://a/1 потом https://b/2» == «https://b/2 потом https://a/1».
    links = sorted(set(_extract_links(text)))
    for u in links:
        parts.append("link:" + u)

    # отбрасываем части ВЫКЛЮЧЕННЫХ режимов: комбо должно собираться только
    # из того, что пользователь разрешил. Иначе выключенный тип всё равно
    # попадёт в ключ и сообщение удалится через комбо.
    _pfx_mode = _PFX_MODE
    kept = []
    for p in parts:
        head = p.split(":", 1)[0]
        m = _pfx_mode.get(head)
        if m is not None and not _MODE.get(m, False):
            continue     # тип выключен -> часть не участвует
        kept.append(p)
    parts = kept

    # дедуп частей внутри одного сообщения
    seen = set()
    out = []
    for p in parts:
        if p not in seen:
            seen.add(p)
            out.append(p)
    return out


def _media_sig(m):
    """Стабильный отпечаток MessageMedia — БЕЗ repr (у Java-объектов в repr адрес).

    Берём реальные id: фото -> photo.id, документ -> document.id:size.
    Иначе подпись меняется от запуска к запуску и дедуп не работает.
    """
    if m is None:
        return ""
    ph = getattr(m, "photo", None)
    if ph is not None:
        pid = getattr(ph, "id", 0)
        if _safe_int(pid):
            return "p%d" % _safe_int(pid)
    doc = getattr(m, "document", None)
    if doc is not None:
        did = getattr(doc, "id", 0)
        if _safe_int(did):
            return "d%d:%d" % (_safe_int(did), _safe_int(getattr(doc, "size", 0)))
    return ""


def _album_id(msg):
    """grouped_id сообщения (альбом/медиагруппа), либо 0.

    В Telegram альбом — это НЕСКОЛЬКО сообщений с общим grouped_id
    (до 10 вложений: фото + видео + доки + аудио вперемешку).
    """
    try:
        ow = getattr(msg, "messageOwner", None)
        if ow is None:
            return 0
        # grouped_id — java.lang.Long: питоновский int() его не берёт,
        # и альбомы молча считались одиночными сообщениями.
        g = _safe_int(getattr(ow, "grouped_id", 0))
        return g if g else 0
    except Exception:
        return 0


def _text_norm(t):
    """Нормализация текста для комбо: схлопываем пробелы, регистр вниз.

    ПОРЯДОК СЛОВ НЕ МЕНЯЕМ. Дубль — это КОПИЯ сообщения, у неё текст
    совпадает посимвольно. Сортировка слов («он бил её» == «её бил он»)
    склеивала бы РАЗНЫЕ по смыслу записи и предлагала их удалить.

    Регистр вниз — единственное послабление: «Привет» и «привет» в
    Избранном почти всегда одно и то же.
    """
    return " ".join(_to_str(t).lower().split())


def _combo_key(msg):
    """Составной ключ всего сообщения. Пустая строка, если частей нет."""
    parts = _combo_parts(msg)
    if not parts:
        return ""
    return "C|" + "|".join(parts)


def _combo_kinds(msg):
    """Какие типы участвуют в этом сообщении (для фильтра по режимам)."""
    parts = _combo_parts(msg)
    got = set()
    for p in parts:
        if p.startswith("photo:"):
            got.add("photo")
        elif p.startswith("video:"):
            got.add("video")
        elif p.startswith("gif:"):
            got.add("gif")
        elif p.startswith("doc:"):
            got.add("doc")
        elif p.startswith("audio:"):
            got.add("audio")
        elif p.startswith("voice:"):
            got.add("voice")
        elif p.startswith("poll:"):
            got.add("poll")
        elif p.startswith("quiz:"):
            got.add("quiz")
        elif p.startswith("webpage:"):
            got.add("webpage")
        elif p.startswith("geo:"):
            got.add("geo")
        elif p.startswith("venue:"):
            got.add("venue")
        elif p.startswith("contact:"):
            got.add("contact")
        elif p.startswith("dice:"):
            got.add("dice")
        elif p.startswith("game:"):
            got.add("game")
        elif p.startswith("story:"):
            got.add("story")
        elif p.startswith("invoice:"):
            got.add("invoice")
        elif p.startswith("giveawayres:"):
            got.add("giveawayres")
        elif p.startswith("giveaway:"):
            got.add("giveaway")
        elif p.startswith("paidmedia:"):
            got.add("paidmedia")
        elif p.startswith("todo:"):
            got.add("todo")
        elif p.startswith("videostream:"):
            got.add("videostream")
        elif p.startswith("premium:"):
            got.add("premium")
        elif p.startswith("sticker:"):
            got.add("sticker")
        elif p.startswith("stickerset:"):
            got.add("stickerset")
        elif p.startswith("roundv:"):
            got.add("roundv")
        elif p.startswith("alt:"):
            got.add("doc")
        elif p.startswith("ansmedia:") or p.startswith("attmedia:"):
            got.add("poll")
        elif p.startswith("todoitem:") or p.startswith("todotitle:"):
            got.add("todo")
        elif p.startswith("gachan:") or p.startswith("gawin:"):
            got.add("giveaway")
        elif p.startswith("paiditem:") or p.startswith("paid:"):
            got.add("paidmedia")
        elif p.startswith("caption:") or p.startswith("text:"):
            got.add("text")
        elif p.startswith("link:"):
            got.add("link")
    return got


# URL внутри текста: http(s)://…, www.…, t.me/…, домен.зона/путь
_URL_RE = re.compile(
    r"(?:https?://|www\.)[^\s<>\"')\]]+"
    r"|(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}(?:/[^\s<>\"')\]]*)?",
    re.IGNORECASE,
)

# хвосты, которые не часть ссылки
_URL_TRIM = ".,;:!?)»\"'"

# Тело аудио-ключа ("A|<doc_id>|<size>" -> "1234|5678") и его старый вариант
# с двоеточием. Компилируем один раз: см. комментарий в _is_album_key.
_AUDIO_KEY_BODY_RE = re.compile(r"^\d+\|\d+$")
_AUDIO_KEY_BODY_COLON_RE = re.compile(r"^\d+:\d+$")



def _extract_links(text):
    """Список нормализованных ссылок из текста (может быть несколько)."""
    out = []
    try:
        for m in _URL_RE.findall(_to_str(text)):
            u = m.strip().rstrip(_URL_TRIM)
            if not u:
                continue
            n = _normalize_url(u)
            if n:
                out.append(n)
    except Exception as _exc1239:
        _swallow_log('_extract_links@1239', _exc1239)
        pass
    return out


def _normalize_url(url):
    """Приводит ссылку к канону, чтобы https://x.com/a и https://x.com/a?utm=1 совпали."""
    try:
        u = _to_str(url).strip().lower()
        u = u.rstrip(_URL_TRIM)
        # убираем схему
        for pfx in ("https://", "http://"):
            if u.startswith(pfx):
                u = u[len(pfx):]
        if u.startswith("www."):
            u = u[4:]
        # убираем utm-метки и трекинг
        if "?" in u:
            base, _, q = u.partition("?")
            keep = []
            for kv in q.split("&"):
                if not kv:
                    continue
                k = kv.split("=", 1)[0].lower()
                if k.startswith("utm_") or k in ("fbclid", "gclid", "igshid", "si", "ref"):
                    continue
                keep.append(kv)
            u = base + ("?" + "&".join(keep) if keep else "")
        # слэш на конце не значим
        u = u.rstrip("/")
        # отсекаем мусор короче домена
        if "." not in u:
            return ""
        return u
    except Exception:
        return ""


def _links_dominate(text):
    """True, если ссылки — ОСНОВНОЕ содержимое, а текста-обёртки мало.

    Тогда сообщение считаем «ссылочной заметкой» и даём L|-ключ, даже если
    вокруг ссылки есть пара слов. Порог: обёртка короче 40 символов и
    не длиннее самих ссылок более чем вдвое.
    """
    t = _to_str(text)
    urls = _extract_links(t)
    if not urls:
        return False
    url_len = sum(len(u) for u in urls)
    rest = _URL_RE.sub(" ", t)
    rest = rest.strip(" \t\r\n.,;:!?-—–()[]{}\"'«»")
    return len(rest) < 40 and len(rest) <= url_len * 2


def _is_pure_link(text, urls):
    """True, если сообщение состоит ТОЛЬКО из ссылки(ей)."""
    if not urls:
        return False
    # вырезаем из исходного текста всё, что похоже на ссылку, — регуляркой же
    rest = _URL_RE.sub(" ", _to_str(text))
    return not rest.strip(" \t\r\n.,;:!?-—–()[]{}\"'«»")


# Разрешения по типам: каждый режим чистит ТОЛЬКО своё.
# По умолчанию все четыре включены и работают независимо.
_MODE = {
    "link": True,     # дубли чистых ссылок
    "text": True,     # дубли текста
    "photo": True,    # дубли фото
    "video": True,    # дубли видео (+ кружки)
    "gif": True,      # дубли GIF
    "doc": True,      # дубли документов (pdf/zip/apk/…)
    "audio": True,    # дубли аудио (музыка)
    "voice": True,    # дубли голосовых
    "sticker": True,  # дубли стикеров
    "stickerset": True,  # дубли НАБОРОВ стикеров
    "premium": True,  # дубли премиум-стикеров/подарков
    "roundv": True,   # дубли кружков (video notes)
    "poll": True,     # дубли опросов
    "quiz": True,     # дубли опросов-викторин
    "webpage": True,  # дубли веб-ссылок/превью
    "geo": True,      # дубли геолокаций
    "venue": True,    # дубли мест
    "contact": True,  # дубли контактов
    "dice": True,     # дубли дайсов (кубики и т.п.)
    "game": True,     # дубли игр
    "story": True,    # дубли пересланных историй
    "invoice": True,  # дубли счетов/платежей
    "giveaway": True, # дубли розыгрышей
    "giveawayres": True, # дубли итогов розыгрышей
    "paidmedia": True,   # дубли платного медиа
    "todo": True,        # дубли списков задач
    "videostream": True, # дубли трансляций
    "combo": True,    # дубли СООБЩЕНИЙ ЦЕЛИКОМ (фото+подпись и т.п.)
    "album": True,
}


def _is_album_key(key):
    """Альбомный ключ? Отличается от аудио (тоже начинается с "A|").

    Аудио:  "A|<document_id>:<size>"          (2 поля, второе — число)
    Альбом: "A|<item-key>|<item-key>|..."     (item-ключи начинаются с буквы+«|»)

    Полагаться на ТИП значения в _seen нельзя: это мина — любое место, где
    проверка идёт по префиксу, перепутает аудио с альбомом. Проверяем явно.
    """
    if not isinstance(key, str) or not key.startswith("A|"):
        return False
    body = key[2:]
    if not body:
        return False
    # Аудио: "A|<document_id>|<size>"  -> "1234|5678" (РАЗДЕЛИТЕЛЬ — ПАЙП!)
    # Раньше здесь был шаблон ^\d+:\d+$ с ДВОЕТОЧИЕМ, а _dup_key выдаёт
    # именно пайп: A|1234|5678. Шаблон не совпадал НИКОГДА, поэтому каждый
    # аудио-ключ считался альбомным. При включённом режиме «аудио» (и
    # выключенных остальных) _all_keys выбрасывал такой ключ как альбомный —
    # аудио-дубли не находились вовсе (в самотесте: keys=[]).
    # Альбомный ключ — это "A|<item-key>|<item-key>|...", где item-key
    # начинается с БУКВЫ и содержит пайп (P|1, V|2|10). Поэтому аудио
    # распознаём по «одна пайп-пара из двух чисел без букв и без лишних |».
    # Шаблоны СКОМПИЛИРОВАНЫ НА УРОВНЕ МОДУЛЯ: re.match(pattern, s) с
    # строковым шаблоном идёт через кэш re._cache (LRU + блокировка) на
    # КАЖДЫЙ вызов, а _is_album_key зовётся на каждый ключ каждого сообщения.
    if _AUDIO_KEY_BODY_RE.match(body):
        return False
    # На случай старого формата с двоеточием (индекс прошлых версий).
    if _AUDIO_KEY_BODY_COLON_RE.match(body):
        return False
    return True


def _type_of_key(key):
    """Какому режиму принадлежит ключ типа. Порядок проверок важен (Z2..Z6 раньше Z)."""
    if not isinstance(key, str) or not key:
        return None
    # C| — составной ключ «сообщение целиком». Раньше его тут не было, и при
    # загрузке индекса комбо-дубли получали вид «?» в списке найденного.
    if key.startswith("C|"):
        return "combo"
    if key.startswith("L|"):
        return "link"
    if key.startswith("VQ|"):
        return "quiz"
    if key.startswith("Z2|"):
        return "giveaway"
    if key.startswith("Z3|"):
        return "giveawayres"
    if key.startswith("Z4|"):
        return "paidmedia"
    if key.startswith("Z5|"):
        return "todo"
    if key.startswith("Z6|"):
        return "videostream"
    if key.startswith("T|"):
        return "text"
    if key.startswith("P|"):
        return "photo"
    if key.startswith("V|"):
        return "video"
    if key.startswith("R|"):
        return "roundv"
    if key.startswith("G|"):
        return "gif"
    if key.startswith("N|"):
        return "stickerset"
    if key.startswith("D|"):
        return "doc"
    if key.startswith("A|") and not _is_album_key(key):
        return "audio"
    if _is_album_key(key):
        return "album"
    if key.startswith("O|"):
        return "voice"
    if key.startswith("S|"):
        return "sticker"
    if key.startswith("X|"):
        return "premium"
    if key.startswith("Q|"):
        return "poll"
    if key.startswith("W|"):
        return "webpage"
    if key.startswith("E|"):
        return "venue"
    if key.startswith("K|"):
        return "contact"
    if key.startswith("I|"):
        return "dice"
    if key.startswith("J|"):
        return "game"
    if key.startswith("Y|"):
        return "story"
    if key.startswith("B|"):
        return "invoice"
    if key.startswith("Z|"):
        return "geo"
    return None


def _all_keys(msg):
    """Ключи сообщения — только для ВКЛЮЧЁННЫХ типов.

    Десять независимых режимов (по умолчанию все вкл):
      link / text / photo / video / gif / doc / audio / voice / sticker / poll
      combo -> C|...  — сообщение ЦЕЛИКОМ (фото+подпись, видео+текст и т.п.)
    """
    text = _msg_text(msg)
    urls = _extract_links(text)
    keys = []

    # --- ссылки ---
    # Чистая ссылка (сообщение = только URL) -> ключ L| всегда.
    # Ссылка ВНУТРИ текста -> тоже даём L|-ключ, но только если URL — основное
    # содержимое (текста-«обёртки» мало). Иначе короткая фраза со ссылкой
    # считалась бы дублем любой другой фразы с той же ссылкой.
    if _MODE.get("link", False) and urls:
        if _is_pure_link(text, urls) or _links_dominate(text):
            for u in urls:
                keys.append("L|" + u)

    # --- ключ по конкретному типу ---
    tk = _dup_key(msg)
    if tk:
        mode = _type_of_key(tk)
        if mode and _MODE.get(mode, False):
            keys.append(tk)

    # --- комбо (сообщение целиком по составному ключу) ---
    if _MODE.get("combo", False):
        kinds = _combo_kinds(msg)
        if kinds and any(_MODE.get(t, False) for t in kinds):
            ck = _combo_key(msg)
            if ck:
                keys.append(ck)

    seen = set()
    out = []
    for kk in keys:
        if kk not in seen:
            seen.add(kk)
            out.append(kk)
    return out


def _preview_text(msg):
    kind = _kind_of(msg)
    if kind == "text":
        t = " ".join(_msg_text(msg).split())
        return t[:90] + ("…" if len(t) > 90 else "")
    base = _KIND_LABEL.get(kind, "медиа")
    cap = " ".join(_msg_text(msg).split())
    return ("%s — %s" % (base, cap[:60])) if cap else base


def _dup_preview(msg, key):
    """Превью для конкретного ключа: для ссылок показываем URL, для комбо — состав."""
    try:
        if key.startswith("L|"):
            return "ссылка: " + key[2:90]
        if key.startswith("C|"):
            parts = key[2:].split("|")
            labels = []
            for p in parts:
                if p.startswith("photo:"):
                    labels.append("фото")
                elif p.startswith("video:"):
                    labels.append("видео")
                elif p.startswith("gif:"):
                    labels.append("GIF")
                elif p.startswith("doc:"):
                    labels.append("файл")
                elif p.startswith("audio:"):
                    labels.append("аудио")
                elif p.startswith("voice:"):
                    labels.append("голос")
                elif p.startswith("stickerset:"):
                    labels.append("набор")
                elif p.startswith("roundv:"):
                    labels.append("кружок")
                elif p.startswith("premium:"):
                    labels.append("премиум")
                elif p.startswith("geo:"):
                    labels.append("гео")
                elif p.startswith("venue:"):
                    labels.append("место")
                elif p.startswith("contact:"):
                    labels.append("контакт")
                elif p.startswith("webpage:"):
                    labels.append("веб")
                elif p.startswith("dice:"):
                    labels.append("дайс")
                elif p.startswith("game:"):
                    labels.append("игра")
                elif p.startswith("story:"):
                    labels.append("история")
                elif p.startswith("invoice:"):
                    labels.append("счёт")
                elif p.startswith("giveawayres:"):
                    labels.append("итоги розыгрыша")
                elif p.startswith("giveaway:"):
                    labels.append("розыгрыш")
                elif p.startswith("paidmedia:"):
                    labels.append("платное медиа")
                elif p.startswith("todo:"):
                    labels.append("задачи")
                elif p.startswith("videostream:"):
                    labels.append("трансляция")
                elif p.startswith("caption:"):
                    labels.append("подпись")
                elif p.startswith("text:"):
                    labels.append("текст")
                elif p.startswith("link:"):
                    labels.append("ссылка")
                elif p.startswith("sticker:"):
                    labels.append("стикер")
                elif p.startswith("poll:"):
                    labels.append("опрос")
            base = "комбо: " + "+".join(labels) if labels else "комбо"
            txt = " ".join(_msg_text(msg).split())
            return (base + " — " + txt[:50]) if txt else base
    except Exception as _exc1546:
        _swallow_log('_dup_preview@1546', _exc1546)
        pass
    return _preview_text(msg)


class _Z2_HookParams(object):
    """Параметры хука отправки сообщения — только для самотеста.

    Реальный SDK передаёт сюда объект с полем message; самотесту нужен минимум,
    чтобы проверить сам перехват команды .dups и возвращаемый HookResult.
    """
    def __init__(self, text):
        self.message = text
        self.messageText = text


class ArashiMindFavorites(BasePlugin):

    # ================= ЛОГИРОВАНИЕ (сквозной трейс) =================
    # Зачем: 45 кругов аудита по коду не нашли ни UnboundLocalError в
    # замыкании, ни несуществующий get_application_context — их выдал только
    # живой лог. Поэтому логируется КАЖДЫЙ шаг, а не отдельные ветки.

    def _trace_on(self):
        """Включён ли подробный трейс (настройка mode_trace, по умолчанию да)."""
        try:
            return bool(self.get_setting("mode_trace", 1))
        except Exception:
            return bool(getattr(self, "_trace", True))

    def _trace_fmt(self, name, args, kwargs):
        """Компактное описание аргументов: короткие — как есть, длинные —
        тип и размер. Иначе строка лога на тексте в 4 КБ вытеснила бы лог."""
        parts = []
        try:
            for i, a in enumerate(args):
                if i >= 4:
                    parts.append("…")
                    break
                try:
                    if isinstance(a, (str, bytes)):
                        if len(a) <= 40:
                            parts.append("%r" % (a,))
                        else:
                            parts.append("<%s len=%d %r…>" % (type(a).__name__, len(a), a[:24]))
                    elif isinstance(a, (int, float, bool)) or a is None:
                        parts.append("%r" % (a,))
                    elif isinstance(a, (list, tuple, set, dict)):
                        parts.append("<%s n=%d>" % (type(a).__name__, len(a)))
                    else:
                        nm = type(a).__name__
                        if "List" in nm or "ArrayList" in nm:
                            try:
                                parts.append("<%s n=%s>" % (nm, a.size()))
                            except Exception:
                                parts.append("<%s>" % nm)
                        else:
                            parts.append("<%s>" % nm)
                except Exception:
                    parts.append("<%s>" % type(a).__name__)
            for k, v in list(kwargs.items())[:3]:
                try:
                    if isinstance(v, str) and len(v) > 40:
                        parts.append("%s=%r…" % (k, v[:24]))
                    else:
                        parts.append("%s=%r" % (k, v))
                except Exception:
                    parts.append("%s=?" % k)
        except Exception as _exc1603:
            self._swallow_ctx('_trace_fmt@1603', _exc1603)
            pass
        return " ".join(parts)

    def _trace_sync(self):
        """Проставить кэш-атрибут _trace из настройки.

        Обёртки читают ИМЕННО атрибут: вызов get_setting внутри wrapper
        замыкался на самого себя (get_setting тоже обёрнут) и вешал плагин.
        """
        try:
            self._trace = bool(self.get_setting("mode_trace", 1))
        except Exception:
            self._trace = True
        try:
            self._verbose = bool(self.get_setting("mode_trace_verbose", 0))
        except Exception as _exc1619:
            self._swallow_ctx('_trace_sync@1619', _exc1619)
            pass
        return self._trace

    def _install_trace(self):
        """Оборачивает все методы класса: вход, выход, время, исключение."""
        import functools
        skip = {
            "_log_line", "_persist_log", "_trace_fmt", "_trace_on",
            "_install_trace", "_load_log_from_disk", "_full_log_text",
            "_refresh_progress", "_refresh_selected_count",
            # КРИТИЧНО: get_setting/set_setting НЕ оборачивать. Обёртка на входе
            # спрашивает _trace_on(), а он читает настройку -> вызов уходил бы
            # в собственный wrapper -> бесконечная рекурсия и полный зависон.
            "get_setting", "set_setting", "get_setting_int", "set_setting_int",
            "_on_mode_trace", "_on_mode_trace_verbose",
        }
        # Прошивка «только один аргумент» рвёт ЛЮБУЮ функцию с другим
        # числом позиционных параметров: обёрнутая lambda(a, b) отдаёт
        # «TypeError: <lambda>() missing 1 required positional argument».
        # Это ломало обработчики кнопок у CallbackContext и хуки
        # (on_send_message_hook/_ctx_get/_copy_summary/_set_all принимают
        # два и больше). Поэтому такие методы НЕ оборачиваем вовсе.
        frozen = ()
        # Leftover-fix: диалоги живут между вызовами, а state между ними
        # сбрасывается/вообще ещё не создан. _copy_summary/_set_all читают
        # self._dups напрямую и падали AttributeError'ом, если отчёт открыт
        # из индекса, а _dups не выставлялся. Обнуляем в _finalize_scan.
        if not hasattr(self, "_dups"):
            self._dups = []
        if not hasattr(self, "_from_index_dups"):
            self._from_index_dups = 0
        if not hasattr(self, "_seen"):
            self._seen = {}
        if not hasattr(self, "_msg_ids"):
            self._msg_ids = set()
        if not hasattr(self, "_selected"):
            self._selected = {}
        if not hasattr(self, "_scanned"):
            self._scanned = 0
        if not hasattr(self, "_total"):
            self._total = 0
        if not hasattr(self, "_kind_seen"):
            self._kind_seen = {}
        if not hasattr(self, "_dup_ids"):
            self._dup_ids = set()
        if not hasattr(self, "_index_keys"):
            self._index_keys = set()
        if not hasattr(self, "_index"):
            self._index = None
        if not hasattr(self, "_log"):
            self._log = []
        skip = skip | set(frozen)
        marks = {"_scan_page", "_process", "_do_delete", "_confirm",
                 "_finalize_scan", "_apply_albums", "_review_stage",
                 "_build_review", "_show_progress", "_start_scan_body",
                 "_on_menu_click_inner", "on_menu_click", "on_send_message_hook",
                 "_on_show_log", "_drop_ids_from_index", "_save_index",
                 "_load_index", "_fail", "_cancel", "_dedupe_dups"}

        def make(orig, nm):
            @functools.wraps(orig)
            def wrapper(self, *a, **kw):
                # Берём закэшированный флаг-атрибут, а НЕ get_setting: вызов
                # настроек из обёртки давал рекурсию. _trace_sync() заполняет
                # его при загрузке и при переключении в UI.
                on = getattr(self, "_trace", True)
                if not on:
                    return orig(self, *a, **kw)
                lead = "→" if nm in marks else "·"
                try:
                    self._log_line("[trace] %s %s(%s)" % (lead, nm, self._trace_fmt(nm, a, kw)))
                except Exception:
                    pass
                t0 = time.time()
                try:
                    out = orig(self, *a, **kw)
                except Exception as e:
                    try:
                        self._log_line("[trace] x %s: %s: %s" % (nm, type(e).__name__, e))
                    except Exception:
                        pass
                    try:
                        self.logger.exception("[SC] trace %s failed", nm)
                    except Exception:
                        pass
                    raise
                try:
                    dt = (time.time() - t0) * 1000.0
                    if dt >= 5 or nm in marks:
                        self._log_line("[trace] %s %s -> ok (%.0f ms)" % (lead, nm, dt))
                except Exception:
                    pass
                return out
            return wrapper

        # Повторная установка обернула бы каждый метод ВТОРОЙ раз: каждая
        # строка лога шла бы дважды («→ _load_index()» два раза подряд),
        # а сам трейс кушал бы вдвое больше времени. Поэтому один раз.
        if getattr(self, "_trace_installed", False):
            try:
                self._log_line("[trace] перехват уже установлен, повтор пропущен")
            except Exception as _exc1734:
                self._swallow_ctx('_install_trace@1734', _exc1734)
                pass
            return
        self._trace_installed = True

        wrapped = 0
        refused = 0
        for name in dir(type(self)):
            if name.startswith("__") or name in skip:
                continue
            fn = getattr(type(self), name, None)
            if not callable(fn):
                continue
            # Уже обёрнут (functools.wraps кладёт исходник в __wrapped__):
            # не оборачивать второй раз, иначе КАЖДАЯ строка трейса уйдёт
            # дублем. Страховка помимо флага _trace_installed: если хост
            # перезагрузит плагин и флаг потеряется, двойного лога не будет.
            if getattr(fn, "__wrapped__", None) is not None:
                continue
            try:
                co = getattr(fn, "__code__", None)
                if co is None or co.co_varnames[:1] != ("self",):
                    continue
            except Exception as _exc1757:
                self._swallow_ctx('_install_trace@1757', _exc1757)
                continue
            try:
                setattr(type(self), name, make(fn, name))
                wrapped += 1
            except Exception as _exc1762:
                self._swallow_ctx('_install_trace@1762', _exc1762)
                pass
        self._trace_refused = refused
        try:
            # Раньше здесь писалось «пропущено N многоаргументных»: обёртка
            # угадывала число аргументов и 48 методов выпадали из лога. Теперь
            # обёртка универсальна (*a, **kw), и пропуск возможен ТОЛЬКО для
            # служебных методов самого логгера — их видно по refused.
            if refused:
                self._log_line("[trace] перехват: %d методов (служебных пропущено %d)"
                               % (wrapped, refused))
            else:
                self._log_line("[trace] перехват: %d методов (все)" % wrapped)
        except Exception as _exc1768:
            self._swallow_ctx('_install_trace@1768', _exc1768)
            pass

    def _uninstall_trace(self):
        """Снять перехват: вернуть на класс ИСХОДНЫЕ функции.

        Выключенный трейс обязан СНЯТЬ обёртки, а не просто перестать писать.
        Иначе 110 обёрнутых методов остаются в графе вызовов после выключения:
        каждый вызов всё равно проходит через wrapper (лишний кадр + проверка
        флага), а после повторного включения setattr оборачивал бы уже
        ФАБРИЧНУЮ обёртку — двойной лог. functools.wraps кладёт исходную
        функцию в __wrapped__, по ней и восстанавливаем.
        """
        if not getattr(self, "_trace_installed", False):
            try:
                self._log_line("[trace] снятие пропущено: перехват не установлен")
            except Exception as _exc1784:
                self._swallow_ctx('_uninstall_trace@1784', _exc1784)
                pass
            return
        restored = 0
        for name in dir(type(self)):
            if name.startswith("__"):
                continue
            try:
                fn = getattr(type(self), name, None)
                orig = getattr(fn, "__wrapped__", None)
                if callable(orig):
                    setattr(type(self), name, orig)
                    restored += 1
            except Exception as _exc1797:
                self._swallow_ctx('_uninstall_trace@1797', _exc1797)
                continue
        self._trace_installed = False
        try:
            self._log_line("[trace] перехват снят: вернул %d методов" % restored)
        except Exception as _exc1802:
            self._swallow_ctx('_uninstall_trace@1802', _exc1802)
            pass

    # ---------------- lifecycle ----------------

    def on_plugin_load(self):
        # _account нужен НЕ ТОЛЬКО скану: его требует MessageObject(account, ...)
        # в _process, лог и любой разбор сообщений. Раньше он появлялся лишь
        # при старте скана, и всё, что работало до него (самотест, отладка),
        # валилось с AttributeError, а _process молча терял целую пачку
        # («прочитано 0»). Ставим сразу и держим.
        try:
            self._account = self._current_account()
        except Exception:
            self._account = 0
        # Модульные помощники (_swallow_log) не имеют self — им нужен канал
        # в лог. Отдаём им _log_line плагина один раз при загрузке.
        try:
            _SWALLOW_SINK[0] = self._log_line
        except Exception as _exc1821:
            self._swallow_ctx('on_plugin_load@1821', _exc1821)
            pass
        # переносим файлы старого имени, если остались от прежних версий
        try:
            self._migrate_old_files()
        except Exception as _exc1826:
            self._swallow_ctx('on_plugin_load@1826', _exc1826)
            pass

        # Плагин-хост может вызвать загрузку повторно (перезагрузка плагина).
        # Без этой защиты: меню добавлялось ДВАЖДЫ, хук регистрировался дважды,
        # а трейсер оборачивал методы второй раз — в логе каждая строка шла
        # дублем, а пунктов меню становилось два.
        if getattr(self, "_loaded_once", False):
            try:
                self._log_line("[start] повторная загрузка — перехват уже стоит")
            except Exception as _exc1836:
                self._swallow_ctx('on_plugin_load@1836', _exc1836)
                pass
            return
        self._loaded_once = True

        # _cancelled читается голым атрибутом в _process/_scan_page, а колбэк
        # ответа может прилететь раньше первого _start_scan. Без инициализации
        # это AttributeError ровно в момент ответа Telegram.
        self._cancelled = False
        self.is_processing = False
        self._progress = None
        self._review = None
        self._cooldown_until = 0
        self._deleting = False
        self._log = []
        self._log_dropped = 0
        self._last_error = None
        # различает НАШЕ закрытие окна прогресса и тап юзера снаружи
        self._dismiss_is_programmatic = False

        # 1) пункт в меню чата (⋮) — БЕЗ condition: MVEL-выражение с UserConfig
        #    в некоторых сборках молча не парсится, и пункт не появляется вовсе.
        #    Проверку «это Избранное?» делаем внутри обработчика.
        self._menu_ids = []
        try:
            self._menu_ids.append(self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text="Найти дубликаты",
                    icon="msg_list",
                    subtext="В этом чате или в Избранном",
                    priority=10,
                    on_click=self.on_menu_click,
                )
            ))
        except Exception:
            self.logger.exception("chat menu item failed")

        # 2) дублирующий пункт в главном меню приложения — если чатовое не рендерится
        try:
            self._menu_ids.append(self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.MAIN_MENU,
                    text="Найти дубликаты",
                    icon="msg_list",
                    subtext="Дубли в Избранном",
                    priority=5,
                    on_click=self.on_menu_click,
                )
            ))
        except Exception:
            self.logger.exception("main menu item failed")

        self.logger.info("%s loaded, menu ids=%s" % (__name__, self._menu_ids))

        # 3) путь через команду в поле ввода — не зависит от меню и фрагмента
        try:
            self.add_on_send_message_hook(priority=10)
            self.logger.info("send-message hook registered, command = .dups")
        except Exception:
            self.logger.exception("send hook failed")

        # 4) сквозной трейс: вход/выход/время/ошибка для КАЖДОГО метода.
        # Ставим последним, иначе обернулись бы и регистрация меню, и хук.
        # _trace_sync кладёт настройку в кэш-атрибут _trace: wrapper читает
        # именно атрибут, потому что вызов get_setting из обёртки замыкался
        # сам на себя и вешал плагин насмерть (проверено на живом прогоне).
        try:
            self._trace_sync()
            self._install_trace()
        except Exception as e:
            try:
                self.logger.exception("install trace failed: %s", e)
            except Exception as _exc1909:
                self._swallow_ctx('on_plugin_load@1909', _exc1909)
                pass

    def on_plugin_unload(self):
        # Останавливаем идущий скан: иначе он продолжает дёргать Telegram и
        # тратить батарею уже после выгрузки плагина (а логирование может
        # упасть на выгруженном объекте).
        try:
            self._cancelled = True
            self.is_processing = False
        except Exception as _exc1919:
            self._swallow_ctx('on_plugin_unload@1919', _exc1919)
            pass
        for mid in getattr(self, "_menu_ids", []):
            try:
                self.remove_menu_item(mid)
            except Exception as _exc1924:
                self._swallow_ctx('on_plugin_unload@1924', _exc1924)
                pass
        self._menu_ids = []
        self._progress = None
        self._review = None

    # ---------------- settings screen (запуск из карточки плагина) ----------------

    def create_settings(self):
        """Пункты в карточке плагина: тут кнопка работает всегда, в отличие от меню чата."""
        try:
            from ui.settings import Header, Text, Divider, Switch

            items = []
            items.append(Header(text=__name__))
            items.append(Text(
                text="Найти дубликаты",
                icon="msg_list",
                subtext="Оригинал (самое старое) не трогается",
                on_click=self._on_settings_run,
                link_alias="find_dups",
            ))
            items.append(Text(
                text="Открыть Избранное",
                icon="msg_arrow_forward",
                subtext="Откроет чат «Избранное» — там видно, что осталось",
                on_click=self._on_open_saved,
                link_alias="open_saved",
            ))
            items.append(Text(
                text="Показать лог (последний запуск)",
                icon="msg_info",
                subtext="Подробно: аккаунт, peer, страницы, ошибки",
                on_click=self._on_show_log,
                link_alias="log",
            ))
            items.append(Text(
                text="Скопировать лог в буфер",
                icon="msg_edit",
                subtext="Вставить в чат или заметку",
                on_click=self._on_copy_log,
                link_alias="copy_log",
            ))
            items.append(Text(
                text="Очистить лог",
                icon="msg_list",
                subtext="Сбросить записи лога",
                on_click=self._on_clear_log,
                link_alias="clear_log",
            ))
            items.append(Divider(text="— ОСНОВНОЕ —"))
            items.append(Switch(
                key="mode_link",
                text="Ссылки",
                default=True,
                subtext="Дубли чистых ссылок (текст+ссылка не трогается)",
                icon="msg_arrow_forward",
                on_change=self._on_mode_link,
                link_alias="mode_link",
            ))
            items.append(Switch(
                key="mode_text",
                text="Текст",
                default=True,
                subtext="Дубли текстовых сообщений",
                icon="msg_list",
                on_change=self._on_mode_text,
                link_alias="mode_text",
            ))
            items.append(Switch(
                key="mode_photo",
                text="Фото",
                default=True,
                subtext="Дубли одинаковых фото (по server id)",
                icon="msg_list",
                on_change=self._on_mode_photo,
                link_alias="mode_photo",
            ))
            items.append(Switch(
                key="mode_video",
                text="Видео",
                default=True,
                subtext="Дубли одинаковых видео/GIF (по server id + размер)",
                icon="msg_list",
                on_change=self._on_mode_video,
                link_alias="mode_video",
            ))
            items.append(Divider(text="— КОМБО (СООБЩЕНИЕ ЦЕЛИКОМ) —"))
            items.append(Switch(
                key="mode_combo",
                text="Комбинации (сообщение целиком)",
                default=True,
                subtext="Ловит одинаковые сообщения с несколькими частями: фото+подпись, видео+текст и т.п.",
                icon="msg_settings",
                on_change=self._on_mode_combo,
                link_alias="mode_combo",
            ))
            items.append(Switch(
                key="mode_album",
                text="Альбом (до 10 вложений)",
                default=True,
                subtext="Повтор медиагруппы целиком: набор фото/видео/доков с общим grouped_id. Порядок не важен.",
                icon="msg_list",
                on_change=self._on_mode_album,
                link_alias="mode_album",
            ))
            items.append(Divider(text="— МЕДИА И ФАЙЛЫ —"))
            items.append(Switch(
                key="mode_gif",
