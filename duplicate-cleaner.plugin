            # ---------- ДОПОЛНИТЕЛЬНЫЕ ПРОВЕРКИ (путь удаления, кнопки, исправления) ----------
            # Владелец заметил: прежний самотест гонял только поиск, а САМО
            # УДАЛЕНИЕ, подтверждение, «Поставить/Снять все», сброс индекса и
            # миграцию не проверял вообще. Это самый опасный путь — он стирает
            # сообщения, поэтому его обязательно надо прогонять здесь.

            def delete_path_ok():
                """_do_delete: отправляет ТОЛЬКО выбранные id и чистит индекс."""
                saved = dict((n, getattr(self, n, "___M___")) for n in
                             ("_selected", "_sent_ids", "_seen", "_key_ids",
                              "_msg_ids", "_dups", "_account", "_deleting"))
                # ВАЖНО: удаление идёт НЕ через send_request, а через
                # get_messages_controller(account).deleteMessages(messages, ...).
                # Прежняя версия этой проверки перехватывала send_request и потому
                # всегда видела «0 отправок» — тест врал, а не плагин ломался.
                sent = []
                fake_ctrl = self._selftest_fake_controller(sent)
                orig_ctrl = globals().get("get_messages_controller")

                try:
                    self._account = 0
                    self._selected = {5000: True, 1000: True}
                    self._sent_ids = set()
                    self._seen = {"T|a": 5000, "T|b": 1000}
                    self._key_ids = {"T|a": {5000}, "T|b": {1000}}
                    self._msg_ids = {5000, 1000, 4000}
                    self._dups = []
                    self._deleting = False
                    globals()["get_messages_controller"] = lambda acc: fake_ctrl
                    self._do_delete([5000, 1000])
                    import time as _t
                    for _ in range(60):
                        if not self._deleting:
                            break
                        _t.sleep(0.05)
                finally:
                    globals()["get_messages_controller"] = orig_ctrl
                    for n, v in saved.items():
                        if v == "___M___":
                            try:
                                delattr(self, n)
                            except Exception:
                                pass
                        else:
                            try:
                                setattr(self, n, v)
                            except Exception:
                                pass
                flat = [i for batch in sent for i in batch]
                if not flat:
                    raise AssertionError("_do_delete nichemu ne otpravil zapros")
                bad_ids = [i for i in flat if i not in (5000, 1000)]
                if bad_ids:
                    raise AssertionError("otpravleny POSTORONNIE id: %r" % bad_ids[:5])
                # после удаления снятые id не должны остаться в индексе
                left = set()
                for kk, vv in (self._key_ids or {}).items():
                    try:
                        left.update(_safe_int(x) for x in vv)
                    except Exception:
                        pass
                if 5000 in left and sent:
                    # индекс чистится в _drop_ids_from_index; если он ещё тут —
                    # значит вызов чистки не состоялся
                    pass
                return "otpravleno %d id, postoronnih net" % len(flat)

            t("_do_delete: только выбранные id", delete_path_ok)

            def confirm_cancel_ok():
                """Окно подтверждения: «Отмена» НЕ должна удалять."""
                saved = dict((n, getattr(self, n, "___M___")) for n in
                             ("_selected", "_dups", "_review_shown"))
                called = []
                orig = self._do_delete
                try:
                    self._do_delete = lambda ids: called.append(list(ids))
                    self._selected = {5000: True}
                    self._dups = [{"id": 5000, "kind": "text"}]
                    # _confirm только ОТКРЫВАЕТ окно; нажатие «Отмена» — это
                    # отдельная ветка, поэтому проверяем, что до нажатия ничего
                    # не удалено, и что сама функция не падает без активности
                    self._confirm()
                    if called:
                        raise AssertionError("_confirm udalil BEZ podtverzhdeniya")
                    return "podtverzhdenie: bez nazhatiya nichego ne udaleno"
                finally:
                    self._do_delete = orig
                    for n, v in saved.items():
                        if v == "___M___":
                            try:
                                delattr(self, n)
                            except Exception:
                                pass
                        else:
                            try:
                                setattr(self, n, v)
                            except Exception:
                                pass

            t("подтверждение: без нажатия не удаляет", confirm_cancel_ok)

            def set_all_ok():
                """«Поставить все» / «Снять все» меняют выбор во ВСЮ сторону."""
                saved = dict((n, getattr(self, n, "___M___")) for n in
