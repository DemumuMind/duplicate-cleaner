            def reset_index_ok():
                """«Сбросить кэш скана» обязана убить индекс и на диске, и в памяти."""
                import os as _os, tempfile as _tf
                tmp = _os.path.join(_tf.mkdtemp(), "reset.json")
                saved = dict((n, getattr(self, n, "___M___")) for n in
                             ("_seen", "_key_ids", "_msg_ids", "_index", "_quick",
                              "_scan_complete", "_index_keys"))
                try:
                    self._index_path = lambda: tmp
                    self._seen = {"T|x": 1}
                    self._key_ids = {"T|x": {1}}
                    self._msg_ids = {1}
                    self._quick = True
                    self._scan_complete = True
                    with open(tmp, "w", encoding="utf-8") as f:
                        f.write("{}")
                    self._on_reset_index(None)
                    if _os.path.exists(tmp):
                        raise AssertionError("fayl indeksa NE udalen")
                    if len(self._seen or {}) != 0:
                        raise AssertionError("_seen NE ochishchen: %d"
                                             % len(self._seen))
                    if self._quick:
                        raise AssertionError("_quick NE snyat (budet bystryy skan)")
                    return "sbros kэsha: fayl i pamyat ochishcheny"
                finally:
                    try:
                        del self._index_path
                    except Exception:
                        pass
                    for n, v in saved.items():
                        if v == "___M___":
                            try:
                                delattr(self, n)
                            except Exception:
                                pass
                        else:
                            try:
                                setattr(self, n, v)
                            except Exception:
                                pass

            t("«Сбросить кэш скана» чистит и файл, и память", reset_index_ok)

            def migrate_ok():
                """Перенос файлов старого имени не должен терять данные."""
                import os as _os, tempfile as _tf
                d = _tf.mkdtemp()
                saved = self._data_path
                old = _os.path.join(d, "arashimind_index.json")
                with open(old, "w", encoding="utf-8") as f:
                    f.write('{"v":4}')
                try:
                    self._data_path = lambda n: _os.path.join(d, n)
                    self._migrate_old_files()
                    new = _os.path.join(d, "index.json")
                    if not _os.path.exists(new):
                        raise AssertionError("staryy fayl NE perenesen")
                    if _os.path.exists(old):
                        raise AssertionError("staryy fayl ostalsya (poteryat dubl)")
                    return "migratsiya: staryy -> novyy"
                finally:
                    self._data_path = saved

            t("перенос старого индекса", migrate_ok)

            def probe_and_progress_ok():
