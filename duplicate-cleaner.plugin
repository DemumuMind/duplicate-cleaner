    def on_send_message_hook(self, account, params):
        """Команды: .dups — найти дубликаты, .dupshelp — справка."""
        result = HookResult()
        try:
            # Текст может быть Java-CharSequence, а не str: `isinstance(x, str)`
            # в этом случае ЛОЖЬ, и команда не срабатывала бы вовсе.
            # Приводим через _to_str (он умеет toString()).
            raw = None
            for nm in ("message", "text", "messageText"):
                raw = getattr(params, nm, None)
                if raw is not None:
                    break
            text = _to_str(raw)
            if not text:
                return result
            cmd = " ".join(text.strip().lower().split())

            if cmd in (".dups", ".дубли", ".d", ".dupsclean"):
                result.strategy = HookStrategy.CANCEL
                # буллет и запуск — обязательно в UI-потоке
                run_on_ui_thread(lambda: BulletinHelper.show_info("Ищу дубликаты…"))
                acc = _safe_int(account)
                self._start_scan(acc, _safe_int(get_user_config(acc).getClientUserId()))
                return result

            if cmd in (".dupshelp", ".дубли_справка", ".dhelp", ".dupshelp"):
                result.strategy = HookStrategy.CANCEL
                run_on_ui_thread(lambda: BulletinHelper.show_info(
                    __name__ + ":\n"
                    ".dups — найти дубликаты в чате / Избранном\n"
                    "Затем отметь галочками и нажми «Удалить»."
                ))
                return result
        except Exception:
            self.logger.exception("send hook failed")
        return result

    # ---------------- entry ----------------

    def on_menu_click(self, context):
        try:
            self._on_menu_click_inner(context or {})
        except Exception as e:
            import traceback
            self._last_error = "%s: %s\n%s" % (type(e).__name__, e, traceback.format_exc().splitlines()[-3:])
            self.is_processing = False
            self.logger.exception("menu click failed")
            run_on_ui_thread(lambda: BulletinHelper.show_error("Ошибка: %s" % e))

    def _ctx_get(self, context, key, default=None):
        """Безопасно читает ключ из Java-HashMap контекста.

        ВАЖНО: HashMap.get принимает РОВНО один аргумент. Вызов
        context.get(key, default) через шим даёт
        'java.util.HashMap.get takes 1 argument (2 given)'.
        """
        try:
            val = context.get(key)   # один аргумент!
        except Exception:
            try:
                val = context[key]
            except Exception:
                return default
        return default if val is None else val

    def _on_menu_click_inner(self, context):
        # контекст может быть из меню чата (есть dialog_id) или из главного меню (нет)
        self._log_line("[ui] menu clicked")
        acc = self._ctx_get(context, "account", 0)
        account = _safe_int(acc) if acc else self._current_account()
        # Клиентский id может не прочитаться (недоступен UserConfig) — тогда
        # падал бы весь обработчик и пользователь видел только «Ошибка».
        try:
            my_id = _safe_int(get_user_config(account).getClientUserId())
        except Exception:
            my_id = 0
        if not my_id:
            self._log_line("[ui] menu: my_id не прочитан")
            run_on_ui_thread(lambda: BulletinHelper.show_error(
                "Не удалось определить ваш аккаунт. Открой Избранное и повтори."
            ))
            return

        dialog_id = self._ctx_get(context, "dialog_id", None)
        if dialog_id is not None:
            # dialog_id == 0 означает «из главного меню» — там чата нет,
            # и раньше это ложно считалось «не Избранное»: пункт отказывался
            # работать. Проверяем только реальный чужой чат.
            try:
                did = _safe_int(dialog_id)
            except Exception:
                did = 0
            # Плагин работает ТОЛЬКО с Избранным. В чужом диалоге честно
            # отказываем: удаление там бьёт по живому чату, а не по свалке
            # Избранного, и это не то, для чего плагин сделан.
            if did not in (0, my_id):
                run_on_ui_thread(lambda: BulletinHelper.show_error(
                    "Этот пункт работает только в Избранном. "
                    "Открой Избранное и повтори."
                ))
                return

        # запуск также открывает Избранное, чтобы результат был на виду
        self._start_scan(account, my_id)

    # ---------- индекс скана (быстрый повторный прогон) ----------

    def _migrate_old_files(self):
        """Одноразовый перенос файлов старого имени в новое.

        Индекс раньше назывался <старое_имя>_index.json. После перехода на
        имя из __id__ файл «переехал», и без переноса у пользователя молча
        терялся накопленный кэш (следующий скан — полный).
        """
        import os
        # Старые имена файлов, оставшиеся от прежних версий этого плагина.
        # Переносим их один раз, чтобы накопленный кэш не пропал при
        # переименовании. Для чистой установки список просто не находит файлов.
        legacy = {
            "index.json": ("arashimind_index.json",),
            "log.txt": ("arashimind_log.txt",),
        }
        for new_name, olds in legacy.items():
            new = self._data_path(new_name)
            # старый файл ищем В ТОЙ ЖЕ ПАПКЕ, что и новый: раньше путь был
            # жёстко "~", из-за чего перенос ломался, стоило каталогу данных
            # отличаться (и тест не мог это проверить).
            new_dir = os.path.dirname(new) or os.path.expanduser("~")
            try:
                if os.path.exists(new):
                    continue
                for old_n in olds:
                    src = os.path.join(new_dir, old_n)
                    if not os.path.exists(src):
                        src = os.path.join(os.path.expanduser("~"), old_n)
                    if os.path.exists(src):
                        try:
                            os.replace(src, new)
                        except Exception:
                            import shutil
                            shutil.copyfile(src, new)
                        break
            except Exception as _exc4263:
                self._swallow_ctx('_migrate_old_files@4263', _exc4263)
                pass

    def _data_path(self, name):
        """Путь к рабочему файлу плагина.

        Имя строится из __id__, а не из названия проекта: любой человек,
        переименовавший плагин под себя, получает собственные файлы и не
        перетирает чужие. Живёт в ~, как и раньше.
        """
        import os
        base = str(__id__ or "plugin").replace("/", "_")
        return os.path.join(os.path.expanduser("~"), base + "_" + name)

    def _index_path(self):
        import os
        return self._data_path("index.json")

    def _mode_signature(self):
        """Отпечаток включённых режимов: при их смене индекс несовместим."""
        try:
            flags = "".join("1" if _MODE.get(k) else "0" for k in sorted(_MODE))
            extra = "%d%d" % (1 if self._keep_oldest else 0,
                              1 if self._skip_short else 0)
            return _md5(flags + "|" + extra)
        except Exception:
            return ""

    def _load_index(self):
        """Прошлый индекс: top_id, key->id, подпись режимов."""
        try:
            import json
            path = self._index_path()
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
            if data.get("sig") != self._mode_signature():
                self._log_line("[index] режимы изменились — индекс сброшен")
                return None
            if not data.get("top_id"):
                return None
            # ФОРМАТ ИНДЕКСА. v1 хранил на ключ ОДИН id: второй экземпляр
            # вытеснялся и терялся навсегда, поэтому быстрый скан по такому
            # индексу физически не мог найти дубли среди старых сообщений —
            # он их «не видел». v2 хранит все id списком. Старый индекс
            # принудительно считаем неполным: лучше один полный проход, чем
            # молчаливое «дубликаты не найдены».
            if not data.get("complete", False):
                self._log_line("[index] индекс неполный (старый прогон прервался) — "
                               "полный скан")
                return None
            # Дополнительная страховка: если top_id подозрительно свежий, а
            # orig_total много меньше реального числа сообщений, индекс врал
            # про полноту (так писали старые сборки). Сравнить не с чем, но
            # пустой keys или top_id == максимуму при малом orig — признак.
            if not (data.get("keys") or {}):
                self._log_line("[index] индекс без ключей — полный скан")
                return None
            if int(data.get("v") or 1) < _INDEX_VERSION:
                self._log_line("[index] формат v%s < v%d — полный скан "
                               "(в старом индексе один id на ключ, старые дубли "
                               "в нём потеряны)" % (data.get("v") or 1, _INDEX_VERSION))
                return None
            age_h = (time.time() - float(data.get("ts") or 0)) / 3600.0
            # Старый индекс опасен: он хранит только «самый свежий id» на ключ.
            # Если между сканами Избранное чистили СНАРУЖИ (сам Telegram, рукой),
            # быстрый проход начнёт с top_id и НЕ увидит старые дубли, а отчёт
            # скажет «всё чисто». Поэтому слишком старый индекс не используем —
            # лучше полный проход, чем молча неверный результат.
            if age_h > _INDEX_MAX_AGE_H:
                self._log_line("[index] устарел (%.1fh > %dh) — полный проход"
                               % (age_h, _INDEX_MAX_AGE_H))
                return None
            # Чистим сами ключи: одна битая запись (null/строка вместо id)
            # не должна стоить всего индекса — иначе теряются и все
            # остальные, вполне годные ключи, и скан снова идёт целиком.
            raw = data.get("keys")
            clean = {}
            # Набор всех id индекса собираем ТУТ ЖЕ, за один проход: раньше
            # после этой петли шёл ВТОРОЙ обход clean с isinstance на каждое
            # значение только ради этого множества. На индексе в 3000 ключей
            # это ~570 тыс. вызовов isinstance на 50 загрузок (замерено
            # профайлером) — чистые потери, ведь в clean уже лежат int/list.
            ids = set()
            if isinstance(raw, dict):
                for k, v in raw.items():
                    if not isinstance(k, str) or not k:
                        continue
                    if isinstance(v, list):
                        vals = []
                        for x in v:
                            try:
                                vals.append(int(x))
                            except Exception as _exc4349:
                                self._swallow_ctx('_load_index@4349', _exc4349)
                                pass
                        if vals:
                            sv = sorted(set(vals))
                            clean[k] = sv
                            ids.update(sv)
                    else:
                        try:
                            iv = int(v)
                            clean[k] = iv
                            ids.add(iv)
                        except Exception as _exc4356:
                            self._swallow_ctx('_load_index@4356', _exc4356)
                            pass
            else:
                return None
            dropped = (len(raw) - len(clean)) if isinstance(raw, dict) else 0
            data["keys"] = clean
            self._log_line("[index] loaded: top_id=%s keys=%d orig=%s age=%.1fh%s"
                           % (data.get("top_id"), len(clean),
                              data.get("orig_total"), age_h,
                              (" (битых записей: %d)" % dropped) if dropped else ""))
            data["_age_h"] = age_h
            # Запоминаем id, лежавшие в индексе: _save_index в быстром скане
            # складывает их с прочитанными сейчас, чтобы orig_total не
            # схлопывался с 6672 до 1-2 на каждом повторном прогоне.
            data["_ids"] = ids
            return data
        except Exception:
            return None

    def _save_index(self, top_id, complete=None):
        """Сохраняем top_id + key->id. Перезаписываем атомарно."""
        try:
            import json, os
            path = self._index_path()
            tmp = path + ".tmp"
            # Ключи бывают двух видов: id (число) и СПИСОК id (альбом).
            # Раньше списки молча терялись -> режим «Альбом» в быстром скане
            # не находил дубли. Кодируем оба вида.
            # На ключ пишем СПИСОК ВСЕХ известных id, а не один.
            # Раньше хранился только самый свежий id: второй экземпляр
            # («Я» добавлено дважды) вытеснялся из индекса навсегда, и быстрый
            # скан его уже не находил — он проверяет только новые сообщения
            # (min_id = top_id). Это и выглядело как «дубли не находит, а в кэш
            # закидывает». Один id остаётся числом (компактно), несколько —
            # списком.
            keys = {}
            allids = getattr(self, "_key_ids", None) or {}
            for k, v in self._seen.items():
                try:
                    ids = [int(x) for x in (allids.get(k) or ()) if x]
                    if not ids:
                        if isinstance(v, int) and v:
                            ids = [v]
                        elif isinstance(v, (list, tuple)) and v:
                            ids = [int(x) for x in v if x]
                    if not ids:
                        continue
                    ids = sorted(set(ids))
                    keys[k] = ids[0] if len(ids) == 1 else ids
                except Exception as _exc4411:
                    self._swallow_ctx('_save_index@4411', _exc4411)
                    pass
            # orig_total — число СООБЩЕНИЙ в Избранном, а не ключей: у одного
            # сообщения бывает 2-3 ключа (текст + ссылка + комбо), и
            # «оригиналов 14186» при 6632 записях вводило в заблуждение.
            #
            # КРИТИЧНО про быстрый скан: он читает 1-2 НОВЫХ сообщения, и
            # писать orig_total = len(_msg_ids) значит схлопывать счётчик с
            # 6672 до 1 на каждом повторном прогоне (в логе было orig=2).
            # Поэтому: в быстром скане берём прежнее число из загруженного
            # индекса и прибавляем только реально новые id.
            _mine = set(getattr(self, "_msg_ids", ()) or ())
            # Берём id прямо из ЗАГРУЖЕННОГО индекса: _start_scan_body читает
            # self._index РАНЬШЕ, чем тот заполняется (он ставится ниже в том
            # же методе), поэтому сохранённая копия всегда была пустой.
            _prev = set((getattr(self, "_index", None) or {}).get("_ids") or ())
            if not _prev:
                _prev = set(getattr(self, "_prev_index_ids", ()) or ())
            if getattr(self, "_quick", False) and _prev:
                _total_msg = len(_prev | _mine)
            else:
                _total_msg = len(_mine) or len(self._seen)
            # complete: скан прошёл ВЕСЬ диалог. Неполный индекс нельзя
            # использовать для быстрого прогона — он выглядит как «всё
            # проверено», хотя прочитана часть.
            #
            # Флаг НЕЛЬЗЯ ставить безусловно: этот же _save_index вызывается
            # после удаления (в _do_delete), а там полного скана не было.
            # Именно так неполный прогон помечался полным (в логе: индекс
            # загружался без предупреждений и быстрый скан читал 0 сообщений).
            if complete is None:
                complete = bool(getattr(self, "_scan_complete", False))
            data = {
                "v": _INDEX_VERSION,
                "complete": bool(complete),
                "top_id": int(top_id or 0),
                "orig_total": int(_total_msg),
                "ts": int(time.time()),
                "sig": self._mode_signature(),
                "keys": keys,
            }
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(data, f, separators=(",", ":"))
            os.replace(tmp, path)
            self._log_line("[index] saved: top_id=%s keys=%d"
                           % (data["top_id"], len(data["keys"])))
            return True
        except Exception as e:
            self._log_line("[index] save failed: %s: %s" % (type(e).__name__, e))
            return False

    def _drop_ids_from_index(self, removed_ids):
        """Убрать из индекса только те ключи, чьи id удалены.

        Раньше после удаления индекс сбрасывался ЦЕЛИКОМ, и следующий прогон
        снова читал всё Избранное (минуты). Теперь индекс живёт, а из него
        вычищаются лишь записи об удалённых сообщениях.
        """
        try:
            import json
            path = self._index_path()
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
            rid = set(int(x) for x in removed_ids)
            keys = data.get("keys") or {}
            keep = {}
            dropped = 0
            for k, v in keys.items():
                if isinstance(v, list):
                    nv = [x for x in v if x not in rid]
                    if nv:
                        keep[k] = nv
                    else:
                        dropped += 1
                else:
                    try:
                        if int(v) in rid:
                            dropped += 1
                            continue
                    except Exception as _exc4490:
                        self._swallow_ctx('_drop_ids_from_index@4490', _exc4490)
                        pass
                    keep[k] = v
            data["keys"] = keep
            tmp = path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(data, f, separators=(",", ":"))
            import os
            os.replace(tmp, path)
            self._log_line("[index] после удаления вычищено ключей: %d (осталось %d)"
                           % (dropped, len(keep)))
        except Exception as e:
            self._log_line("[index] drop_ids failed: %s: %s" % (type(e).__name__, e))

    def _clear_index(self):
        """Полный сброс кэша: И файл на диске, И состояние в памяти.

        Раньше здесь удалялся только файл. Но скан читает индекс ещё и из
        памяти (self._seen/_key_ids/_msg_ids), а флаг self._quick оставался
        True — поэтому после «Сбросить кэш скана» в ТОМ ЖЕ сеансе следующий
        поиск снова шёл быстрым и опять рапортовал «дубликатов нет».
        Это ровно та жалоба владельца: «я сбросил кеш, а он пишет что
        дубликатов нету». Файл сбрасывался, память — нет.
        """
        try:
            import os
            p = self._index_path()
            if os.path.exists(p):
                os.remove(p)
        except Exception as _exc4511:
            self._swallow_ctx('_clear_index@4511', _exc4511)
            pass
        # --- память ---
        for name in ("_seen", "_key_ids", "_msg_ids", "_dups", "_dup_ids",
                     "_index_keys", "_selected", "_from_index_dups",
                     "_index_dup_seen", "_sent_ids", "_kind_seen", "_scanned",
                     "_total", "_first_id", "_last_msg_id", "_last_new_id",
                     "_dup_key_seen", "_page_no", "_same_offset", "_prev_offset"):
            try:
                val = getattr(self, name, None)
                if isinstance(val, dict):
                    val.clear()
                elif isinstance(val, (set, list)):
                    val.clear()
                else:
                    setattr(self, name, 0)
            except Exception as _exc4512:
                self._swallow_ctx('_clear_index@4512 ' + name, _exc4512)
        try:
            self._index = None
            self._quick = False           # следующий прогон обязан быть полным
            self._scan_complete = False
            self._log_line("[index] cleared (файл + память, быстрый скан выключен)")
        except Exception as _exc4513:
            self._swallow_ctx('_clear_index@4513', _exc4513)

    def _start_scan(self, account, my_id):
        """Единая точка запуска — и из меню чата, и из карточки плагина."""
        # Лог НЕ стираем здесь: если скан уже идёт, inner-функция выйдет с
        # «Поиск уже идёт», и лог предыдущего прогона был бы уничтожен зря —
        # а его как раз и показывают для разбора. Чистим только когда скан
        # действительно стартует (см. _start_scan_body).
        self._last_error = None
        try:
            self._start_scan_inner(account, my_id)
        except Exception as e:
            import traceback
            tb = traceback.format_exc()
            self._last_error = "%s: %s\n%s" % (type(e).__name__, e, tb.splitlines()[-3:])
            self._log_line("[ERROR] start_scan: %s: %s" % (type(e).__name__, e))
            self._log_line(tb.splitlines()[-1])
            self.is_processing = False
            self.logger.exception("start_scan failed")
            try:
                run_on_ui_thread(lambda: BulletinHelper.show_error("Ошибка запуска: %s" % e))
            except Exception as _exc4533:
                self._swallow_ctx('_start_scan@4533', _exc4533)
                pass

    def _start_scan_inner(self, account, my_id):
        # Диагностика: без неё отказ запуска выглядел как «нажал — ничего не
        # произошло». В логе теперь видно ТОЧНУЮ причину каждого отказа.
        self._log_line("[start-try] is_processing=%s deleting=%s cancelled=%s "
                       "cooldown=%.1fs progress=%s review=%s"
                       % (getattr(self, "is_processing", None),
                          getattr(self, "_deleting", None),
                          getattr(self, "_cancelled", None),
                          max(0.0, getattr(self, "_cooldown_until", 0) - time.time()),
                          "есть" if getattr(self, "_progress", None) else "нет",
                          "есть" if getattr(self, "_review", None) else "нет"))

        if getattr(self, "_deleting", False):
            self._log_line("[start-no] отказ: идёт удаление")
            run_on_ui_thread(lambda: BulletinHelper.show_info(
                "Сейчас идёт удаление — дождитесь конца."))
            return

        if self.is_processing:
            # РАНЬШЕ ЗДЕСЬ БЫЛ ТУПИК: если флаг залипал (скан отменили,
            # окно прогресса закрыли не нашим кодом), КАЖДЫЙ следующий запуск
            # получал «Поиск уже идёт» до перезапуска клиента. Теперь флаг
            # сверяется с реальностью: диалога прогресса нет -> скан мёртв.
            if getattr(self, "_progress", None) is None:
                self._log_line("[start-fix] is_processing завис без окна — сброшен")
                self.is_processing = False
            else:
                self._log_line("[start-no] отказ: скан действительно идёт")
                run_on_ui_thread(lambda: BulletinHelper.show_info(
                    "Поиск дубликатов уже идёт."))
                return

        # после удаления серверу нужно мгновение применить его, иначе скан покажет те же id
        left = getattr(self, "_cooldown_until", 0) - time.time()
        if left > 0:
            self._log_line("[start-no] отказ: cooldown %.1f c" % left)
            run_on_ui_thread(lambda: BulletinHelper.show_info(
                "Секунду — Telegram применяет удаление. Повторите через %.0f с." % left
            ))
            return

        # остатки прошлого прогона не должны мешать новому
        self._cancelled = False
        self._retrying = False
        self._dismiss_is_programmatic = False
        try:
            if getattr(self, "_progress", None) is not None:
                self._log_line("[start-fix] закрываю забытое окно прогресса")
                self._dismiss_progress()
        except Exception as _exc4585:
            self._swallow_ctx('_start_scan_inner@4585', _exc4585)
            pass

        self._account = account
        self._my_id = my_id
        self.is_processing = True
        # Тело — в отдельном методе. Если оно бросит исключение (недоступный
        # get_setting, ошибка диалога прогресса), is_processing обязан
        # сброситься: иначе КАЖДЫЙ следующий запуск отвечал бы «Поиск уже идёт»
        # до перезапуска клиента — плагин стал бы одноразовым.
        try:
            self._start_scan_body()
        except Exception as e:
            self.is_processing = False
            self._log_line("[ERROR] scan start: %s: %s" % (type(e).__name__, e))
            try:
                self.logger.exception("scan start failed")
            except Exception as _exc4602:
                self._swallow_ctx('_start_scan_inner@4602', _exc4602)
                pass
            run_on_ui_thread(lambda: BulletinHelper.show_error(
                "Не удалось начать поиск: %s" % e))

    def _start_scan_body(self):
        # сюда доходим только если скан реально стартовал — тут лог и чистим.
        # Причину предыдущего отказа сохраняем строкой: иначе после успешного
        # старта пропадало объяснение, почему прошлый раз «ничего не нажалось».
        _keep = ""
        for _l in reversed(getattr(self, "_log", ()) or ()):
            if "[start-no]" in _l or "[start-fix]" in _l:
                _keep = _l
                break
        self._log = []
        if _keep:
            self._log.append(_keep)
        self._log_line("[start] account=%s my_id=%s"
                       % (getattr(self, "_account", 0), getattr(self, "_my_id", 0)))
        self._seen = {}       # key -> id первого (оригинала)
        self._dups = []       # список dict(id, kind, text)
        self._dup_ids = set() # id уже добавленных (одно сообщение — один раз)
        # число дублей = len(self._dups); отдельный счётчик не нужен
        self._kind_seen = {}  # kind -> сколько раз встретился (диагностика)
        self._selected = {}   # id -> bool
        self._checkboxes = []
        self._scanned = 0
        # Уникальные ID сообщений. len(self._seen) — это КЛЮЧИ, а у одного
        # сообщения их бывает 2-3 (текст+ссылка+комбо), поэтому «оригиналов»
        # показывалось вдвое больше правды (14186 против 6632 сообщений).
        self._msg_ids = set()
        self._key_hits = {}   # key -> сколько раз встретился за прогон
        self._key_ids = {}    # key -> set(id): ВСЕ экземпляры, для индекса
        self._from_index_dups = 0   # сколько дублей взято из индекса (не перечитано)
        self._index_dup_seen = set()  # id, уже посчитанные как «из индекса» (уник.)
        # Дошёл ли скан до конца диалога. По этому признаку разрешена запись
        # индекса: неполный прогон не должен помечать диалог «проверенным».
        self._scan_complete = False
        # старые альбомы сбрасываем ЗДЕСЬ же (буфера _album_feed больше нет —
        # данные живут в _album_groups/_album_ids ниже)
        self._album_groups = {}   # grouped_id -> set(item-ключей элементов)
        self._album_ids = {}      # grouped_id -> [id элементов] для удаления
        self._last_msg_id = 0
        self._first_id = 0
        self._page_no = 0
        # Флаги ПРОШЛОГО скана: без сброса счётчик флуд-ожиданий накапливался
        # между запусками, и второй скан падал на «>5 ожиданий», хотя ни одного
        # флуда в этот раз не было. _retrying, оставшийся True, ломал нумерацию
        # страниц в логе. _index_keys относится только к текущему прогону.
        self._flood_waits = 0
        self._retrying = False
        self._same_offset = 0
        self._prev_offset = -1
        # _last_new_id пишет ТОЛЬКО контрольный запрос (_probe_newest) в этом
        # прогоне. Без сброса значение оставалось от ПРОШЛОГО скана: если в
        # этом прогоне проба не сработала, вердикт сравнивал свежий top_id со
        # СТАРЫМ _last_new_id — и «нового нет» получалось из мусора прошлого
        # раза, а не из факта. Сбрасываем: 0 = «не читали», см. вердикт.
        self._last_new_id = 0

        # --- быстрый режим: подтягиваем прошлый индекс ---
        quick = bool(self.get_setting("quick_scan", 1))
        # При «оставлять СТАРОЕ» индекс (хранит самый свежий id) даёт
        # обратную логику — быстрый скан молча наврал бы. Отключаем его.
        if bool(self.get_setting("keep_oldest", 0)):
            if quick:
                self._log_line("[quick] выключен: режим «оставлять старое»")
            quick = False
        self._quick = quick
        self._index = self._load_index() if quick else None
        # Индекс без ключей бесполезен и ОПАСЕН: скан пойдёт от top_id, а
        # сравнивать новые сообщения будет не с чем -> дубли слева от top_id
        # не найдутся, а отчёт скажет «всё чисто». Пустой индекс = полный скан.
        if self._index is not None and not (self._index.get("keys") or {}):
            self._log_line("[index] пустой — полный скан")
            self._index = None
        # в быстром режиме грузим прошлые ключи -> новые сообщения сверяем с ними
        # реальное число загруженных ключей ставится ниже (len(self._index_keys))
        self._index_keys = set()
        if self._index:
            for k, v in (self._index.get("keys") or {}).items():
                try:
                    if isinstance(v, list) and v:
                        ids = [int(x) for x in v if x]
                        if _is_album_key(k):
                            # альбомный ключ: список id = состав альбома.
                            # Проверка ИМЕННО _is_album_key, а не k.startswith("A|"):
                            # префикс "A|" общий у аудио ("A|<doc_id>|<size>") и у
                            # альбома ("A|<P|1>|<V|2|10>"). По одному префиксу аудио
                            # с несколькими id в индексе получило бы здесь список
                            # как «состав альбома» — и _apply_albums удалил бы
                            # аудиозаписи как альбом.
                            self._seen[k] = ids
                        elif len(ids) == 1:
                            self._seen[k] = ids[0]
                        else:
                            # ОБЫЧНЫЙ ключ со несколькими экземплярами: значит в
                            # Избранном лежат дубли, про которые индекс знает.
                            # Оставляем СВЕЖАЙШИЙ (максимум), остальные —
                            # дубли. Раньше это делалось БЕЗУСЛОВНО и без
                            # пометки: в списке появлялись записи, которых в
                            # Избранном уже нет (их удалили в обход плагина),
                            # а следующий прогон предлагал удалить их снова.
                            # Поэтому помечаем источник — в интерфейсе такие
                            # строки отличаются от найденных сейчас.
                            ids = sorted(set(ids))
                            self._seen[k] = ids[-1]
                            for _old in ids[:-1]:
                                if _old not in self._dup_ids:
                                    self._dup_ids.add(_old)
                                    self._dups.append({
                                        "id": _old,
                                        "kind": (_type_of_key(k) or "?"),
                                        "from_index": True,
                                        "text": "из индекса (не перечитано сейчас: %s)" % k[:24],
                                    })
                            # Счётчик ведём по УНИКАЛЬНЫМ id, а не «+1 на ключ»:
                            # у одного сообщения бывает 2-3 ключа (T| и C| и L|),
                            # и один и тот же дубль считался столько раз, сколько
                            # ключей он дал (в логе: «из индекса=2» при одном
                            # удаляемом сообщении).
                            if not hasattr(self, "_index_dup_seen"):
                                self._index_dup_seen = set()
                            for _old2 in ids[:-1]:
                                if _old2 not in self._index_dup_seen:
                                    self._index_dup_seen.add(_old2)
                                    self._from_index_dups = getattr(self, "_from_index_dups", 0) + 1
                    else:
                        self._seen[k] = int(v)
                    # в _index_keys попадает ТОЛЬКО реально загруженный ключ.
                    # Раньше туда писались все ключи файла, включая битые:
                    # обработка дубля считала бы такой ключ «из индекса»,
                    # хотя в _seen его нет.
                    self._index_keys.add(k)
                except Exception as _exc4724:
                    self._swallow_ctx('_start_scan_body@4724', _exc4724)
                    pass
            self._scan_from = int(self._index.get("top_id") or 0)
            self._from_index = len(self._index_keys)
            self._log_line("[quick] продолжим с min_id=%s, прошлых ключей=%d"
                           % (self._scan_from, len(self._seen)))
        else:
            self._from_index = 0
            self._scan_from = 0
            if quick:
                self._log_line("[quick] индекса нет — полный скан")
        self._total = 0
        self._total_logged = False
        self._cancelled = False
        # разбор КАЖДОГО сообщения и каждого решения по ключу.
        # На 6000+ сообщениях это тысячи строк, поэтому отдельный флаг.
        try:
            self._verbose = bool(self.get_setting("mode_trace_verbose", 0))
        except Exception:
            self._verbose = bool(getattr(self, "_verbose", False))
        if self._verbose:
            self._log_line("[trace] детальный разбор каждого сообщения включён")
        self._keep_oldest = bool(self.get_setting("keep_oldest", 0))
        self._skip_short = bool(self.get_setting("skip_short_text", 0))
        # Четыре независимых типа. По умолчанию — все включены.
        _MODE["link"] = bool(self.get_setting("mode_link", 1))
        _MODE["text"] = bool(self.get_setting("mode_text", 1))
        _MODE["photo"] = bool(self.get_setting("mode_photo", 1))
        _MODE["video"] = bool(self.get_setting("mode_video", 1))
        _MODE["combo"] = bool(self.get_setting("mode_combo", 1))
        _MODE["gif"] = bool(self.get_setting("mode_gif", 1))
        _MODE["doc"] = bool(self.get_setting("mode_doc", 1))
        _MODE["audio"] = bool(self.get_setting("mode_audio", 1))
        _MODE["voice"] = bool(self.get_setting("mode_voice", 1))
        _MODE["sticker"] = bool(self.get_setting("mode_sticker", 1))
        _MODE["stickerset"] = bool(self.get_setting("mode_stickerset", 1))
        _MODE["roundv"] = bool(self.get_setting("mode_roundv", 1))
        _MODE["poll"] = bool(self.get_setting("mode_poll", 1))
        _MODE["quiz"] = bool(self.get_setting("mode_quiz", 1))
        _MODE["webpage"] = bool(self.get_setting("mode_webpage", 1))
        _MODE["geo"] = bool(self.get_setting("mode_geo", 1))
        _MODE["venue"] = bool(self.get_setting("mode_venue", 1))
        _MODE["contact"] = bool(self.get_setting("mode_contact", 1))
        _MODE["dice"] = bool(self.get_setting("mode_dice", 1))
        _MODE["game"] = bool(self.get_setting("mode_game", 1))
        _MODE["story"] = bool(self.get_setting("mode_story", 1))
        _MODE["invoice"] = bool(self.get_setting("mode_invoice", 1))
        _MODE["giveaway"] = bool(self.get_setting("mode_giveaway", 1))
        _MODE["giveawayres"] = bool(self.get_setting("mode_giveawayres", 1))
        _MODE["paidmedia"] = bool(self.get_setting("mode_paidmedia", 1))
        _MODE["todo"] = bool(self.get_setting("mode_todo", 1))
        _MODE["videostream"] = bool(self.get_setting("mode_videostream", 1))
        _MODE["premium"] = bool(self.get_setting("mode_premium", 1))
        _MODE["album"] = bool(self.get_setting("mode_album", 1))
        self._log_line("[mode] " + " ".join("%s=%s" % (k, v) for k, v in sorted(_MODE.items())))
        self._summary = ""
        self._deleted = False
        # _empty_confirm глушит буллет с итогом при закрытии окна дублей.
        # Он ставился в True, когда «Удалить» нажали с нулём отмеченных, и
        # НЕ сбрасывался: после такого раза итог не показывался до перезапуска
        # клиента. Сбрасываем его на каждом новом скане.
        self._empty_confirm = False

        self._show_progress()
        run_on_queue(lambda: self._scan_page(), PLUGINS_QUEUE)

    # ---------------- scan ----------------

    def _self_input_peer(self, account):
        """InputPeer для Избранного (чат с самим собой).

        Приоритет — TL_inputPeerSelf: он однозначно означает «я сам» и не требует
        резолва User. Фолбэк — MessagesController.getInputPeer(User).
        """
        try:
            return TLRPC.TL_inputPeerSelf()
        except Exception as _exc4800:
            self._swallow_ctx('_self_input_peer@4800', _exc4800)
            pass
        try:
            mc = get_messages_controller(account)
            user = mc.getUser(self._my_id)
            if user is not None:
                return mc.getInputPeer(user)
        except Exception:
            self.logger.exception("getInputPeer failed")
        return None

    def _probe_newest(self, field):
        """Контрольный запрос: одно самое новое сообщение БЕЗ min_id."""
        try:
            peer = self._self_input_peer(self._account)
            if peer is None:
                return False
            req = TLRPC.TL_messages_getHistory()
            req.peer = peer
            req.limit = 1
            req.offset_id = 0
            req.add_offset = 0
            req.min_id = 0
            req.max_id = 0
            req.hash = 0

            def _cb(response, error):
                if error is not None or response is None:
                    return
                try:
                    msgs = getattr(response, "messages", None)
                    if self._java_size(msgs) <= 0:
                        return
                    mid = _msg_id(msgs.get(0))
                    if mid:
                        setattr(self, field, mid)
                        self._log_line("[probe] samoe svezhee v dialoge id=%d "
                                       "(top_id=%d)" % (mid, _safe_int(self._scan_from)))
                except Exception as _exc4838:
                    _swallow_log('_cb@4838', _exc4838)
                    pass

            send_request(req, _cb, account=self._account)
            return True
        except Exception as e:
            self._log_line("[probe] ne udalos: %s: %s" % (type(e).__name__, e))
            return False

    @staticmethod
    def _selftest_fake_controller(sink):
        """Подставной MessagesController только для самотеста.

        Нужен потому, что удаление вызывается не через send_request, а через
        controller.deleteMessages(...): без перехвата на этом уровне проверка
        пути удаления ничего не проверяет. Класс намеренно НЕ прощает ошибок:
        если плагин передаст не тот тип или не тот dialogId — тест увидит.
        """
        class _FakeMessagesController(object):
            def __init__(self, out):
                self._out = out
                self.calls = []

            def deleteMessages(self, messages, randoms, enc, dialog_id,
                               topic_id, for_all, mode):
                ids = []
                try:
                    n = messages.size()
                    for i in range(n):
                        ids.append(int(str(messages.get(i))))
                except Exception:
                    pass
                self._out.append(ids)
                self.calls.append({
                    "ids": ids, "dialog_id": _safe_int(dialog_id),
                    "for_all": bool(for_all), "topic": _safe_int(topic_id),
                    "enc": type(enc).__name__ if enc is not None else None,
                })
                return None

            def getInputPeer(self, arg):
                return TLRPC.TL_inputPeerSelf()
        return _FakeMessagesController(sink)

    def _quick_zero_verdict(self):
        """Разбор «быстрый скан прочитал 0».

        Возвращает:
          "none"    — новых сообщений действительно нет (id самой свежей вещи
                      не новее прошлого top_id);
          "missed"  — сообщения ЕСТЬ, но их не увидели (вернулся баг MM или
                      запрос не сработал). Молчать в этом случае нельзя:
                      пользователь решит, что дублей нет, хотя скан не читал.
        Опирается на _last_new_id — id, полученный КОНТРОЛЬНЫМ запросом.
        """
        try:
            top = _safe_int(getattr(self, "_scan_from", 0))
            newest = _safe_int(getattr(self, "_last_new_id", 0))
        except Exception:
            return "missed"
        # НЕОПРЕДЕЛЁННОСТЬ ТРАКТУЕМ КАК ПОТЕРЮ. Контрольный запрос мог не
        # вернуть id вовсе (сбой send_request/peer, пустой ответ, пробу не
        # успели записать) — тогда newest == 0. Раньше это молча падало в
        # "none", то есть «дубликатов нет», хотя мы НЕ ЗНАЕМ, есть ли новые:
        # пользователь добавил дубль, прогон отвечал «нет» — ровно тот баг,
        # который вердикт и должен ловить. Fail-safe: если newest не прочитан
        # ИЛИ он новее top_id — это "missed" (нужен полный скан), а не "none".
        if not newest:
            self._log_line("[quick] контрольный запрос не дал id — "
                           "итог не подтверждён, это НЕ «дублей нет»")
            return "missed"
        if newest > top:
            self._log_line("[quick] !!! есть сообщения новее top_id=%d (id=%d) — "
                           "скан их не прочитал, это потеря" % (top, newest))
            return "missed"
        return "none"

    def _scan_page(self):
        if getattr(self, "_cancelled", False):
            return
        try:
            peer = self._self_input_peer(self._account)
            if peer is None:
                self._log_line("[scan] peer = None")
                self._fail("Не удалось получить peer Избранного")
                return
            # шум в логе: пишем раз в 10 пачек, не каждую.
            # При повторе после FLOOD_WAIT страница та же — счётчик не растёт.
            if getattr(self, "_retrying", False):
                self._retrying = False
            else:
                self._page_no = getattr(self, "_page_no", 0) + 1
            # Периодически сбрасываем лог на диск: скан большого Избранного
            # длится минуты, и без этого при падении посреди него лог (а с ним
            # и место сбоя) терялся бы целиком.
            if self._page_no % 20 == 0:
                try:
                    self._persist_log()
                except Exception as _exc4890:
                    self._swallow_ctx('_scan_page@4890', _exc4890)
                    pass
            # (лог печатается НИЖЕ, после сборки запроса: раньше он показывал
            # _last_msg_id, а в запрос уходило другое значение — по логу было
            # не понять, что реально спрашивают у сервера)
            req = TLRPC.TL_messages_getHistory()
            req.peer = peer
            req.limit = PAGE_SIZE
            # ВАЖНО (баг MM). До этого всегда стояло offset_id=self._last_msg_id
            # и add_offset=0. При быстром скане _last_msg_id=0, и Telegram резал
            # список с САМОГО НАЧАЛА (самые новые), а min_id — это ФИЛЬТР ПОСЛЕ
            # нарезки: он выкидывал всю пачку, и сервер отдавал 0 сообщений.
            # Поэтому «второй поиск» читал 0 и навсегда рапортовал «дублей нет».
            #
            # Дока (core.telegram.org/api/offsets): «20 messages NEWER than MSGID»
            # — это offset_id=MSGID, add_offset=-limit. Используем ровно это,
            # когда есть от чего продолжать.
            _from = int(getattr(self, "_scan_from", 0) or 0)
            if _from and not self._last_msg_id:
                # первая страница быстрого скана: тянем пачку НОВЕЕ прошлого скана
                req.offset_id = _from
                req.add_offset = -PAGE_SIZE
                req.min_id = _from      # страховка: ничего старше не берём
            else:
                req.offset_id = self._last_msg_id
                req.add_offset = 0
                req.min_id = _from
            req.max_id = 0
            req.hash = 0
            if self._page_no == 1 or self._page_no % 10 == 0:
                # Печатаем РЕАЛЬНЫЕ поля запроса: offset_id/add_offset/min_id.
                # Раньше здесь был _last_msg_id, и в логе всегда стояло
                # «offset_id=0» даже когда запрос шёл с offset_id=top_id —
                # именно это сбивало разбор бага MM.
                self._log_line("[scan] page #%d peer=%s offset_id=%s add_offset=%s "
                               "min_id=%s limit=%s first_id=%s"
                               % (self._page_no, type(peer).__name__,
                                  _safe_int(req.offset_id), _safe_int(req.add_offset),
                                  _safe_int(req.min_id), _safe_int(req.limit),
                                  _safe_int(getattr(self, "_first_id", 0))))
        except Exception as e:
            self.logger.exception("getHistory build failed")
            self._log_line("[ERROR] build getHistory: %s: %s" % (type(e).__name__, e))
            self._fail("Не удалось построить запрос: %s" % e)
            return

        def on_response(response, error):
            # Считаем РАЗМЕР пачки до обработки, а счётчики печатаем ПОСЛЕ:
            # раньше строка выводилась до _process и показывала scanned за
            # предыдущую пачку — в логе это выглядело как «100 msgs, scanned=0»
            # и сбивало с толку при разборе.
            if error is None and response is not None:
                n_msgs = self._java_size(getattr(response, "messages", None))
            else:
                n_msgs = 0
                self._log_line("[resp] error=%s" % error)
            try:
                _before_scanned = getattr(self, "_scanned", 0)
                _before_uniq = len(getattr(self, "_seen", ()))
                self._process(response, error)
                if error is None and response is not None:
                    self._log_line("[resp] %d msgs | scanned=%d(+%d) uniq=%d(+%d) dups=%d | offset=%s"
                                   % (n_msgs, getattr(self, "_scanned", 0),
                                      getattr(self, "_scanned", 0) - _before_scanned,
                                      len(getattr(self, "_seen", ())),
                                      len(getattr(self, "_seen", ())) - _before_uniq,
                                      len(getattr(self, "_dups", ())),
                                      getattr(self, "_last_msg_id", 0)))
            except Exception as e:
                self.logger.exception("scan page failed")
                self._log_line("[ERROR] process: %s: %s" % (type(e).__name__, e))
                self._fail("Ошибка при разборе ответа: %s" % e)

        try:
            rid = send_request(req, on_response, account=self._account)
        except Exception as e:
            self.logger.exception("send_request failed")
            self._log_line("[ERROR] send_request: %s: %s" % (type(e).__name__, e))
            self._fail("Не удалось отправить запрос: %s" % e)

    def _java_size(self, coll):
        """Размер Java-коллекции: len() на ArrayList падает -> .size()."""
        if coll is None:
            return 0
        # Строка — не коллекция: len(строки) дал бы длину текста и сломал бы
        # логику пагинации (n = длина строки вместо числа сообщений).
        if isinstance(coll, (str, bytes, bytearray)):
            return 0
        try:
            n = _safe_int(coll.size())
            # Битый объект/упаковка может отдать мусорное число: range(10**9)
            # съел бы память и уронил бы скан. Тот же потолок, что в _iter_java.
            if n < 0:
                return 0
            return n if n <= 100000 else 100000
        except Exception:
            try:
                n = _safe_int(len(coll))
                return n if 0 <= n <= 100000 else 0
            except Exception:
                return 0

    def _process(self, response, error):
        if getattr(self, "_cancelled", False):
            return
        if error is not None:
            etxt = "%s" % (getattr(error, "text", "") or "")
            self._log_line("[resp] error=%s" % etxt)
            # Флуд-контроль — НЕ повод падать: сервер сам говорит, сколько ждать.
            # Скан большого Избранного (десятки страниц подряд) как раз его и
            # вызывает, поэтому ждём и продолжаем с той же страницы.
            m = _FLOOD_RE.search(etxt)
            if m:
                wait = min(int(m.group(1)) + 1, 120)     # максимум 2 минуты
                self._flood_waits = getattr(self, "_flood_waits", 0) + 1
                self._log_line("[flood] ждём %d c (случай #%d)"
                               % (wait, self._flood_waits))
                if self._flood_waits > 5:
                    self._fail("Telegram слишком часто просит подождать — "
                               "попробуй позже или уменьши объём.")
                    return
                run_on_ui_thread(lambda: BulletinHelper.show_info(
                    "Telegram просит подождать %d с — продолжаю автоматически." % wait))
                # Ждём в ОТДЕЛЬНОМ потоке, а не в PLUGINS_QUEUE: ожидание до
                # 120 с занимало бы общую очередь плагина целиком, и всё
                # остальное (страницы, кнопки) стояло бы вместе с ней.
                # И ни в каком случае не спим в UI-потоке — это ANR.
                def retry():
                    try:
                        time.sleep(wait)
                    except Exception as _exc5020:
                        _swallow_log('retry@5020', _exc5020)
                        pass
                    if not getattr(self, "_cancelled", False):
                        # повтор ТОЙ ЖЕ страницы: счётчик страниц не растём
                        self._retrying = True
                        try:
                            run_on_queue(self._scan_page, PLUGINS_QUEUE)
                        except Exception:
                            self._scan_page()

                def launch():
                    try:
                        import threading
                        th = threading.Thread(target=retry)
                        th.daemon = True
                        th.start()
                    except Exception as e:
                        self._log_line("[flood] поток не создался: %s" % e)
                        try:
                            run_on_queue(retry, PLUGINS_QUEUE)
                        except Exception:
                            self._fail("Не удалось дождаться паузы Telegram")

                try:
                    run_on_queue(launch, PLUGINS_QUEUE)
                except Exception:
                    launch()
                return
            self._fail("Telegram вернул ошибку: %s" % etxt)
            return

        # _account обязан быть: MessageObject(account, ...) без него бросает
        # AttributeError, и ВСЯ пачка отбрасывается (в логе scanned=0).
        if getattr(self, "_account", None) is None:
            try:
                self._account = self._current_account()
            except Exception:
                self._account = 0
            self._log_line("[scan] _account восстановлен = %s" % self._account)

        messages = getattr(response, "messages", None) if response is not None else None
        n = self._java_size(messages)
        if n == 0:
            # Быстрый скан и 0 сообщений: надо ОТЛИЧИТЬ «нового нет» от «запрос
            # не отдал новое» (ровно этот случай маскировался под «дублей нет»).
            # Дёшево: просим ОДНО самое новое сообщение БЕЗ min_id. Если его id
            # новее прошлого top_id — значит сообщения есть, а мы их не увидели.
            if getattr(self, "_quick", False) and _safe_int(self._scan_from) \
                    and _safe_int(getattr(self, "_page_no", 0)) <= 1:
                try:
                    self._probe_newest("_last_new_id")
                except Exception as _exc5071:
                    self._swallow_ctx('_process@5071', _exc5071)
                    pass
                verdict = self._quick_zero_verdict()
                if verdict == "missed":
                    self._scan_complete = False
                    self._log_line("[quick] ОТМЕНА итога: новые сообщения есть, "
                                   "но быстрый скан их не прочитал — нужен полный")
                    self._review_stage()
                    return
            self._review_stage()
            return

        page_min = None
        page_max = 0
        errors = 0
        keyerr = 0
        for i in range(n):
            # ОДНО битое сообщение не должно ронять весь скан: всё в try
            try:
                tl = messages.get(i)   # Java ArrayList: индексируем через .get(i)
                # НЕ `getattr(tl,"id",0) or 0`: для java.lang.Integer `or`
                # требует bool(), которого у обёртки нет -> TypeError, и всё
                # сообщение уходило в except/continue, то есть ВЫПАДАЛО из
                # скана вместе со своими дублями. _msg_id читает id через
                # getId() и приводит безопасно.
                mid = _msg_id(tl)
                if mid:
                    page_min = mid if page_min is None else min(page_min, mid)
                    page_max = max(page_max, mid)

                if isinstance(tl, TLRPC.TL_messageService):
                    continue

                try:
                    msg = MessageObject(self._account, tl, False, False)
                except Exception as e:
                    # Молчаливый continue: если MessageObject не создался, все
                    # сообщения пачки выпадали и в логе оставалось scanned=0.
                    errors += 1
                    if errors <= 5:
                        self._log_line("[warn] MessageObject(%s) не создан: %s: %s"
                                       % (mid, type(e).__name__, e))
                    continue

                self._scanned += 1
                try:
                    self._msg_ids.add(int(mid))
                except Exception as _exc5118:
                    self._swallow_ctx('_process@5118', _exc5118)
                    pass
                kid = _kind_of(msg)
                self._kind_seen[kid] = self._kind_seen.get(kid, 0) + 1

                # ключи: обычный ключ типа + отдельные ключи на каждую ссылку
                keys = _all_keys(msg)
                if getattr(self, "_verbose", False):
                    self._log_line("[msg] id=%s kind=%s keys=%d" % (mid, kid, len(keys)))

                # --- АЛЬБОМ (медиагруппа): несколько сообщений с общим grouped_id ---
                # Копим item-ключи по grouped_id (порядок не важен), а сами
                # ключи A|... строим ОДИН раз в конце скана — так группировка
                # не рвётся на границах страниц.
                if _MODE.get("album", False):
                    gid = _album_id(msg)
                    if gid:
                        tk = _dup_key(msg)
                        if tk:
                            self._album_groups.setdefault(gid, set()).add(tk)
                        # id элементов альбома — нужны, чтобы удалить альбом ЦЕЛИКОМ
                        self._album_ids.setdefault(gid, []).append(mid)

                if not keys:
                    # сообщение может не иметь своего ключа, но быть частью альбома
                    continue

                for key in keys:
                    try:
                        # настройка: не считать короткие заметки дублями.
                        # Фильтр должен работать для ВСЕХ текстовых ключей:
                        # T| (тип), C| (комбо) и L| (ссылка) — иначе короткая
                        # заметка всё равно удалится через комбо-ключ.
                        if getattr(self, "_skip_short", False):
                            _t = _msg_text(msg).strip()
                            if len(_t) < 4 and (key.startswith("T|")
                                                or key.startswith("C|")
                                                or key.startswith("L|")):
                                continue

                        kk = key[0]
                        if key.startswith("L|"):
                            kk = "link"
                        elif key.startswith("C|"):
                            kk = "combo"
                        elif key.startswith("A|"):
                            # По префиксу "A|" семью определить НЕЛЬЗЯ: он общий у
                            # аудио ("A|<doc_id>|<size>") и альбома ("A|<item>|...").
                            # Раньше любой аудио-ключ получал здесь вид «album»,
                            # и аудиозаписи в списке найденного назывались
                            # «альбомом». Спрашиваем явный предикат.
                            kk = "album" if _is_album_key(key) else "audio"

                        # ПО УМОЛЧАНИЮ оставляем НОВОЕ (то, что внизу Избранного),
                        # старые копии уходят на удаление.
                        # Скан идёт от новых к старым, поэтому первый встреченный
                        # ключ = самый новый экземпляр -> его и оставляем.
                        keep_newest = not bool(getattr(self, "_keep_oldest", False))

                        if getattr(self, "_verbose", False):
                            self._log_line("[key-try] %s id=%s %s"
                                           % (key[:46], mid,
                                              "в индексе" if key in self._seen else "новый"))
                        try:
                            _h = getattr(self, "_key_hits", None)
                            if _h is None:
                                _h = self._key_hits = {}
                            _h[key] = _h.get(key, 0) + 1
                            # ВСЕ id, встречавшиеся на этом ключе: их пишем в
                            # индекс, чтобы старые дубли не терялись.
                            _ki = getattr(self, "_key_ids", None)
                            if _ki is None:
                                _ki = self._key_ids = {}
                            _ki.setdefault(key, set()).add(int(mid))
                        except Exception as _exc5187:
                            self._swallow_ctx('_process@5187', _exc5187)
                            pass
                        if key in self._seen:
                            prev = self._seen[key]
                            # Откуда взялся prev — от этого зависит, кто свежее:
                            #  • обычный скан: скан идёт от новых к старым, prev
                            #    записан раньше -> prev СВЕЖЕЕ, чем mid.
                            #  • быстрый скан: prev пришёл из индекса (прошлый
                            #    прогон, более старое), а mid — только что
                            #    добавленное -> mid СВЕЖЕЕ, чем prev.
                            # Без этого различия быстрый скан удалял бы НОВОЕ
                            # и оставлял старое — прямо наоборот от обещания.
                            from_index = key in getattr(self, "_index_keys", ())
                            # Надёжнее, чем догадка о происхождении: сравнить
                            # сами id. В Telegram новый id всегда БОЛЬШЕ, поэтому
                            # «свежее» = максимум. Догадка «prev из индекса
                            # старее» верна лишь пока в Избранное только
                            # добавляли; сравнение id даёт верный ответ всегда.
                            try:
                                _p = prev[0] if isinstance(prev, list) else int(prev)
                                _p = int(_p)
                            except Exception:
                                _p = None
                            _newer_is_prev = (_p is not None and _p > int(mid))
                            # Список в prev означает альбомный ключ. Сюда такие
                            # ключи не доходят (_all_keys их не выдаёт, альбомы
                            # живут в _apply_albums), но если однажды дойдут —
                            # set.add(список) уронил бы скан TypeError. Поэтому
                            # пропускаем такой ключ явно, а не падаем.
                            # Список в prev бывает только у альбомного ключа
                            # A|: там id — состав альбома, а не «несколько
                            # экземпляров». Такие ключи _all_keys не выдаёт, так
                            # что сюда они не доходят; если однажды дойдут —
                            # set.add(список) уронил бы скан TypeError, поэтому
                            # пропускаем их явно. Обычные ключи теперь всегда
                            # числа (множественные id раскрыты при загрузке
                            # индекса в _dups).
                            if isinstance(prev, list) or isinstance(mid, list):
                                if not _is_album_key(key):
                                    self._log_line("[warn] неожиданный списковый ключ %s" % key)
                                continue
                            if keep_newest:
                                # ЕДИНСТВЕННОЕ верное правило: остаётся тот, у
                                # кого id БОЛЬШЕ (в Telegram новый id всегда
                                # больше) — то есть самое свежее сообщение.
                                #
                                # Прежняя версия сравнивала from_index с
                                # _newer_is_prev и в обеих ветках удаляла СВЕЖЕЕ:
                                # после «Ответить» в Избранное падает новое
                                # сообщение, следующий скан помечал его дублем
                                # и удалял, а старое оставалось — как раз
                                # наоборот от обещания «оставляем свежее».
                                if _p is None:
                                    # id не сравнились -> опираемся на порядок
                                    # скана: при быстром prev из индекса (старее),
                                    # при полном prev записан раньше (свежее).
                                    drop, keep2 = (prev, mid) if from_index else (mid, prev)
                                elif _p > int(mid):
                                    drop, keep2 = mid, prev     # prev свежее -> остаётся
                                else:
                                    drop, keep2 = prev, mid     # mid свежее -> остаётся
                                if drop and drop not in self._dup_ids:
                                    self._dup_ids.add(drop)
                                    self._dups.append(
                                        {"id": drop, "kind": kk, "text": _dup_preview(msg, key)}
                                    )
                                if getattr(self, "_verbose", False):
                                    self._log_line("[dup] key=%s drop=%s keep=%s (%s)"
                                                   % (key[:46], drop, keep2, kk))
                                # индекс всегда хранит САМЫЙ СВЕЖИЙ id
                                self._seen[key] = keep2
                                # ключ обновлён внутри текущего прогона ->
                                # дальше он уже НЕ «из индекса»: следующий
                                # встреченный id будет старее него
                                try:
                                    self._index_keys.discard(key)
                                except Exception as _exc5263:
                                    self._swallow_ctx('_process@5263', _exc5263)
                                    pass
                            else:
                                # «оставлять старое»: в _seen держим САМЫЙ СТАРЫЙ
                                # id, а на удаление идёт более свежий.
                                # Скан идёт от новых к старым, поэтому текущий
                                # mid обычно старее записанного prev — тогда
                                # удаляем prev, а _seen сдвигаем на mid.
                                # Но при быстром скане prev приходит ИЗ ИНДЕКСА
                                # и бывает старее — тогда удалять надо не его.
                                _pn = prev[0] if isinstance(prev, list) else prev
                                try:
                                    _pn = int(_pn)
                                except Exception:
                                    _pn = None
                                try:
                                    _mn = int(mid)
                                except Exception:
                                    _mn = None
                                if _pn is not None and _mn is not None and _mn < _pn:
                                    drop2 = prev
                                    self._seen[key] = mid
                                else:
                                    drop2 = mid
                                try:
                                    self._index_keys.discard(key)
                                except Exception as _exc5289:
                                    self._swallow_ctx('_process@5289', _exc5289)
                                    pass
                                if drop2 and drop2 not in self._dup_ids:
                                    self._dup_ids.add(drop2)
                                    self._dups.append(
                                        {"id": drop2, "kind": kk, "text": _dup_preview(msg, key)}
                                    )
                        else:
                            self._seen[key] = mid
                    except Exception as e:
                        # Раньше здесь был молчаливый continue: если построение
                        # ключа падало, сообщение просто выпадало из скана и в
                        # логе не оставалось НИ СЛЕДА — именно так выглядит
                        # «scanned=100, uniq=0». Теперь пишем причину.
                        keyerr += 1
                        if keyerr <= 8:
                            self._log_line("[warn] ключ %s (id=%s) пропущен: %s: %s"
                                           % (str(key)[:32], mid, type(e).__name__, e))
                        continue
            except Exception as e:
                # пропускаем проблемное сообщение, продолжаем скан
                errors += 1
                if errors <= 5:
                    self._log_line("[warn] msg skip: %s: %s" % (type(e).__name__, e))
                continue

        if errors:
            self._log_line("[warn] skipped %d problem messages" % errors)

        if page_max and not _safe_int(getattr(self, "_first_id", 0)):
            self._first_id = page_max   # самый новый id — база для оценки прогресса

        # count — java.lang.Integer: `if count` бросает TypeError ("no bool"),
        # и _process падал на первом же ответе сервера.
        count = _safe_int(getattr(response, "count", 0))
        if count:
            self._total = count
            if not getattr(self, "_total_logged", False):
                self._total_logged = True
                # count — это ВСЕ сообщения диалога, а не прочитанные сейчас.
                # В быстром скане (min_id = top_id прошлого прогона) читается
                # обычно 0-2 сообщения, и строка «total = 6663» читалась как
                # «прочитал 6663». Пишем режим и что именно означает число.
                if getattr(self, "_quick", False):
                    self._log_line("[scan] всего в диалоге %d, читаю только новые "
                                   "(min_id=%d)" % (self._total, self._scan_from))
                else:
                    self._log_line("[scan] total messages in dialog = %d" % self._total)

        if page_min is not None:
            self._last_msg_id = page_min
        else:
            # Все сообщения пачки отфильтрованы (служебные/битые) и page_min
            # остался None — offset_id НЕ сдвинулся бы, следующий запрос вернул
            # бы ту же пачку, и скан зациклился бы навсегда. Сдвигаем вручную
            # на самый старый id пачки, иначе цикл не завершится.
            _ids = []
            for i in range(n):
                _v = _msg_id(messages.get(i))
                if _v:
                    _ids.append(_v)
            if _ids:
                self._last_msg_id = min(_ids)
            else:
                # id не прочитались вовсе — прекращаем, иначе бесконечный цикл
                self._log_line("[warn] пачка без читаемых id — завершаю скан")
                self._finalize_scan()
                return

        self._refresh_progress()

        if n == 0 and getattr(self, "_page_no", 0) == 1 \
                and not getattr(self, "_total", 0):
            # Пустая ПЕРВАЯ страница и count не пришёл — это НЕ «конец диалога»,
            # а сбой запроса/чужой peer. Помечать такой скан завершённым нельзя:
            # в индексе оказался бы top_id, и следующий поиск молчал бы вечно.
            # (Именно так выглядел баг MM: [resp] 0 msgs -> «dups=0» навсегда.)
            self._log_line("[warn] пустая первая страница без count — "
                           "скан не считаю завершённым, индекс не пишу")
            self._scan_complete = False
            self._finalize_scan()
            return

        if n < PAGE_SIZE:
            # сервер отдал меньше страницы -> это КОНЕЦ диалога.
            # Только в этом случае индекс имеет право записаться (см. MB).
            self._scan_complete = True
            self._log_line("[scan] достигнут конец диалога (получено %d < %d)"
                           % (n, PAGE_SIZE))
            self._finalize_scan()
        else:
            # страховка от зацикливания: если offset не сдвинулся, выходим
            if self._last_msg_id == getattr(self, "_prev_offset", -1):
                self._same_offset = getattr(self, "_same_offset", 0) + 1
                if self._same_offset >= 3:
                    self._log_line("[warn] offset не двигается 3 раза — завершаю скан")
                    self._finalize_scan()
                    return
            else:
                self._same_offset = 0
            self._prev_offset = self._last_msg_id
            run_on_queue(lambda: self._scan_page(), PLUGINS_QUEUE)

    def _finalize_scan(self):
        """Завершение скана: альбомы, лог, индекс, окно дублей.

        Вынесено из _process, потому что вызвать завершение нужно и в
        аварийных случаях (пачка без читаемых id, замерший offset), а не
        только при n < PAGE_SIZE.
        """
        # КРИТИЧНО: отменённый скан НЕ должен записывать индекс.
        # Было так: нажал «Отмена» на первой странице -> _process всё равно
        # доходил сюда -> _save_index(top_id самой новой записи) -> следующий
        # поиск работал от min_id=top_id, читал только новые сообщения и
        # отвечал «дубликатов нет», хотя весь остальной диалог не проверен.
        # Именно поэтому «после отмены поиск ничего не находит».
        if getattr(self, "_cancelled", False):
            self._log_line("[scan] ОТМЕНЁН — индекс НЕ сохраняю "
                           "(быстрый скан по нему пропустил бы весь диалог)")
            try:
                self._persist_log()
            except Exception as _exc5410:
                self._swallow_ctx('_finalize_scan@5410', _exc5410)
                pass
            return
        # --- построить ключи альбомов и учесть их как обычные ключи ---
        if _MODE.get("album", False):
            try:
                self._apply_albums()
            except Exception as e:
                self._log_line("[warn] albums: %s: %s" % (type(e).__name__, e))

        self._log_line("[scan] DONE. scanned=%d uniq_keys=%d dups=%d total=%s"
                       % (self._scanned, len(self._seen), len(self._dups), self._total))
        # разбивка по типам — видно, что реально прочитано
        if self._kind_seen:
            parts = ["%s=%d" % (k, v) for k, v in sorted(self._kind_seen.items())]
            self._log_line("[scan] kinds: " + ", ".join(parts))
        # примеры ключей — доказательство, что дедуп строится, а не пустой
        for k in list(self._seen.keys())[:5]:
            self._log_line("[key] %s" % k)
        self._dedupe_dups()
        self._log_line("[scan] dups after id-dedupe = %d" % len(self._dups))
        _fi = int(getattr(self, "_from_index_dups", 0) or 0)
        if _fi:
            self._log_line("[scan] из них ИЗ ИНДЕКСА (не перечитаны сейчас): %d — "
                           "если они уже удалены руками, сделай полный скан" % _fi)

        # --- ДИАГНОСТИКА ИНДЕКСА (по просьбе: "не находит дубли, кэширует") ---
        # Показывает, ЧТО реально лежит в _seen после прогона и как оно
        # соотносится с индексом. Без этого непонятно, схлопнулся индекс или
        # проверено действительно всё.
        try:
            _idxn = len(getattr(self, "_index_keys", ()) or ())
            _newk = len(self._seen) - _idxn
            self._log_line("[diag] ключей в _seen=%d (из индекса=%d, новых=%d) "
                           "дублей=%d прочитано=%d"
                           % (len(self._seen), _idxn, _newk,
                              len(self._dups), self._scanned))
            # Раньше тут копировался весь _dup_ids в set и пересчитывался
            # поэлементно в _dupk, который НИГДЕ не использовался (в лог
            # уходил len(self._dup_ids)). Это O(n) мусора на каждый прогон.
            self._log_line("[diag] id к удалению=%d, индекса-ключей=%d"
                           % (len(self._dup_ids), _idxn))
            # сколько ключей встретилось БОЛЬШЕ ОДНОГО РАЗА за прогон:
            # в _seen один id на ключ, поэтому повтор виден только по счётчику
            _hits = getattr(self, "_key_hits", None)
            if _hits:
                _multi = [k for k, c in _hits.items() if c > 1]
                self._log_line("[diag] ключей с повтором=%d (примеры: %s)"
                               % (len(_multi), [k[:30] for k in _multi[:5]]))
        except Exception as _e:
            self._log_line("[diag] fail: %s: %s" % (type(_e).__name__, _e))
        # ПИШЕМ ЛОГ НА ДИСК сразу после скана: раньше он сохранялся только
        # после удаления, поэтому «Показать лог» до удаления показывал
        # старый лог с диска вместо свежего.
        try:
            self._persist_log()
        except Exception as _exc5466:
            self._swallow_ctx('_finalize_scan@5466', _exc5466)
            pass
        # сохраняем индекс для быстрого повторного прогона:
        # top_id = самый новый прочитанный id, keys = key->id
        #
        # КРИТИЧНО: только если скан ПРОШЁЛ ВЕСЬ диалог до конца.
        # _first_id — это id самой НОВОЙ прочитанной пачки, а скан идёт от
        # новых к старым. Уже после первой пачки он равен самому свежему
        # сообщению, поэтому сохранение по нему помечало «всё старше top_id уже
        # проверено», хотя прочитана была одна страница из 67. Следующий поиск
        # работал от min_id = top_id, читал 0 новых сообщений и отвечал
        # «дубликатов нет» — весь остальной диалог не проверялся НИКОГДА.
        try:
            top = int(getattr(self, "_first_id", 0) or 0)
            complete = bool(getattr(self, "_scan_complete", False))
            if not top:
                self._log_line("[index] нет top_id — не сохраняю")
            elif not complete:
                self._log_line("[index] скан НЕ завершён (дошёл до id=%s) — "
                               "индекс не сохраняю: иначе быстрый прогон "
                               "пропустил бы непроверенную часть" % self._last_msg_id)
            else:
                self._save_index(top)
        except Exception as e:
            self._log_line("[index] post-scan save failed: %s" % e)
        self._review_stage()

    def _dedupe_dups(self):
        """Убирает повторы id в списке на удаление: одно сообщение могло дать
        два ключа (текст + ссылка), и попасть в список дважды."""
        seen_ids = set()
        uniq = []
        for d in self._dups:
            if d["id"] in seen_ids:
                continue
            seen_ids.add(d["id"])
            uniq.append(d)
        self._dups = uniq

    # ---------------- progress ----------------

    def _show_progress(self):
        def build():
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
            if not act:
                # не сдаёмся: скан работает и без диалога, просто без прогресс-бара
                self._progress = None
                self.logger.warning("no activity -> scanning without progress dialog")
                return
            self._progress = AlertDialogBuilder(act, AlertDialogBuilder.ALERT_TYPE_LOADING)
            self._progress.set_title("Поиск дубликатов")
            self._progress.set_message("Сканирую чат…")
            def _on_cancel_btn(b=None, w=None):
                self._log_line("[ui] нажата кнопка ОТМЕНА (progress)")
                self._cancel()

            self._progress.set_negative_button("Отмена", _on_cancel_btn)
            # ВАЖНО: по документации SDK и set_canceled_on_touch_outside, и
            # set_on_dismiss_listener надёжно применяются ТОЛЬКО после show()
            # («Best called after create() or show()»). Пока они вызывались
            # раньше, часть сборок их игнорировала — и случайный тап снаружи
            # отменял скан.
            self._progress.show()
            self._progress.set_progress(0)
            try:
                self._progress.set_on_dismiss_listener(lambda b: self._on_progress_dismissed())
            except Exception as _exc5533:
                _swallow_log('build@5533', _exc5533)
                pass
            # Дока SDK: set_cancelable(cancelable) — «dismissed by tapping
            # OUTSIDE or pressing BACK». А set_canceled_on_touch_outside
            # управляет ТОЛЬКО тапом снаружи. Скан длится минуты, телефон в
            # руках: тап мимо окна или случайный BACK убивал прогон на 4-й
            # странице (в логе: _scan_page -> _cancel -> +0). Поэтому глушим
            # ОБА пути: неcancelable диалог + явный запрет тапа снаружи.
            try:
                self._progress.set_cancelable(False)
            except Exception as _exc5543:
                _swallow_log('build@5543', _exc5543)
                pass
            try:
                self._progress.set_canceled_on_touch_outside(False)
            except Exception as _exc5547:
                _swallow_log('build@5547', _exc5547)
                pass
            try:
                # BACK — тоже выход: без этого кнопка «назад» отменяла скан.
                self._progress.set_on_back_button_listener(
                    lambda b, w: None)
            except Exception as _exc5553:
                _swallow_log('build@5553', _exc5553)
                pass

        run_on_ui_thread(build)

    def _on_progress_dismissed(self):
        # Тап снаружи — это отмена. Но dismiss() вызывает и НАШ собственный
        # код при нормальном завершении: без этой проверки успешный скан
        # считался отменой, _seen обнулялся и в логе появлялось uniq=0.
        if getattr(self, "_dismiss_is_programmatic", False):
            # Флаг считается «свежим» только 2 секунды после нашего dismiss():
            # если колбэк почему-то не пришёл, он не должен блокировать отмену
            # юзером навсегда.
            _age = time.time() - float(getattr(self, "_dismiss_flag_at", 0) or 0)
            if _age <= 2.0:
                self.logger.info("progress dismissed by plugin -> not a cancel")
                return
            self._log_line("[ui] устаревший флаг программного закрытия (%.1f c) — игнор" % _age)
            self._dismiss_is_programmatic = False
        if self.is_processing:
            self._cancelled = True
            self.is_processing = False
            self.logger.info("progress dismissed externally -> scan cancelled")

    def _refresh_progress(self):
        # Тот же класс, что _first_id/_last_msg_id/_page_no: окно прогресса
        # строится ДО первого скана, а эти поля создаются только внутри него.
        # Голое чтение падало AttributeError'ом именно на этом экране.
        scanned = _safe_int(getattr(self, "_scanned", 0))
        found = len(getattr(self, "_dups", None) or [])
        uniq = len(getattr(self, "_seen", None) or {})
        # В быстром скане _total — это весь объём Избранного из индекса, а
        # scanned — только НОВЫЕ сообщения. Процент от такого отношения застыл
        # бы на 4% при уже законченном скане, поэтому в быстром режиме его
        # не показываем вовсе.
        quick = bool(getattr(self, "_quick", False))
        total = 0 if quick else _safe_int(getattr(self, "_total", 0))
        first_id = getattr(self, "_first_id", 0)
        # _last_msg_id создаётся только внутри скана (_start_scan) и обнуляется
        # в _finalize_scan/сбросах. Окно прогресса строится ДО первого ответа
        # Telegram, поэтому голое чтение здесь падало AttributeError'ом до
        # старта скана (тот же класс, что _first_id/_page_no). Читаем так же,
        # как в _scan_page (getattr с дефолтом 0).
        last_id = getattr(self, "_last_msg_id", 0)

        def upd():
            try:
                if not self._progress:
                    return
                if total > 0:
                    # точный прогресс, если сервер сообщает общее число
                    # честный прогресс: до 99% в процессе, 100% ставит
                    # отдельный вызов по завершении (см. _dismiss_progress)
                    pct = min(99, max(0, int(scanned * 100 / total)))
                    self._progress.set_progress(pct)
                    self._progress.set_message(
                        "Прочитано: %d из %d  (%d%%)\nРазных ключей: %d  Дубликатов: %d"
                        % (scanned, total, pct, uniq, found)
                    )
                elif first_id > 0 and last_id > 0:
                    # оценка по id: доля пройденного пути от нового id к нулю.
                    # last_id == 0 означает «первая страница ещё не прочитана» —
                    # тогда оценка неверна и показываем прогресс без процента.
                    done = first_id - last_id
                    pct = min(99, max(1, int(done * 100 / first_id)))
                    self._progress.set_progress(pct)
                    self._progress.set_message(
                        "Прочитано: %d  (~%d%%)\nРазных ключей: %d  Дубликатов: %d"
                        % (scanned, pct, uniq, found)
                    )
                else:
                    self._progress.set_message(
                        ("Быстрый скан (только новое)\n" if quick else "")
                        + "Прочитано: %d\nРазных ключей: %d  Дубликатов: %d"
                        % (scanned, uniq, found)
                    )
            except Exception as _exc5619:
                _swallow_log('upd@5619', _exc5619)
                pass

        run_on_ui_thread(upd)

    def _dismiss_progress(self, programmatic=True):
        """Закрыть окно прогресса.

        programmatic=True — закрываем МЫ (скан закончился/отменён/ошибка).
        В этом случае dismiss() дёрнет on_dismiss_listener, а тот ставит
        _cancelled = True. Поэтому сначала снимаем флаг «идёт скан»: иначе
        нормальное завершение скана выглядело бы как отмена и стирало уже
        собранные ключи.
        """
        if programmatic:
            try:
                self._dismiss_is_programmatic = True
                # страховка: если dismiss() по какой-то причине не дойдёт до
                # колбэка, флаг не должен остаться True навсегда — иначе
                # следующее закрытие окна юзером НЕ отменит скан.
                self._dismiss_flag_at = time.time()
            except Exception as _exc5640:
                self._swallow_ctx('_dismiss_progress@5640', _exc5640)
                pass

        # Ссылку на окно берём СЕЙЧАС: если закрытие асинхронное и успело
        # прийти новое окно, обнуление self._progress стёрло бы уже его.
        win = getattr(self, "_progress", None)

        def d():
            try:
                if win is not None:
                    self._log_line("[ui] закрываю окно прогресса (программно)")
                    win.dismiss()
            except Exception as e:
                self._log_line("[ui] dismiss окна не удался: %s: %s" % (type(e).__name__, e))
            # снимаем только СВОЮ ссылку, чужую (нового окна) не трогаем
            try:
                if getattr(self, "_progress", None) is win:
                    self._progress = None
            except Exception as _exc5658:
                _swallow_log('d@5658', _exc5658)
                pass
            try:
                self._dismiss_is_programmatic = False
            except Exception as _exc5662:
                _swallow_log('d@5662', _exc5662)
                pass

        run_on_ui_thread(d)

    def _cancel(self):
        # отменяем только идущий скан; повторный вызов безопасен
        if not getattr(self, "is_processing", False):
            self._log_line("[cancel] пропущено: скан не идёт")
            return
        self._log_line("[cancel] отмена скана, прочитано=%d найдено=%d"
                       % (getattr(self, "_scanned", 0), len(getattr(self, "_dups", ()))))
        self._cancelled = True
        self.is_processing = False
        self._retrying = False
        # _dups/_seen НЕ обнуляем: на них строится отчёт и запись индекса.
        # Обнуление обнуляло результат в логе («scanned=100 uniq=0») и теряло
        # ключи, уже прочитанные из индекса.
        self._dismiss_progress()
        self._log_line("[cancel] состояние: is_processing=%s cancelled=%s "
                       "индекс НЕ записан" % (self.is_processing, self._cancelled))
        run_on_ui_thread(lambda: BulletinHelper.show_info("Отменено."))

    def _fail(self, text):
        self._last_error = text
        self.is_processing = False
        self._log_line("[FAIL] %s" % text)
        try:
            self._persist_log()      # аварийный лог не должен теряться
        except Exception as _exc5691:
            self._swallow_ctx('_fail@5691', _exc5691)
            pass
        self.logger.error("scan failed: %s", text)
        self._dismiss_progress()
        run_on_ui_thread(lambda: BulletinHelper.show_error(text))

    # ---------------- review dialog ----------------

    def _apply_albums(self):
        """Построить ключи альбомов и учесть их наравне с обычными ключами.

        Ключ альбома: A|<состав> — отсортированный набор item-ключей
        (P|id, V|id:size, D|id:size, ...). Порядок элементов не важен -> сортировка.
        Дубликат = альбом с ТЕМ ЖЕ составом; удаляется ЦЕЛИКОМ (все его элементы).

        Скан идёт от новых к старым, поэтому первый встреченный альбом
        с данным составом — самый свежий, его оставляем.
        """
        groups = getattr(self, "_album_groups", None) or {}
        aids = getattr(self, "_album_ids", None) or {}
        keep_newest = not bool(getattr(self, "_keep_oldest", False))
        found = dup_albums = 0
        for gid, items in groups.items():
            if len(items) < 2:
                continue          # одно вложение — это не альбом
            akey = "A|" + "|".join(sorted(items))
            found += 1
            # ВАЖНО: sorted() на java.lang.Integer падает
            # ("'<' not supported between instances"). Приводим к питоновским
            # int ДО сортировки — иначе обработка альбомов умирала на первом
            # же альбоме, и лог показывал "groups=382 dups=0".
            ids = sorted(set(_safe_int(x) for x in (aids.get(gid) or [])))
            ids = [x for x in ids if x]
            if not ids:
                continue
            # _cv (id текущего альбома, питоновские int) нужен ОБЕИМ ветвям:
            # и «уже встречался», и «первое вхождение». Раньше он считался
            # только внутри первой, и первый же альбом с новым составом падал
            # с UnboundLocalError — вся обработка альбомов умирала, а в логе
            # оставалось невнятное "[warn] albums: UnboundLocalError". Именно
            # поэтому дедуп альбомов не работал никогда (groups=382 dups=0).
            _cv = list(ids)
            if akey in self._seen:
                # akey уже в индексе. Индекс хранит id из ПРОШЛОГО прогона.
                # Скан идёт от новых к старым, поэтому текущий альбом — самый
                # свежий из ещё не обработанных.
                #
                # keep_newest: оставляем СВЕЖЕЕ -> текущий остаётся, а из
                # индекса (более старый) идёт на удаление; индекс обновляем
                # на текущий, чтобы следующий прогон снова не нашёл его.
                # keep_oldest — наоборот: удаляем текущий, индекс не трогаем.
                prev_ids = self._seen[akey]
                # Кто свежее — решаем ПО ID, а не по порядку обхода.
                # При обычном скане prev_ids (уже в _seen) свежее текущего,
                # но при быстром скане prev_ids приходит ИЗ ИНДЕКСА и бывает
                # старее. Догадка «prev всегда свежее» ломала keep_oldest:
                # удалялось старое вместо нового.
                # id приводим к питоновскому int: java.lang.Integer не
                # сравнивается с int напрямую, и max()/`<` на обёртках давали
                # неверный результат — альбом-дубль просто не удалялся.
                _pv = [_safe_int(x) for x in (prev_ids or [])]
                _prev_max = max(_pv) if _pv else -1
                _cur_max = max(_cv) if _cv else -1
                if keep_newest:
                    # на удаление — тот, что СТАРЕЕ
                    if _prev_max >= _cur_max:
                        drop = ids
                    else:
                        drop = prev_ids
                        self._seen[akey] = _cv     # в _seen питоновские int
                else:
                    # «оставлять старое»: в _seen всегда должен лежать САМЫЙ
                    # СТАРЫЙ из встреченных, а на удаление идёт более свежий.
                    if _cur_max < _prev_max:
                        # текущий старее записанного: удаляем записанный
                        # (он свежее), а в _seen ставим текущий
                        drop = prev_ids
                        self._seen[akey] = _cv
                    else:
                        # записанный уже старее или равен — удаляем текущий
                        drop = ids
                for did in (drop if isinstance(drop, list) else [drop]):
                    _di = _safe_int(did)
                    if _di and _di not in self._dup_ids:
                        self._dup_ids.add(_di)
                        self._dups.append({"id": _safe_int(did), "kind": "album",
                                           "text": "альбом (%d эл.)" % len(items)})
                dup_albums += 1
            else:
                # Первое вхождение: запоминаем как «пока самый старый кандидат».
                # При keep_newest сюда больше никто не придёт с меньшим id до
                # конца пачки (скан идёт от новых к старым), при keep_oldest —
                # придёт, и тогда _seen сдвинется на него.
                self._seen[akey] = _cv
        if found:
            self._log_line("[album] groups=%d dups=%d" % (found, dup_albums))
            self._refresh_progress()

    def _review_stage(self):
        self.is_processing = False
        self._dismiss_progress()
        self._log_line("[review] stage entered, dups=%d uniq=%d" % (len(self._dups), len(self._seen)))

        # Отменённый прогон не подводит итог: иначе после «Отмены» появлялось
        # «Дубликатов не найдено» — а это ЛОЖЬ, скан просто не дочитал (в логе
        # scanned=0 или число меньше общего). Именно это выглядело как «после
        # отмены поиск больше ничего не находит».
        if getattr(self, "_cancelled", False):
            self._log_line("[review] прогон отменён — итог не показываю")
            return

        if not self._dups:
            scanned = self._scanned
            # uniq — число РАЗНЫХ ключей (у сообщения их 2-3), не сообщений.
            # Так и подписано в сообщении, чтобы не выглядело как число записей.
            uniq = len(self._seen)
            quick = bool(getattr(self, "_quick", False))
            age = float((self._index or {}).get("_age_h") or 0)
            extra = ""
            if quick:
                # честная подсказка: быстрый скан видит только новые сообщения,
                # и если давно не было полного — индекс мог устареть.
                extra = ("\n\n(быстрый скан: только новые"
                         + (", индекс %.0f ч" % age if age else "") + ")")
                if age >= _INDEX_MAX_AGE_H:
                    extra += ("\nИндекс старше %d ч — для верности запусти полный скан."
                              % _INDEX_MAX_AGE_H)
            # БАГ MR. При быстром скане с НУЛЁМ новых сообщений «Дубликатов не
            # найдено» — неправда по смыслу: старые сообщения вообще не читались.
            # Пользователь писал новый дубль ДО этого прогона, тот уже лежал в
            # индексе как единственный экземпляр, и плагин бодро отвечал «нет».
            # Теперь в этом случае говорим прямо: НИЧЕГО НОВОГО НЕ ПРОЧИТАНО.
            if quick and not scanned:
                msg = ("Новых сообщений нет — проверять нечего.\n"
                       "В Избранном уже прочитано %d, дублей в них не было.\n\n"
                       "Если ты только что добавил дубль — сделай ПОЛНЫЙ скан "
                       "(кэш сбрасывать не надо)." % uniq)
                run_on_ui_thread(lambda: BulletinHelper.show_info(msg))
                self._log_line("[review] NO NEW MESSAGES: quick scan read 0, "
                               "index has %d keys" % uniq)
                return
            run_on_ui_thread(
                lambda: BulletinHelper.show_info(
                    "Дубликатов не найдено\nПрочитано %d, с уникальным содержимым %d%s"
                    % (scanned, uniq, extra)
                )
            )
            self._log_line("[review] no dups: scanned=%d uniq=%d quick=%s age=%.1fh"
                           % (scanned, uniq, quick, age))
            return

        # старые сверху — стабильное отображение
        self._dups.sort(key=lambda d: d["id"])
        # Отмечаем по умолчанию ТОЛЬКО реально нарисованные строки (MAX_DRAW).
        # Иначе «Удалить» стёрло бы записи, которых пользователь не видел
        # и не мог снять — это удаление вслепую. Остальные доступны кнопкой
        # «ПОСТАВИТЬ ВСЕ».
        self._selected = {d["id"]: (i < MAX_DRAW)
                          for i, d in enumerate(self._dups)}

        def build():
            self._build_review()
        run_on_ui_thread(build)

    def _build_review(self):
        """Построить (или пересобрать) окно показа дублей.

        Вынесено из _review_stage: кнопка «Снять все» пересобирает окно заново,
        потому что любая кнопка AlertDialog закрывает диалог сама.
        """
        def build():
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
            if not act:
                return

            self._review = AlertDialogBuilder(act)
            _sel_n = sum(1 for v in self._selected.values() if v)
            _hidden = max(0, _sel_n - MAX_DRAW)
            _fi_n = int(getattr(self, "_from_index_dups", 0) or 0)
            _kept_n = max(0, int(
                (self._index or {}).get("orig_total") or 0) - len(self._dups)
                if getattr(self, "_quick", False)
                else len(self._msg_ids) - len(self._dups))
            _title = "Дубли: %d   •   остаётся: %d" % (len(self._dups), _kept_n)
            if _fi_n > 0:
                _title += "\n%d найдено в кэше (сейчас не перечитывались)" % _fi_n
            if _hidden > 0:
                _title += "\nотмечено %d, из них %d не влезли в список" % (_sel_n, _hidden)
            # Список включённых режимов ушёл из заголовка В ПОДПИСЬ СНИЗУ:
            # в заголовке 29 названий превращались в нечитаемую строку.
            self._review.set_title(_title)

            scroll = ScrollView(act)
            container = LinearLayout(act)
            container.setOrientation(LinearLayout.VERTICAL)
            pad = AndroidUtilities.dp(8)
            container.setPadding(pad, pad, pad, pad)

            # --- ШАПКА: заголовок + статистика ---
            dups = len(self._dups)      # дублей к удалению
            # Оригиналов = реальные сообщения минус те, что уйдут на удаление.
            # В БЫСТРОМ скане прочитаны только новые сообщения, поэтому по ним
            # считать нельзя: получился бы «оригиналов 0» при 6632 записях.
            # Там берём число из индекса (он знает всё Избранное).
            if getattr(self, "_quick", False):
                orig = int((self._index or {}).get("orig_total") or 0) - dups
            else:
                orig = len(getattr(self, "_msg_ids", ()) or ()) - dups
            orig = max(0, orig)
            # Сколько сообщений ВСЕГО в Избранном.
            # В быстром скане response.count может отражать только новые,
            # поэтому опираемся на реальные данные: индекс + прочитанное.
            total = int(self._total or 0)
            if getattr(self, "_quick", False):
                # в быстром режиме доверяем только индексу (он знает всё Избранное)
                idx_total = int((self._index or {}).get("orig_total") or 0) \
                    if isinstance(getattr(self, "_index", None), dict) else 0
                if idx_total:
                    total = idx_total
            if not total:
                total = self._scanned


            head = TextView(act)
            _mode_line = "БЫСТРЫЙ СКАН (только новые)" if getattr(self, "_quick", False) \
                else "ПОЛНЫЙ СКАН"
            head.setText(_mode_line)
            head.setTextColor(_java_color(0xFF64B5F6))
            head.setTextSize(15)
            try:
                head.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            except Exception as _exc5923:
                _swallow_log('build@5923', _exc5923)
                pass
            container.addView(head, LayoutHelper.createLinear(-1, -2))

            # короткая строка для буллета при закрытии окна
            self._summary = ("%s: %d дубл. из %d  •  оригиналов не тронуто %d"
                             % (__name__, dups, total, orig))

            info = TextView(act)
            info.setText(
                "В чате всего       %6d\n"
                "Новых прочитано    %6d   (из кэша %d)\n"
                "Дублей к удалению  %6d\n"
                "Оригиналов         %6d   не трогаю\n"
                "Останется          %6d"
                % (total, self._scanned,
                   getattr(self, "_from_index", 0), dups, orig, total - dups)
            )
            info.setTextColor(_java_color(0xFFE0E0E0))
            info.setTextSize(13)
            try:
                info.setLineSpacing(AndroidUtilities.dp(2), 1.0)
            except Exception as _exc5945:
                _swallow_log('build@5945', _exc5945)
                pass
            container.addView(info, LayoutHelper.createLinear(-1, -2))

            # разбивка найденных дублей по типам — цветными маркерами
            if self._kind_seen:
                parts = []
                for k in sorted(self._kind_seen, key=lambda x: -self._kind_seen[x]):
                    cnt = self._kind_seen[k]
                    if cnt:
                        parts.append("%s %s %d" % (_KIND_TAG.get(k, "•"), k, cnt))
                kk = TextView(act)
                _kl = "СОСТАВ НОВЫХ" if getattr(self, "_quick", False) else "СОСТАВ ИЗБРАННОГО"
                kk.setText(_kl + "\n" + "─" * 24 + "\n" + "  ".join(parts))
                kk.setTextColor(_java_color(0xFFB0BEC5))
                kk.setTextSize(11)
                container.addView(kk, LayoutHelper.createLinear(-1, -2))

            # Список включённых режимов — мелкой подписью ВНИЗУ: в заголовке
            # он нечитаем, а знать, что именно ищем, нужно.
            try:
                _on_modes = [n for n, on in (
                    ("ссылки", _MODE.get("link", False)), ("текст", _MODE.get("text", False)),
                    ("фото", _MODE.get("photo", False)), ("видео", _MODE.get("video", False)),
                    ("GIF", _MODE.get("gif", False)), ("доки", _MODE.get("doc", False)),
                    ("аудио", _MODE.get("audio", False)), ("голос", _MODE.get("voice", False)),
                    ("стикеры", _MODE.get("sticker", False)), ("наборы", _MODE.get("stickerset", False)),
                    ("кружки", _MODE.get("roundv", False)), ("премиум", _MODE.get("premium", False)),
                    ("опросы", _MODE.get("poll", False)), ("викторины", _MODE.get("quiz", False)),
                    ("веб", _MODE.get("webpage", False)), ("гео", _MODE.get("geo", False)),
                    ("места", _MODE.get("venue", False)), ("контакты", _MODE.get("contact", False)),
                    ("дайсы", _MODE.get("dice", False)), ("игры", _MODE.get("game", False)),
                    ("истории", _MODE.get("story", False)), ("счета", _MODE.get("invoice", False)),
                    ("розыгрыши", _MODE.get("giveaway", False)), ("итоги", _MODE.get("giveawayres", False)),
                    ("платное", _MODE.get("paidmedia", False)), ("задачи", _MODE.get("todo", False)),
                    ("трансляции", _MODE.get("videostream", False)), ("альбомы", _MODE.get("album", False)),
                    ("комбо", _MODE.get("combo", False))) if on]
                _mn = TextView(act)
                _mn.setText("Ищу: " + (", ".join(_on_modes) if _on_modes else "ничего не включено"))
                _mn.setTextColor(_java_color(0xFF8A9BA8))
                _mn.setTextSize(10)
                container.addView(_mn, LayoutHelper.createLinear(-1, -2))
            except Exception as _exc5987:
                _swallow_log('build@5987', _exc5987)
                pass

            # живой счётчик выбранных
            self._sel_label = TextView(act)
            self._sel_label.setText("Выбрано к удалению: %d из %d"
                                    % (sum(1 for v in self._selected.values() if v),
                                       len(self._dups)))
            self._sel_label.setTextColor(_java_color(0xFFFFB74D))
            self._sel_label.setTextSize(13)
            container.addView(self._sel_label, LayoutHelper.createLinear(-1, -2))

            # --- Две кнопки управления выделением ---
            # У AlertDialog всего 3 кнопки, и они заняты, поэтому эти живут
            # в теле окна: «Поставить все» ставит галочки, «Снять все» снимает.
            row = LinearLayout(act)
            try:
                row.setOrientation(0)   # HORIZONTAL
            except Exception as _exc6005:
                _swallow_log('build@6005', _exc6005)
                pass

            b_all = TextView(act)
            b_all.setText("ПОСТАВИТЬ ВСЕ")
            b_all.setTextColor(_java_color(0xFF81D4FA))
            try:
                b_all.setGravity(17)    # CENTER
            except Exception as _exc6013:
                _swallow_log('build@6013', _exc6013)
                pass
            b_all.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(10),
                             AndroidUtilities.dp(8), AndroidUtilities.dp(10))

            b_none = TextView(act)
            b_none.setText("СНЯТЬ ВСЕ")
            b_none.setTextColor(_java_color(0xFFFFB74D))
            try:
                b_none.setGravity(17)
            except Exception as _exc6023:
                _swallow_log('build@6023', _exc6023)
                pass
            b_none.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(10),
                              AndroidUtilities.dp(8), AndroidUtilities.dp(10))

            def _refresh_label():
                # один код на все места: у метода _refresh_selected_count
                # есть защита от пропавшего label, у этой копии её не было,
                # и расхождение рано или поздно дало бы разный текст.
                self._refresh_selected_count()

            def on_all(view):
                self._log_line("[ui] ПОСТАВИТЬ ВСЕ: отмечено %d" % len(self._dups))
                for d in self._dups:
                    self._selected[d["id"]] = True
                for cb in list(getattr(self, "_checkboxes", [])):
                    try:
                        cb.setChecked(True)
                    except Exception as _exc6041:
                        _swallow_log('on_all@6041', _exc6041)
                        pass
                _refresh_label()

            def on_none(view):
                self._log_line("[ui] СНЯТЬ ВСЕ: снято %d" % len(self._dups))
                for d in self._dups:
                    self._selected[d["id"]] = False
                for cb in list(getattr(self, "_checkboxes", [])):
                    try:
                        cb.setChecked(False)
                    except Exception as _exc6052:
                        _swallow_log('on_none@6052', _exc6052)
                        pass
                _refresh_label()

            b_all.setOnClickListener(OnClickListener(on_all))
            b_none.setOnClickListener(OnClickListener(on_none))
            row.addView(b_all, LayoutHelper.createLinear(0, -2, 1.0))
            row.addView(b_none, LayoutHelper.createLinear(0, -2, 1.0))
            container.addView(row, LayoutHelper.createLinear(-1, -2))

            sep = TextView(act)
            sep.setText("─────────────────────")
            sep.setTextColor(_java_color(0xFF37474F))
            container.addView(sep, LayoutHelper.createLinear(-1, -2))

            # Рисуем не больше MAX_DRAW строк. 400 CheckBox в одном LinearLayout
            # блокируют UI-поток: на слабом устройстве это ANR («приложение не
            # отвечает») или падение по памяти. Остальные доступны кнопкой
            # «ПОСТАВИТЬ ВСЕ» — она работает со всем списком, не только с
            # нарисованными строками.
            self._checkboxes = []
            for dup in self._dups[:MAX_DRAW]:
                cb = self._make_checkbox(act, dup)
                container.addView(cb, LayoutHelper.createLinear(-1, -2))

            if len(self._dups) > MAX_DRAW:
                more = TextView(act)
                more.setText("…и ещё %d (в списке не показаны; "
                             "«ПОСТАВИТЬ ВСЕ» отметит и их)"
                             % (len(self._dups) - MAX_DRAW))
                more.setTextColor(_java_color(0xFFFFB74D))
                container.addView(more, LayoutHelper.createLinear(-1, -2))

            scroll.addView(container)
            self._review.set_view(scroll, AndroidUtilities.dp(420))

            # Нижние кнопки: Удалить / Отмена.
            # «Снять все» / «Поставить все» живут в теле окна — нейтральная
            # кнопка не нужна и убрана.
            self._review.set_negative_button("Удалить", lambda b, w: self._confirm())
            self._review.set_positive_button("Отмена", lambda b, w: self._review.dismiss())
            try:
                self._review.make_button_red(AlertDialogBuilder.BUTTON_NEGATIVE)
            except Exception as _exc6095:
                _swallow_log('build@6095', _exc6095)
                pass

            # долгий тап по строке итога — копирование в буфер (не мешает кнопкам)
            try:
                info.setOnLongClickListener(
                    OnLongClickListener(lambda v: (self._copy_summary(), True)[1])
                )
            except Exception as _exc6103:
                _swallow_log('build@6103', _exc6103)
                pass

            # Порядок как в документации SDK: set_cancelable /
            # set_canceled_on_touch_outside / set_on_dismiss_listener работают
            # только ПОСЛЕ show() («Best called after create() or show()»).
            # Пока они вызывались раньше, окно итогов закрывалось случайным
            # тапом снаружи, а dismiss-listener не срабатывал.
            self._review.show()
            try:
                self._review.set_cancelable(False)
            except Exception as _exc6114:
                _swallow_log('build@6114', _exc6114)
                pass
            try:
                self._review.set_canceled_on_touch_outside(False)
            except Exception as _exc6118:
                _swallow_log('build@6118', _exc6118)
                pass
            try:
                self._review.set_on_back_button_listener(
                    lambda b, w: self._copy_summary()
                )
            except Exception as _exc6124:
                _swallow_log('build@6124', _exc6124)
                pass
            try:
                self._review.set_cancelable(False)
            except Exception as _exc6128:
                _swallow_log('build@6128', _exc6128)
                pass
            # страховка: если окно всё же закрыли — итог ещё раз буллетом
            try:
                self._review.set_on_dismiss_listener(
                    lambda b: self._on_review_dismissed()
                )
            except Exception as _exc6135:
                _swallow_log('build@6135', _exc6135)
                pass

        run_on_ui_thread(build)

    def _on_review_dismissed(self):
        """Если окно с итогом закрыли (свайп/скрин) — продублируем итог буллетом."""
        # Программное закрытие (пересборка окна кнопкой «Снять все»/«Поставить
        # все» через _set_all, или закрытие из _do_delete) — это НЕ юзер закрыл
        # окно. Без этой проверки пересборка выдавала буллет с итогом поверх
        # только что открытого окна (та же ошибка, что была у окна прогресса).
        if getattr(self, "_review_dismiss_is_programmatic", False):
            self._review_dismiss_is_programmatic = False
            self.logger.info("review dismissed by plugin -> no summary bulletin")
            return
        # при пустом выборе итог не показываем — иначе он перекрывает
        # сообщение «Ничего не выбрано».
        if getattr(self, "_empty_confirm", False):
            return
        if getattr(self, "_summary", None) and not getattr(self, "_deleted", False):
            try:
                run_on_ui_thread(lambda: BulletinHelper.show_info(self._summary))
            except Exception as _exc6149:
                self._swallow_ctx('_on_review_dismissed@6149', _exc6149)
                pass

    def _copy_summary(self):
        """Копирует сводку + список дублей в буфер."""
        lines = [getattr(self, "_summary", "") or __name__,
                 "", "─" * 24, "ДУБЛИКАТЫ К УДАЛЕНИЮ", "─" * 24]
        for n, d in enumerate(self._dups, 1):
            lines.append("%2d. %s   (id %s)"
                         % (n, _to_str(d.get("text")) or "…", _safe_int(d.get("id"))))
        text = "\n".join(lines)
        if not self._copy_to_clipboard(text):
            run_on_ui_thread(lambda: BulletinHelper.show_error("Не удалось скопировать итог."))
        else:
            run_on_ui_thread(lambda: BulletinHelper.show_info(
                "Скопировано: %d записей" % len(self._dups)))

    def _make_checkbox(self, act, dup):
        mid = dup["id"]
        kind = dup.get("kind", "")
        cb = CheckBox(act)

        # цветной маркер типа + читаемый текст, id приглушённым
        tag = _KIND_TAG.get(kind, "•")
        cb.setText("%s  %s\n      id %s"
                   % (tag, _to_str(dup.get("text")) or "…", _safe_int(mid)))
        cb.setTextColor(_java_color(0xFFE8E8E8))
        try:
            cb.setTextSize(13)
        except Exception as _exc6178:
            self._swallow_ctx('_make_checkbox@6178', _exc6178)
            pass
        # галочка из ТЕКУЩЕГО состояния (важно при пересборке окна:
        # иначе после «Снять все» всё снова окажется отмеченным)
        cb.setChecked(bool(self._selected.get(mid, True)))
        try:
            cb.setPadding(AndroidUtilities.dp(6), AndroidUtilities.dp(3),
                          AndroidUtilities.dp(6), AndroidUtilities.dp(3))
        except Exception as _exc6186:
            self._swallow_ctx('_make_checkbox@6186', _exc6186)
            pass

        plugin = self

        def on_clicked(view):
            checked = bool(view.isChecked())
            plugin._selected[mid] = checked
            plugin._log_line("[ui] checkbox id=%d -> %s" % (mid, checked))
            plugin._refresh_selected_count()

        cb.setOnClickListener(OnClickListener(on_clicked))
        self._checkboxes.append(cb)
        return cb

    def _refresh_selected_count(self):
        if not getattr(self, "_sel_label", None):
            return
        n = sum(1 for v in self._selected.values() if v)

        def upd():
            try:
                # единый формат со остальными местами («из N»)
                self._sel_label.setText("Выбрано к удалению: %d из %d"
                                        % (n, len(self._dups)))
            except Exception as _exc6211:
                _swallow_log('upd@6211', _exc6211)
                pass

        run_on_ui_thread(upd)

    def _set_all(self, value):
        """Снять/поставить ВСЕ галочки. Окно НЕ закрывается.

        Любая кнопка AlertDialog закрывает диалог после нажатия, поэтому
        недостаточно просто переставить setChecked: окно надо закрыть и
        построить заново с уже обновлённым состоянием _selected.
        """
        self._log_line("[ui] set_all(%s)" % value)
        for d in self._dups:
            self._selected[d["id"]] = bool(value)

        def reopen():
            try:
                if self._review:
                    # Программное закрытие: НЕ даём dismiss-listener'у показать
                    # буллет с итогом — юзер только что нажал «Снять/Поставить
                    # все», поверх нового окна всплывал бы старый итог.
                    # Флаг снимает сам _on_review_dismissed (одноразовый);
                    # страховка от «повисшего» флага — сброс в конце reopen.
                    self._review_dismiss_is_programmatic = True
                    self._review.dismiss()
            except Exception as _exc6231:
                _swallow_log('reopen@6231', _exc6231)
                pass
            self._review_dismiss_is_programmatic = False
            self._review = None
            # пересобираем окно с новым состоянием галочек
            self._build_review()

        run_on_ui_thread(reopen)

    def _confirm(self):
        ids = [mid for mid, sel in self._selected.items() if sel]
        self._log_line("[confirm] open, selected ids=%d" % len(ids))
        if not ids:
            # помечаем, что удалять нечего: иначе при закрытии окна
            # сработает _on_review_dismissed и покажет «Итог…», перекрыв это.
            self._empty_confirm = True
            self._deleted = True      # подавляем показ итога
            self._log_line("[confirm] nothing selected -> info, no delete")
            run_on_ui_thread(lambda: BulletinHelper.show_info("Ничего не выбрано — удалять нечего."))
            return
        self._empty_confirm = False

        plugin = self

        def build():
            try:
                frag = get_last_fragment()
                act = frag.getParentActivity() if frag else None
                self._log_line("[confirm] activity=%s" % ("yes" if act else "NO"))
                if not act:
                    return
                dlg = AlertDialogBuilder(act)
                dlg.set_title("Удалить отмеченное?")
                # len(self._seen) — это число УНИКАЛЬНЫХ КЛЮЧЕЙ (у одного
                # сообщения их бывает 2-3: текст + ссылка + комбо), а не
                # сообщений. Показывать его как «остаётся» — враньё в диалоге
                # (14186 «оригиналов» при 6632 сообщениях). Берём реальное
                # число прочитанных сообщений.
                kept = max(0, int(getattr(self, "_scanned", 0) or 0))
                dlg.set_message(
                    "К УДАЛЕНИЮ   %d\n"
                    "ПРОЧИТАНО    %d\n"
                    "%s\n"
                    "Оригиналы остаются на месте."
                    % (len(ids), kept, "─" * 22)
                )

                def on_confirm(*args):
                    plugin._log_line("[confirm] BUTTON PRESSED args=%d" % len(args))
                    # _deleted ДО dismiss: закрытие окна вызывает
                    # _on_review_dismissed, а он показывает буллет с итогом,
                    # если _deleted ещё False. Иначе итог всплывал бы поверх
                    # только что открытого диалога подтверждения.
                    plugin._deleted = True
                    # _empty_confirm здесь НЕ ставим: он глушит буллет с итогом
                    # при закрытии окна, но закрытие уже глушит _deleted=True
                    # (см. _on_review_dismissed). Раньше флаг ставился тут и не
                    # сбрасывался — «залипал» на всю сессию, и следующий показ
                    # итога молча пропадал до следующего скана.
                    plugin._empty_confirm = False
                    # dismiss может быть в args[0], может быть недоступен
                    bld = args[0] if args else dlg
                    try:
                        bld.dismiss()
                    except Exception:
                        try:
                            dlg.dismiss()
                        except Exception as e2:
                            plugin._log_line("[confirm] dismiss failed: %s" % e2)
                    plugin._do_delete(ids)

                def on_cancel(*args):
                    plugin._log_line("[confirm] cancelled args=%d" % len(args))
                    bld = args[0] if args else dlg
                    try:
                        bld.dismiss()
                    except Exception:
                        try:
                            dlg.dismiss()
                        except Exception as _exc6304:
                            _swallow_log('on_cancel@6304', _exc6304)
                            pass

                dlg.set_positive_button("Удалить", on_confirm)
                dlg.set_negative_button("Отмена", on_cancel)
                try:
                    dlg.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
                except Exception as _exc6311:
                    _swallow_log('build@6311', _exc6311)
                    pass
                dlg.show()
                self._log_line("[confirm] dialog shown")
            except Exception as e:
                self._log_line("[ERROR] confirm build: %s: %s" % (type(e).__name__, e))
                self.logger.exception("confirm failed")

        run_on_ui_thread(build)

    def _do_delete(self, ids):
        # Защита от повторного запуска: двойной тап «Удалить» (или второй диалог
        # поверх первого) иначе запустил бы ДВА удаления одного набора.
        if getattr(self, "_deleting", False):
            self._log_line("[delete] уже идёт — повторный вызов проигнорирован")
            return
        self._deleting = True
        self._deleted = True
        # Сбрасываем флаг отмены: он мог остаться True от «Отмены» скана или
        # от закрытия окна прогресса. Иначе цикл удаления прервался бы на
        # первой же пачке и не удалил НИЧЕГО.
        self._cancelled = False
        self._log_line("[delete] _do_delete entered ids=%d" % len(ids))
        if getattr(self, "_verbose", False):
            self._log_line("[delete] список id: %s" % list(ids)[:80])
        try:
            if self._review:
                # программное закрытие: буллет с итогом не нужен, мы удаляем
                self._review_dismiss_is_programmatic = True
                self._review.dismiss()
        except Exception as e:
            self._log_line("[delete] dismiss review failed: %s" % e)
        self._review_dismiss_is_programmatic = False
        self._review = None

        def work():
          # try/finally обязателен: если тут что-то упадёт (нет
          # get_messages_controller, не импортировался Java-класс), флаг _deleting
          # остался бы True НАВСЕГДА, и все следующие удаления молча игнорировались бы.
          self._deleting = True
          try:
            self._log_line("[delete] worker started (ui thread)")
            from java.util import ArrayList
            from org.telegram.tgnet import TLRPC

            # EncryptedChat — типизированный объект. NoneType для этого
            # параметра НЕ подходит: deleteMessages падает с
            # "cannot be applied to (..., NoneType, ...)". Поэтому если класс
            # не удалось создать, удаление НЕ начинаем вовсе — иначе все пачки
            # упадут одинаково, а пользователь получит нули без причины.
            enc = None
            try:
                enc = TLRPC.TL_encryptedChat()
            except Exception as e:
                self._log_line("[delete] EncryptedChat стаб не создался: %s" % e)
            if enc is None:
                self._deleting = False
                self._log_line("[delete] отменено: нет EncryptedChat")
                run_on_ui_thread(lambda: BulletinHelper.show_error(
                    "Удаление недоступно: клиент не отдал EncryptedChat. "
                    "Попробуйте через меню Избранного."
                ))
                return

            # dialogId ДОЛЖЕН быть id самого пользователя, а НЕ 0!
            # Из MessagesController.getInputPeer(long id):
            #     if (id == getUserConfig().getClientUserId())
            #         inputPeer = new TLRPC.TL_inputPeerSelf();
            # При id=0 условие ложно -> peer строится как ЧУЖОЙ чат с id 0,
            # и запрос удаления уходит на несуществующий диалог: локально
            # «удалено», на сервере — нет. Для Избранного нужен TL_inputPeerSelf,
            # то есть dialogId = id текущего пользователя.
            # dialogId всегда Избранное: его id — это id самого пользователя,
            # так getInputPeer вернёт TL_inputPeerSelf.
            dialog_id = _safe_int(getattr(self, "_my_id", 0))

            # Сервер за один вызов принимает ~100 id, остальные отбрасывает МОЛЧА.
            # Документация Telegram: "a JSON-serialized list of 1-100
            # identifiers". 100 — ГРАНИЦА, а клиентские обёртки часто режут
            # строго меньше, поэтому берём 90: два лишних вызова дешевле,
            # чем молча потерянная сотня сообщений.
            BATCH = 90
            PAUSE = 1.2          # секунд между пачками — проходит антифлуд
            total = len(ids)
            sent = 0
            failed = 0
            # id, по которым сервер подтвердил удаление (нужны для чистки индекса)
            self._sent_ids = set()

            # Удаление идёт в отдельном потоке, чтобы паузы между пачками не
            # морозили интерфейс.
            # deleteMessages трогает View (ChatActivity.processDeletedMessages
            # -> notifyDataSetChanged -> requestLayout), поэтому ВЫЗОВ обязан
            # идти в UI-потоке. Из фоновой очереди Android бросает
            # CalledFromWrongThreadException и НЕ удаляет ничего.
            def delete_chunk(chunk):
                msg_ids = ArrayList()
                for i in chunk:
                    msg_ids.add(Integer(i))
                randoms = ArrayList()
                controller = get_messages_controller(self._account)
                if controller is None:
                    # без контроллера вызов уронил бы AttributeError в каждой
                    # пачке, а отчёт показал бы нули без причины
                    raise RuntimeError("get_messages_controller вернул None")
                controller.deleteMessages(
                    msg_ids,     # 1 ArrayList<Integer> messages
                    randoms,     # 2 ArrayList<Long> randoms (пустой — ок)
                    enc,         # 3 TLRPC.EncryptedChat
                    dialog_id,   # 4 long dialogId   (id пользователя = Избранное)
                    0,           # 5 int topicId     (не channelId! это тема форума)
                    False,       # 6 boolean forAll  (Избранное — только своё)
                    0,           # 7 int mode        (0 = MODE_DEFAULT)
                )
                # Подписи позиций сверены с MessagesController.deleteMessages
                # (7-аргументная перегрузка — единственная с topicId на 5-м месте).
                if getattr(self, "_verbose", False):
                    self._log_line("[del-args] dialogId=%s enc=%s topicId=0 forAll=False "
                                   "mode=0 ids=%s" % (dialog_id, type(enc).__name__, list(chunk)))

            for start in range(0, total, BATCH):
                # Плагин могли выгрузить (или нажать «Отмена») посреди удаления.
                # Без этой проверки поток доудалял бы всё дальше — при выгрузке
                # пользователь как раз и хочет остановить работу.
                if getattr(self, "_cancelled", False):
                    self._log_line("[delete] прервано на пачке %d (отмена/выгрузка)" % start)
                    break
                chunk = ids[start:start + BATCH]
                err_box = []
                done_evt = threading.Event()

                def call_in_ui(ch=chunk, eb=err_box, ev=done_evt):
                    try:
                        delete_chunk(ch)
                    except Exception as ex:
                        eb.append("%s: %s" % (type(ex).__name__, ex))
                    finally:
                        ev.set()

                try:
                    run_on_ui_thread(call_in_ui)
                    # Ждём завершения вызова в UI (не дольше 15 с на пачку).
                    # wait() возвращает False по таймауту БЕЗ исключения, и
                    # err_box остаётся пустым. Считать это успехом нельзя:
                    # delete_chunk мог вообще не выполниться, а отчёт сказал бы
                    # «удалено». Поэтому отдельная ветка для таймаута.
                    finished = done_evt.wait(15)
                    if err_box:
                        failed += len(chunk)
                        self._log_line("[ERROR] batch %d failed: %s"
                                       % (start, err_box[0]))
                    elif not finished:
                        failed += len(chunk)
                        self._log_line("[ERROR] batch %d: UI не ответил за 15 с "
                                       "(удаление не подтверждено)" % start)
                    else:
                        sent += len(chunk)
                        self._sent_ids.update(chunk)
                        self._log_line("[delete] batch %d-%d submitted (%d/%d) ids=%s"
                                       % (start, start + len(chunk), sent, total,
                                          (list(chunk) if getattr(self, "_verbose", False)
                                           else "%d шт" % len(chunk))))
                except Exception as e:
                    failed += len(chunk)
                    self._log_line("[ERROR] batch %d failed: %s: %s"
                                   % (start, type(e).__name__, e))
                if start + BATCH < total:
                    time.sleep(PAUSE)   # пауза — в фоне, UI не морозим

            kept = len(self._seen)
            scanned = self._scanned
            self._log_line("[delete] done. submitted=%d failed=%d kept=%d scanned=%d"
                           % (sent, failed, kept, scanned))

            msg = ("ГОТОВО\n" + "─" * 22 + "\n"
                   "Удалено дублей   %d\n"
                   "Оригиналов       %d   на месте\n"
                   "Ошибок           %d"
                   % (sent, kept, failed))
            if failed:
                msg += "\n\nЧасть пачек не прошла — прогони поиск ещё раз."

            run_on_ui_thread(lambda: BulletinHelper.show_success(msg))

            try:
                self._persist_log()
            except Exception as _exc6494:
                _swallow_log('work@6494', _exc6494)
                pass
            # Чистим индекс точечно: убираем только те id, что реально ушли
            # на удаление. Полный сброс заставлял бы следующий прогон читать
            # всё Избранное заново — минуты на каждую чистку.
            if self._sent_ids:
                try:
                    # 1) ПАМЯТЬ: убираем удалённые id из всех структур.
                    #    Без этого _seen/_key_ids продолжают держать id, которых
                    #    уже нет, и следующий прогон снова предложит их удалить
                    #    («дубли» из воздуха при scanned=0).
                    _gone = set(int(x) for x in self._sent_ids)
                    for _k in list(getattr(self, "_key_ids", {}).keys()):
                        _ids = {x for x in self._key_ids[_k] if x not in _gone}
                        if _ids:
                            self._key_ids[_k] = _ids
                            self._seen[_k] = max(_ids)
                        else:
                            self._key_ids.pop(_k, None)
                            self._seen.pop(_k, None)
                    try:
                        self._msg_ids.difference_update(_gone)
                    except Exception as _exc6516:
                        _swallow_log('work@6516', _exc6516)
                        pass
                    self._dups = [d for d in self._dups
                                  if int(d.get("id") or 0) not in _gone]
                    self._dup_ids.difference_update(_gone)
                    self._log_line("[index] из памяти снято id: %d, ключей осталось %d"
                                   % (len(_gone), len(self._seen)))
                    # 2) ФАЙЛ: и вычистить, и перезаписать актуальным состоянием.
                    self._drop_ids_from_index(list(_gone))
                    try:
                        # complete сохраняем КАК БЫЛ: удаление не делает
                        # индекс полным, оно лишь вычищает удалённые id.
                        _old_complete = bool((self._index or {}).get("complete", False)) \
                            or bool(getattr(self, "_scan_complete", False))
                        # top_id берём из _first_id (самый новый известный id),
                        # а НЕ из self._index: к моменту удаления индекс уже
                        # выгружен (None), и в файл уходил top_id=0. Следующий
                        # поиск из-за этого всегда шёл полным сканом — в логе
                        # это выглядело как «[index] saved: top_id=0», и вся
                        # экономия быстрого прогона пропадала.
                        _top = _safe_int(getattr(self, "_first_id", 0))
                        if not _top:
                            _top = _safe_int((self._index or {}).get("top_id") or 0)
                        self._save_index(_top, complete=_old_complete)
                    except Exception as _e2:
                        self._log_line("[index] перезапись после удаления: %s" % _e2)
                except Exception as e:
                    self._log_line("[index] post-delete cleanup: %s" % e)
          except Exception as e:
            self._log_line("[ERROR] delete worker: %s: %s" % (type(e).__name__, e))
            try:
                self.logger.exception("delete worker failed")
            except Exception as _exc6548:
                _swallow_log('work@6548', _exc6548)
                pass
            run_on_ui_thread(lambda: BulletinHelper.show_error(
                "Удаление не выполнено: %s" % e))
          finally:
            # снимаем защиту от повторного запуска при ЛЮБОМ исходе
            self._deleting = False
            self._cooldown_until = time.time() + 4.0

        try:
            # Паузы между пачками (до 100*1.2с при больших объёмах) держали бы
            # PLUGINS_QUEUE занятой, и всё остальное в плагине ждало бы молча.
            # Поэтому цикл идёт в СВОЁМ потоке, а не в общей очереди.
            # Сам deleteMessages безопасен вне UI: он трогает View только через
            # notification-handler, который Telegram привязывает к main.
            import threading
            th = threading.Thread(target=work)
            th.daemon = True
            th.start()
            self._log_line("[delete] worker started in own thread")
        except Exception as e:
            # Поток не создался — снимаем защиту, иначе удаление осталось бы
            # заблокированным навсегда («уже идёт» при каждом нажатии).
            self._deleting = False
            self._log_line("[ERROR] delete worker start failed: %s: %s"
                           % (type(e).__name__, e))
            self.logger.exception("delete worker start failed")
            run_on_ui_thread(lambda: BulletinHelper.show_error(
                "Не удалось запустить удаление: %s" % e))