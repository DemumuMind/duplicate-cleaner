        except Exception as e:
            # если что-то из ui.settings недоступно — отдаём минимальный рабочий экран
            self.logger.exception("create_settings failed")
            try:
                from ui.settings import Header, Text
                return [
                    Header(text=__name__ + " (упрощённый режим)"),
                    Text(
                        text="Найти дубликаты",
                        icon="msg_list",
                        subtext="Ошибка настроек: %s" % _to_str(e)[:120],
                        on_click=self._on_settings_run,
                    ),
                ]
            except Exception:
                return []

    def _safe_account(self):
        """Индекс аккаунта — из скан-состояния, иначе из SDK (для «Открыть Избранное»)."""
        a = getattr(self, "_account", None)
        if a is None:
            try:
                a = self._current_account()
            except Exception:
                a = 0
        try:
            return _safe_int(a)
        except Exception:
            return 0

    def _safe_my_id(self):
        """Свой user id. Работает БЕЗ предварительного поиска: берём из UserConfig."""
        mid = getattr(self, "_my_id", None)
        if not mid:
            try:
                mid = _safe_int(get_user_config(self._safe_account()).getClientUserId())
            except Exception:
                mid = 0
        try:
            return _safe_int(mid or 0)
        except Exception:
            return 0

    def _current_account(self):
        """Индекс выбранного аккаунта — через UserConfig из SDK, без импорта Java-класса."""
        try:
            cfg = get_user_config()
            return _safe_int(cfg.getCurrentAccount())
        except Exception:
            try:
                return _safe_int(get_user_config().selectedAccount)
            except Exception:
                return 0

    def _on_settings_run(self, view):
        # настроечный экран: account берём у SDK (контекста меню тут нет)
        try:
            self._log_line("[ui] settings: Найти дубликаты")
            account = self._current_account()
            my_id = _safe_int(get_user_config(account).getClientUserId())
            if not my_id:
                run_on_ui_thread(lambda: BulletinHelper.show_error(
                    "Не удалось определить ваш аккаунт — откройте «Избранное» и повторите."
                ))
                return
            self._start_scan(account, my_id)
        except Exception as e:
            self._log_line("[ERROR] settings run: %s: %s" % (type(e).__name__, e))
            run_on_ui_thread(lambda: BulletinHelper.show_error("Ошибка запуска: %s" % e))

    def _copy_to_clipboard(self, text):
        """Копирует текст в буфер. True только если копирование РЕАЛЬНО прошло.

        Раньше тут стоял `run_on_ui_thread(lambda: copy_to_clipboard(text))` и
        сразу `return True`. Но run_on_ui_thread АСИНХРОНЕН: вызов лишь ставит
        задачу в очередь UI. Если копирование внутри падало, исключение уходило
        в UI-поток и терялось, а функция докладывала «скопировано». Пользователь
        шёл вставлять — буфер пуст.

        Теперь копируем СИНХРОННО и возвращаем настоящий результат. Копирование
        в буфер из фонового потока безопасно (ClipboardManager потокобезопасен),
        а если мы уже в UI — тоже без проблем.
        """
        # 1) прямой системный ClipboardManager — честный результат.
        # ВАЖНО: get_application_context в android_utils НЕ существует
        # (в модуле только R/OnClickListener/OnLongClickListener/
        #  run_on_ui_thread/log/copy_to_clipboard) — импорт всегда падал,
        # и до системного пути дело не доходило. Берём контекст сами.
        try:
            from android.content import ClipData
            ctx = None
            try:
                from android.app import ActivityThread
                ctx = ActivityThread.currentApplication()
            except Exception:
                ctx = None
            if ctx is None:
                try:
                    from android.app import ActivityThread as _AT
                    ctx = _AT.currentActivityThread().getApplication()
                except Exception:
                    ctx = None
            if ctx is not None:
                cm = ctx.getSystemService("clipboard")
                if cm is not None:
                    cm.setPrimaryClip(
                        ClipData.newPlainText(__name__, text))
                    return True
        except Exception as e:
            self._log_line("[clip] системный буфер: %s: %s" % (type(e).__name__, e))

        # 2) хелпер SDK
        try:
            from android_utils import copy_to_clipboard
            copy_to_clipboard(text)
            return True
        except Exception as e:
            self._log_line("[clip] SDK copy_to_clipboard: %s: %s" % (type(e).__name__, e))

        self.logger.exception("clipboard: оба способа не сработали")
        return False

    def _on_copy_log(self, view):
        lines = self._full_log_text()
        text = "\n".join(lines)
        n = len(lines)
        if not self._copy_to_clipboard(text):
            run_on_ui_thread(lambda: BulletinHelper.show_error("Не удалось скопировать лог."))
        else:
            try:
                run_on_ui_thread(lambda: BulletinHelper.show_info("Скопировано: %d записей, %d символов" % (n, len(text))))
            except Exception as _exc2441:
                self._swallow_ctx('_on_copy_log@2441', _exc2441)
                pass

    def _full_log_text(self):
        """ЕДИНЫЙ источник лога для показа и копирования.

        Раньше «Показать лог» читал с диска, а «Скопировать» — только память,
        поэтому копирование давало меньше (или пустоту после перезапуска).
        Теперь оба берут отсюда: память + диск, дубли строк убраны.
        """
        mem = [x for x in (getattr(self, "_log", None) or [])
               if "лог очищен" not in x]
        # подробность последней ошибки — раньше копилась в _last_error и
        # никуда не выводилась: пользователь видел только «Ошибка».
        err = getattr(self, "_last_error", None)
        if err:
            mem = mem + ["", "── последняя ошибка ──"] + _to_str(err).split("\n")
        # Память — актуальный лог: _persist_log просто ПЕРЕЗАПИСЫВАЕТ ею диск,
        # то есть диск всегда её копия (или устаревшая копия прошлого запуска).
        # Склеивать «диск + память» нельзя: после скана это одни и те же
        # строки, и в окне каждая показывалась ДВАЖДЫ (88 записей -> 176).
        # Диск читаем только когда памяти нет — после перезапуска клиента.
        if mem:
            return mem
        disk = self._load_log_from_disk()
        return disk if disk else ["(лог пуст — сначала запусти поиск)"]

    def _load_log_from_disk(self):
        """Прочитать лог с диска — чтобы «Показать лог» работал и после
        перезапуска клиента (в памяти лога тогда ещё нет)."""
        try:
            import os
            path = self._data_path("log.txt")
            if os.path.exists(path):
                with open(path, "r", encoding="utf-8", errors="replace") as f:
                    data = f.read().strip().splitlines()
                if data:
                    return data
        except Exception as _exc2479:
            self._swallow_ctx('_load_log_from_disk@2479', _exc2479)
            pass
        return []

    def _screen_view_height(self, act=None):
        """Высота области лога: доля экрана (было фиксированно 480dp).

        displaySize из SDK может отсутствовать — берём высоту из метрик
        активити, а если и это не выйдет, падаем на безопасные 480dp.
        """
        try:
            if act is not None:
                dm = act.getResources().getDisplayMetrics()
                h = int(dm.heightPixels)
                if h > 0:
                    return int(h * 0.6)
        except Exception as _exc2495:
            self._swallow_ctx('_screen_view_height@2495', _exc2495)
            pass
        try:
            h = AndroidUtilities.displaySize.y
            if h > 0:
                return int(h * 0.6)
        except Exception as _exc2501:
            self._swallow_ctx('_screen_view_height@2501', _exc2501)
            pass
        try:
            return AndroidUtilities.dp(480)
        except Exception:
            return 480

    def _on_show_log(self, view):
        """Полноценный экран лога со скроллом + кнопки Копировать/Закрыть."""
        lines = self._full_log_text()
        full_text = "\n".join(lines)   # полный лог — уходит в «Копировать»
        text = full_text               # в TextView может быть урезан ниже

        def build():
          try:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
            if not act:
                try:
                    run_on_ui_thread(lambda: BulletinHelper.show_info("\n".join(lines[-6:])))
                except Exception as _exc2521:
                    _swallow_log('build@2521', _exc2521)
                    pass
                return

            scroll = ScrollView(act)
            tv = TextView(act)
            tv.setText(text)
            # setTextIsSelectable перехватывает касания -> ScrollView не листается.
            # Нужен либо выделяемый текст, либо прокрутка; для лога важнее второе.
            try:
                tv.setTextIsSelectable(False)
            except Exception as _exc2532:
                _swallow_log('build@2532', _exc2532)
                pass
            tv.setTypeface(AndroidUtilities.getTypeface("fonts/rcondensedbold.ttf"))
            tv.setTextSize(11)
            tv.setTextColor(_java_color(0xFFB0FFB0))
            tv.setPadding(
                AndroidUtilities.dp(10), AndroidUtilities.dp(10),
                AndroidUtilities.dp(10), AndroidUtilities.dp(10),
            )
            # Добавляем РОВНО ОДИН раз (второй addView бросал
            # «child already has a parent» и диалог не открывался).
            added = False
            try:
                from android.widget import LinearLayout as _LL
                scroll.addView(tv, _LL.LayoutParams(
                    _LL.LayoutParams.MATCH_PARENT,
                    _LL.LayoutParams.WRAP_CONTENT,
                ))
                added = True
            except Exception as _exc2551:
                _swallow_log('build@2551', _exc2551)
                pass
            if not added:
                scroll.addView(tv)

            # Высота ScrollView задаётся ЯВНО: ширина во весь диалог,
            # высота = доля экрана. Без этого ScrollView не знает границ
            # и не листается (текст обрезается на первом экране).
            try:
                from android.view import ViewGroup as _VG
                scroll.setLayoutParams(_VG.LayoutParams(
                    _VG.LayoutParams.MATCH_PARENT,
                    self._screen_view_height(act),
                ))
                scroll.setFillViewport(True)
                tv.setVerticalScrollBarEnabled(True)
                scroll.setVerticalScrollBarEnabled(True)
                scroll.setScrollbarFadingEnabled(False)
            except Exception as _exc2569:
                _swallow_log('build@2569', _exc2569)
                pass

            dlg = AlertDialogBuilder(act)
            n_rec = len(lines)
            n_chr = len(text)
            # TextView с десятками тысяч символов Android не отрисовывает:
            # окно не открывается или приложение подвисает. Показываем хвост,
            # а полный лог остаётся в кнопке «Копировать».
            drop = getattr(self, "_log_dropped", 0)
            drop_txt = ", вытеснено старых: %d" % drop if drop else ""
            if n_chr > LOG_SHOW_CHARS:
                tv.setText("\n".join(lines)[-LOG_SHOW_CHARS:])
                dlg.set_title("Лог: %d записей (буфер %d%s) — виден конец, "
                              "начало через Копировать" % (n_rec, MAX_LOG_LINES, drop_txt))
            else:
                dlg.set_title("Лог: %d записей, %d символов (буфер %d%s)"
                              % (n_rec, n_chr, MAX_LOG_LINES, drop_txt))
            dlg.set_view(scroll, -2)   # WRAP_CONTENT: высоту задаёт сам ScrollView
            # Кнопки лога. «Трейс» переключает подробный режим прямо отсюда:
            # иначе за ним надо идти в настройки, а лог нужен здесь и сейчас.
            def _flip_trace(b, w):
                try:
                    on = not self._trace_on()
                    self.set_setting("mode_trace", 1 if on else 0)
                    self._trace = on          # кэш для wrapper
                    if on:
                        self._install_trace()
                    else:
                        self._uninstall_trace()
                    self._log_line("[ui] трейс = %s (из окна лога)" % on)
                    run_on_ui_thread(lambda: BulletinHelper.show_info(
                        "Подробный лог %s" % ("включён" if on else "выключен")))
                except Exception as e:
                    try:
                        self._log_line("[ui] трейс: %s: %s" % (type(e).__name__, e))
                    except Exception as _exc2605:
                        _swallow_log('_flip_trace@2605', _exc2605)
                        pass

            def _flip_verbose(b, w):
                try:
                    v = not bool(self._verbose) if hasattr(self, "_verbose") else True
                    self._verbose = v
                    self.set_setting("mode_trace_verbose", 1 if v else 0)
                    self._log_line("[ui] детальный разбор = %s (из окна лога)" % v)
                    run_on_ui_thread(lambda: BulletinHelper.show_info(
                        "Разбор каждого сообщения %s" % ("включён" if v else "выключен")))
                except Exception as e:
                    try:
                        self._log_line("[ui] verbose: %s: %s" % (type(e).__name__, e))
                    except Exception as _exc2619:
                        _swallow_log('_flip_verbose@2619', _exc2619)
                        pass

            # Показать НАЧАЛО: при длинном логе виден конец, а причины сбоя
            # часто в самом начале прогона ([start], [index], [mode]).
            head_mode = [False]

            def _toggle_head(b, w):
                head_mode[0] = not head_mode[0]
                try:
                    if head_mode[0]:
                        tv.setText("\n".join(lines)[:LOG_SHOW_CHARS])
                        dlg.set_title("Лог: %d записей — показано НАЧАЛО" % n_rec)
                    else:
                        if n_chr > LOG_SHOW_CHARS:
                            tv.setText("\n".join(lines)[-LOG_SHOW_CHARS:])
                        else:
                            tv.setText(full_text)
                        dlg.set_title("Лог: %d записей, %d символов" % (n_rec, n_chr))
                except Exception as e:
                    self._log_line("[log-view] head toggle: %s: %s" % (type(e).__name__, e))

            dlg.set_neutral_button("Копировать",
                                   lambda b, w: self._copy_log_from_dialog(full_text, n_rec))
            dlg.set_negative_button("Начало/Конец", _toggle_head)
            dlg.set_positive_button("Закрыть", lambda b, w: b.dismiss())
            dlg.show()
          except Exception as e:
            # видно НА ЭКРАНЕ, а не только в системном логе
            try:
                self._log_line("[log-view] %s: %s" % (type(e).__name__, e))
            except Exception as _exc2650:
                _swallow_log('build@2650', _exc2650)
                pass
            try:
                run_on_ui_thread(lambda: BulletinHelper.show_error("Лог не открылся: %s: %s" % (type(e).__name__, e)))
            except Exception as _exc2654:
                _swallow_log('build@2654', _exc2654)
                pass

        run_on_ui_thread(build)

    def _copy_log_from_dialog(self, text, n):
        if not self._copy_to_clipboard(text):
            run_on_ui_thread(lambda: BulletinHelper.show_error("Не удалось скопировать лог."))
        else:
            run_on_ui_thread(lambda: BulletinHelper.show_info(
                "Скопировано: %d записей, %d символов" % (n, len(text))))

    def _on_clear_log(self, view):
        # чистим И память, И файл на диске — иначе следующий «Показать лог»
        # подтянет старьё с диска и покажет противоречивую картину.
        self._log = []
        try:
            self._persist_log()
        except Exception as _exc2672:
            self._swallow_ctx('_on_clear_log@2672', _exc2672)
            pass
        try:
            run_on_ui_thread(lambda: BulletinHelper.show_info("Лог очищен (память и файл)."))
        except Exception as _exc2676:
            self._swallow_ctx('_on_clear_log@2676', _exc2676)
            pass

    def _log_line(self, text):
        """Записать строку в кольцевой лог (последние 500 строк) + в системный лог."""
        if not hasattr(self, "_log") or self._log is None:
            self._log = []
        try:
            ts = time.strftime("%H:%M:%S")
            line = "%s %s" % (ts, text)
            _log = self._log
            _log.append(line)
            # буфер побольше: скан большого Избранного даёт тысячи строк,
            # при 2000 начало лога терялось и показ расходился с копированием.
            #
            # Обрезка БАТЧАМИ. Раньше на каждой строке сверх потолка делался
            # del _log[:dropped] с dropped=1 — это O(n) на каждую строку, то
            # есть O(n^2) на всём заполненном буфере (50k строк -> ~10 ms на
            # 100 строк, замерено). Поэтому режем только когда переполнение
            # дошло до целой пачки: список уже не перекладывается по элементу.
            # Семантика та же (логика «последние MAX_LOG_LINES строк»),
            # переполнение всегда остаётся < _LOG_TRIM_STEP.
            if len(_log) > MAX_LOG_LINES + _LOG_TRIM_STEP:
                dropped = len(_log) - MAX_LOG_LINES
                del _log[:dropped]
                # Считаем, сколько строк вытеснено: иначе непонятно, полон ли
                # лог. Число показывается в заголовке окна и в отчёте.
                self._log_dropped = getattr(self, "_log_dropped", 0) + dropped
        except Exception:
            pass
        # Сброс на диск по ВРЕМЕНИ, а не на каждую строку. Раньше единственным
        # сбросом были ручные вызовы из горячих путей: строка лога копилась в
        # памяти, и при падении/убийстве процесса посреди длинного прогона
        # терялись все записи с последнего сброса. Писать файл ЦЕЛИКОМ на
        # каждую строку нельзя — буфер до 50000 строк даёт O(n^2). Компромисс:
        # максимум один сброс в LOG_FLUSH_SEC секунд -> проигравших строк мало,
        # а стоимость записи ограничена.
        try:
            now = time.time()
            if now - getattr(self, "_log_flush_t", 0.0) >= LOG_FLUSH_SEC:
                self._log_flush_t = now
                self._persist_log()
        except Exception:
            pass
        try:
            self.logger.info("[SC] %s", text)
        except Exception:
            pass

    def _persist_log(self):
        """ПЕРЕЗАПИСЫВАЕТ файл лога целиком из памяти (не дописывает).

        Память — источник истины: диск всегда её копия, поэтому склейка
        «диск + память» при показе давала каждую строку дважды. Вызывается
        из горячих путей по батчам (каждые N страниц, после скана/удаления,
        в аварийном пути) и по таймеру из _log_line."""
        try:
            import os
            path = self._data_path("log.txt")
            with open(path, "w", encoding="utf-8") as f:
                f.write("\n".join(getattr(self, "_log", []) or []))
        except Exception:
            pass

    def _swallow_ctx(self, tag, exc, cap=8):
        """Отчитаться о поглощённом исключении (контекст метода класса).

        Раньше пустой `except Exception: pass` в горячем пути прятал реальный
        сбой: лог показывал «прочитано 0» без единой причины. Теперь каждый
        такой обработчик называет себя. Повторы (одна и та же точка в цикле)
        гасим через модульный счётчик _SWALLOW_N."""
        _swallow_log(tag, exc, cap)

    def _on_open_saved(self, view):
        """Открыть «Избранное» внутри приложения (presentFragment)."""
        # Открываем «Избранное» ВНУТРИ приложения: presentFragment(ChatActivity).
        # Простой intent из контекста приложения не открывает нужную активити,
        # поэтому идём через текущий фрагмент -> его активити (LaunchActivity).
        def open_it():
            errs = []
            my_id = self._safe_my_id()
            acc = self._safe_account()
            frag = get_last_fragment()
            act = None
            try:
                act = frag.getParentActivity() if frag else None
            except Exception as e:
                errs.append("frag:%s" % e)

            # фолбэк: достать текущую активити через ActivityThread
            if act is None:
                try:
                    from java.lang import Class as JClass
                    at = JClass.forName("android.app.ActivityThread")
                    cur = at.getMethod("currentActivityThread", []).invoke(None, [])
                    acts = cur.getField("mActivities").get(cur)
                    vals = acts.values().toArray()
                    for a in vals:
                        aa = getattr(a, "activity", None)
                        if aa is not None:
                            act = aa
                            break
                except Exception as e:
                    errs.append("thread:%s" % e)

            if act is None:
                self._log_line("[open] no activity: %s" % ("; ".join(errs) or "unknown"))
                return False

            # ChatActivity(account) — диалог «Избранное» (our self dialog)
            # Из исходников Telegram: ChatActivity(Bundle args) — ОДИН аргумент,
            # а диалог задаётся ключом arguments.getLong("user_id").
            # Избранное = диалог с самим собой -> user_id = свой id.
            try:
                from org.telegram.ui import ChatActivity
                args = Bundle()
                args.putLong("user_id", int(my_id))
                # chatMode = MODE_SAVED (3): без него ChatActivity считает это
                # обычным диалогом с самим собой. Из исходника ChatActivity:
                #     MODE_SAVED = 3
                #     public long getSavedDialogId() {
                #         return chatMode == MODE_SAVED ? threadMessageId : 0L; }
                #     setSavedDialog(id) { threadMessageId = id; }
                # с MODE_SAVED включаются заголовок «Избранное» и saved-ветки,
                # а getSavedDialogId() перестаёт возвращать 0.
                try:
                    args.putInt("chatMode", 3)
                except Exception as _exc2794:
                    _swallow_log('open_it@2794', _exc2794)
                    pass
                fragment = ChatActivity(args)
                try:
                    fragment.setCurrentAccount(_safe_int(acc))
                except Exception as _exc2799:
                    _swallow_log('open_it@2799', _exc2799)
                    pass          # метод может отсутствовать — не критично
                try:
                    fragment.setSavedDialog(int(my_id))
                except Exception as _exc2803:
                    _swallow_log('open_it@2803', _exc2803)
                    pass          # публичный метод ChatActivity; есть не везде
                act.presentFragment(fragment)
                return True
            except Exception as e:
                errs.append("present(%s: %s)" % (type(e).__name__, e))

            # второй фолбэк: presentFragment принимает 2-й аргумент (без анимации)
            try:
                from org.telegram.ui import ChatActivity
                args2 = Bundle()
                args2.putLong("user_id", int(my_id))
                try:
                    args2.putInt("chatMode", 3)   # MODE_SAVED
                except Exception as _exc2817:
                    _swallow_log('open_it@2817', _exc2817)
                    pass
                act.presentFragment(ChatActivity(args2), False)
                return True
            except Exception as e:
                errs.append("present2(%s: %s)" % (type(e).__name__, e))

            self._log_line("[open] failed: %s" % "; ".join(errs))
            return False

        # навигация обязана идти в UI-потоке; run_on_ui_thread асинхронный,
        # поэтому внутри колбэка сами решаем, показать ли фолбэк-подсказку
        def worker():
            try:
                ok = open_it()
            except Exception as e:
                self._log_line("[open] err: %s: %s" % (type(e).__name__, e))
                ok = False
            if not ok:
                try:
                    run_on_ui_thread(lambda: BulletinHelper.show_info(
                        "Не удалось открыть автоматически — открой чат в списке."
                    ))
                except Exception as _exc2840:
                    _swallow_log('worker@2840', _exc2840)
                    pass

        run_on_ui_thread(worker)

    def _on_quick_scan_change(self, value):
        # Пишем настройку ЯВНО: хост не сохраняет Switch сам, а скан читает
        # get_setting("quick_scan", 1) — без set_setting тумблер «Быстрый скан»
        # слетал на 1 при каждой перезагрузке плагина.
        try:
            self.set_setting("quick_scan", 1 if value else 0)
            self._log_line("[ui] quick_scan=%s" % bool(value))
        except Exception as _exc2852:
            self._swallow_ctx('_on_quick_scan_change@2852', _exc2852)
            pass

    def _on_mode_trace(self, value):
        """Переключатель подробного трейса. Wrapper читает кэш _trace,
        поэтому после смены настройки кэш надо обновить."""
        on = bool(value)
        try:
            self._trace = on
            # Раньше настройка НЕ сохранялась — тумблер молча откатывался к
            # значению из get_setting при следующей перезагрузке плагина.
            self.set_setting("mode_trace", 1 if on else 0)
            self._log_line("[ui] подробный лог (трейс) = %s" % on)
        except Exception as _exc2865:
            self._swallow_ctx('_on_mode_trace@2865', _exc2865)
            pass
        if on:
            try:
                self._install_trace()
            except Exception as _exc2870:
                self._swallow_ctx('_on_mode_trace@2870', _exc2870)
                pass
        else:
            # Выключение обязано СНЯТЬ обёртки, а не просто замолчать:
            # иначе 110 методов остаются обёрнутыми до перезапуска.
            try:
                self._uninstall_trace()
            except Exception as _exc2877:
                self._swallow_ctx('_on_mode_trace@2877', _exc2877)
                pass

    def _on_mode_trace_verbose(self, value):
        try:
            v = bool(value)
            self._verbose = v
            # Настройка должна переживать перезагрузку (см. _trace_sync).
            self.set_setting("mode_trace_verbose", 1 if v else 0)
            self._log_line("[ui] детальный разбор каждого сообщения = %s" % v)
        except Exception as _exc2887:
            self._swallow_ctx('_on_mode_trace_verbose@2887', _exc2887)
            pass

    def _on_about(self, view):
        """Экран «О плагине»: что делает, версия, лицензия.

        Нужен для публичного использования: человек, поставивший плагин,
        должен видеть, что он ставит и как это проверить.
        """
        try:
            mods = []
            try:
                mods = sorted(k for k in _MODE.keys())
            except Exception as _exc2900:
                self._swallow_ctx('_on_about@2900', _exc2900)
                pass
            # по 4 в строку: сплошной строкой из 29 названий читать невозможно
            mods_txt = "\n".join(
                ", ".join(mods[i:i + 4]) for i in range(0, len(mods), 4)
            ) if mods else "—"
            txt = (
                "%s\n"
                "версия %s\n"
                "автор %s   лицензия %s\n\n"
                "ЧТО ДЕЛАЕТ\n"
                "Чистит дубли в Избранном. Оставлять можно\n"
                "свежее (по умолчанию: в Telegram свежее = ниже в списке)\n"
                "или старое. Оригинал не удаляется, если у него нет пары.\n\n"
                "КАК ПОЛЬЗОВАТЬСЯ\n"
                "1. Настройки плагина → «Найти дубликаты».\n"
                "2. Отметьте лишние в списке.\n"
                "3. «Удалить» → подтвердите.\n"
                "Удаление необратимо, как и в самом Telegram.\n\n"
                "РЕЖИМОВ: %d\n%s\n\n"
                "ПРОВЕРКА\n"
                "Кнопка «САМОТЕСТ» прогоняет встроенные проверки на живых\n"
                "объектах приложения и показывает ПРОЙДЕНО N из M.\n\n"
                "Данные плагина: %s\n"
                "Файлы не покидают устройство и не отправляются никуда.\n"
            ) % (__name__, __version__, __author__, __license__,
                 len(mods), mods_txt,
                 self._index_path())
        except Exception as e:
            txt = "%s %s\n(сборка описания: %s)" % (__name__, __version__, e)
        try:
            from ui.alert import AlertDialogBuilder
            from android.widget import TextView
            frag = get_last_fragment()
            act = None
            try:
                act = frag.getParentActivity() if frag is not None else None
            except Exception:
                act = None
            if act is None:
                from ui.bulletin import BulletinHelper
                BulletinHelper.show_info(__name__ + " " + __version__)
                return
            d = AlertDialogBuilder(act)
            d.set_title("О плагине")
            # Без ScrollView + отступов длинные строки упирались в края окна и
            # обрезались справа (список режимов читался кусками). Даём скролл,
            # боковые поля и перенос длинных абзацев.
            scroll = ScrollView(act)
            tv = TextView(act)
            tv.setText(txt)
            try:
                tv.setTextIsSelectable(False)
            except Exception as _exc2953:
                self._swallow_ctx('_on_about@2953', _exc2953)
                pass
            tv.setTextSize(13)
            try:
                tv.setLineSpacing(AndroidUtilities.dp(3), 1.0)
            except Exception as _exc2958:
                self._swallow_ctx('_on_about@2958', _exc2958)
                pass
            tv.setPadding(
                AndroidUtilities.dp(16), AndroidUtilities.dp(12),
                AndroidUtilities.dp(16), AndroidUtilities.dp(12),
            )
            try:
                tv.setTextColor(_java_color(0xFFE8E8E8))
            except Exception as _exc2966:
                self._swallow_ctx('_on_about@2966', _exc2966)
                pass
            try:
                from android.widget import LinearLayout as _LL
                scroll.addView(tv, _LL.LayoutParams(
                    _LL.LayoutParams.MATCH_PARENT,
                    _LL.LayoutParams.WRAP_CONTENT,
                ))
            except Exception:
                scroll.addView(tv)
            try:
                from android.view import ViewGroup as _VG
                scroll.setLayoutParams(_VG.LayoutParams(
                    _VG.LayoutParams.MATCH_PARENT,
                    self._screen_view_height(act),
                ))
                scroll.setFillViewport(True)
            except Exception as _exc2983:
                self._swallow_ctx('_on_about@2983', _exc2983)
                pass
            d.set_view(scroll, -2)
            d.set_positive_button("Ок", lambda b, w: b.dismiss())
            d.set_neutral_button("Копировать",
                                 lambda b, w: self._copy_to_clipboard(txt))
            d.show()
        except Exception as e:
            try:
                self._log_line("[about] %s: %s" % (type(e).__name__, e))
            except Exception as _exc2993:
                self._swallow_ctx('_on_about@2993', _exc2993)
                pass

    def _on_selftest(self, view):
        """САМОТЕСТ: прогоняет ВЕСЬ функционал плагина на живых объектах.

        Что проверяется (каждая проверка — отдельный t(name, fn)):
          • КАЖДЫЙ из 29 режимов _MODE по отдельности: включён только он —
            сообщение его типа даёт ключ; режим выключен (остальные вкл.) —
            ключа его типа НЕТ;
          • КАЖДЫЙ тумблер/настройка: обработчик отработал, _MODE/атрибут
            изменился И self.set_setting вызван с нужным ключом и значением;
          • keep_oldest в ОБЕ стороны: «свежее» и «старое»;
          • кнопки/строки: карточка настроек, окно дублей, прогресс,
            просмотр/копирование/очистка лога, «О плагине», Отмена, сброс;
          • полный цикл скан -> индекс -> удаление и запрос быстрого скана.

        Проверка НЕ МОЖЕТ ВРАТЬ: в assert'ах нет «или <константа>», и ни одна
        проверка не сравнивает значение с тем, что сама же и подставила.
        Тест НЕ пишет в файлы пользователя: реальный индекс подменяется
        временным путём, а исходное состояние возвращается в finally.
        """
        import threading

        def work():
            res = []
            ok = [0]
            bad = []
            _report = getattr(self, "_log_line")   # ссылка на лог ДО любых
            # подмен: даже если проверка оставит self._log_line подменённым,
            # итог самотеста всё равно попадёт в лог.

            try:
                _acc = int(getattr(self, "_account", None)
                           if getattr(self, "_account", None) is not None
                           else self._current_account())
            except Exception:
                _acc = 0

            try:
                from org.telegram.tgnet import TLRPC
                from org.telegram.messenger import MessageObject
            except Exception as e:
                self._log_line("[selftest] нет SDK: %s: %s" % (type(e).__name__, e))
                return

            try:
                if len(getattr(self, "_log", []) or []) > 5000:
                    self._log = self._log[-1000:]
            except Exception:
                pass

            def t(name, fn):
                try:
                    r = fn()
                    ok[0] += 1
                    res.append("  ok   " + name + ("" if r is None else " -> " + str(r)))
                except Exception as e:
                    bad.append((name, type(e).__name__, str(e)))
                    res.append("  FAIL " + name + ": " + type(e).__name__ + ": " + str(e))

            # ---------- фабрики живых сообщений ----------
            def _jlist(items=None):
                """java.util.ArrayList — именно её ждут java-поля TLRPC.

                Питоновский list java не примет: «Cannot convert list object to
                java.util.ArrayList». Раньше самотест клал в поля обычные списки,
                и 20 проверок падали на конвертации, а не на плагине.
                """
                from java.util import ArrayList
                a = ArrayList()
                for it in (items or []):
                    a.add(it)
                return a

            def _safe_set(o, name, val):
                """setattr с внятной ошибкой.

                Никаких носителей: если поле не пишется, тест должен сказать
                ЭТО ПРЯМО, а не подменять объект — подмена ломает isinstance
                (плагин сверяет isinstance(media, TLRPC.TL_messageMediaPhoto))
                и потому «чинит» проверку ровно наоборот.
                """
                setattr(o, name, val)
                return o

            def _real(cls_name):
                """Синоним _obj: нужен там, где мост сверяет ТИП поля."""
                return _obj(cls_name)

            def _obj(cls_name):
                """Объект TLRPC-класса. Поле у объекта ЧИТАЕТСЯ плагином через
                getattr, а пишется обычным присваиванием — это и есть запись в
                java-поле, как делает сам Telegram."""
                cls = getattr(TLRPC, cls_name, None)
                if cls is None:
                    raise AssertionError("v SDK net TLRPC." + cls_name)
                return cls()

            def _sub(cls_name, **attrs):
                """Вложенный объект с полями — через _obj (носитель полей)."""
                try:
                    o = _obj(cls_name)
                except Exception:
                    class _B(object):
                        pass
                    o = _B()
                for k, v in attrs.items():
                    setattr(o, k, v)
                return o

            def _tl(mid, text=""):
                tl = TLRPC.TL_message()
                tl.id = mid
                tl.message = text
                tl.media = TLRPC.TL_messageMediaEmpty()
                return tl

            def _wrap(tl):
                return MessageObject(_acc, tl, False, False)

            def live(txt, mid=1):
                return _wrap(_tl(mid, txt))

            def _doc(mid, mime="", size=1000, sticker=False, premium=False,
                     voice=False, roundv=False, attached=False):
                tl = _tl(mid)
                doc = _obj("TL_document")
                doc.id = 700 + mid
                doc.size = size
                doc.mime_type = mime
                attrs = _jlist()
                if sticker:
                    # doc.sticker — это ОБЪЕКТ TLRPC.DocumentAttributeSticker,
                    # а не булево. Присваивание True давало AttributeError
                    # «TLRPC$TL_document object has no attribute sticker».
                    # классы берём через _sub: в части сборок их нет в TLRPC,
                    # и тест не должен падать из-за отсутствия класса — он должен
                    # проверить, что ПЛАГИН это переживает.
                    st = _sub("TL_documentAttributeSticker")
                    st.alt = "🎯"
                    # stickerset — это ОБЪЕКТ, и именно его наличие означает
                    # «стикер из набора» (поля doc.attached_stickers в TLRPC нет).
                    # Для режима «стикер» набор НЕ ставим: иначе он справедливо
                    # попадёт в «наборы». Для «наборов» — ставим.
                    # `attached` у этого хелпера означает «стикер из набора».
                    # Ставим stickerset ТОЛЬКО тогда: иначе обычный стикер
                    # справедливо попадёт в режим «наборы». Тип обязан быть
                    # настоящим TLRPC$InputStickerSet — произвольный объект
                    # java-мост не примет.
                    if attached:
                        ss = _sub("TL_inputStickerSetID")
                        ss.id = 900 + mid
                        try:
                            ss.access_hash = 0
                        except Exception:
                            pass
                        st.stickerset = ss
                    else:
                        st.stickerset = _sub("TL_inputStickerSetEmpty")
                    try:
                        attrs.add(st)
                    except Exception:
                        pass
                    if premium:
                        pr = _sub("TL_documentAttributeSticker")
                        pr.alt = "premium"
                        attrs.add(pr)
                    if attached:
                        doc.attached_stickers = _jlist([1, 2])
                if voice:
                    a = _obj("TL_documentAttributeAudio")
                    a.voice = True
                    a.duration = 5
                    attrs.add(a)
                if roundv:
                    a = _obj("TL_documentAttributeVideo")
                    a.round_message = True
                    a.w = 240
                    a.h = 240
                    attrs.add(a)
                doc.attributes = attrs
                media = _obj("TL_messageMediaDocument")
                media.document = doc
                tl.media = media
                return _wrap(tl)

            def live(txt, mid=1):
                return _wrap(_tl(mid, txt))

            def _doc(mid, mime="", size=1000, sticker=False, premium=False,
                     voice=False, roundv=False, attached=False):
                tl = _tl(mid)
                doc = _obj("TL_document")
                doc.id = 700 + mid
                doc.size = size
                doc.mime_type = mime
                attrs = _jlist()
                if sticker:
                    st = _obj("TL_documentAttributeSticker")
                    st.alt = "🎯"
                    # stickerset — это ОБЪЕКТ, и его наличие означает «стикер из
                    # набора» (поля doc.attached_stickers в TLRPC нет вообще).
                    # Для обычного стикера набор НЕ ставим.
                    if attached:
                        ss = _obj("TL_inputStickerSetID")
                        ss.id = 900 + mid
                        ss.access_hash = 0
                        st.stickerset = ss
                    else:
                        st.stickerset = _obj("TL_inputStickerSetEmpty")
                    attrs.add(st)
                    if premium:
                        pr = _obj("TL_documentAttributeSticker")
                        pr.alt = "premium"
                        attrs.add(pr)
                if voice:
                    a = _obj("TL_documentAttributeAudio")
                    a.voice = True
                    a.duration = 5
                    attrs.add(a)
                if roundv:
                    a = _obj("TL_documentAttributeVideo")
                    a.round_message = True
                    a.w = 240
                    a.h = 240
                    attrs.add(a)
                doc.attributes = attrs
                media = _obj("TL_messageMediaDocument")
                media.document = doc
                tl.media = media
                return _wrap(tl)

            def mk(kind, mid=100, text=""):
                if kind == "text":
                    return live("Дубликат", mid)
                if kind == "link":
                    return live("https://example.com/page", mid)
                if kind == "photo":
                    tl = _tl(mid)
                    ph = _obj("TL_photo")
                    ph.id = 555
                    media = _obj("TL_messageMediaPhoto")
                    media.photo = ph
                    tl.media = media
                    return _wrap(tl)
                if kind == "video":
                    return _doc(mid, mime="video/mp4")
                if kind == "gif":
                    return _doc(mid, mime="image/gif")
                if kind == "doc":
                    return _doc(mid, mime="application/pdf")
                if kind == "audio":
                    return _doc(mid, mime="audio/mpeg")
                if kind == "voice":
                    return _doc(mid, mime="audio/ogg", voice=True)
                if kind == "sticker":
                    return _doc(mid, sticker=True)
                if kind == "stickerset":
                    return _doc(mid, sticker=True, attached=True)
                if kind == "premium":
                    return _doc(mid, sticker=True, premium=True)
                if kind == "roundv":
                    return _doc(mid, mime="video/mp4", roundv=True)
                if kind in ("poll", "quiz"):
                    tl = _tl(mid)
                    poll = _obj("TL_poll")
                    # В TLRPC.java поле question — это TLRPC$TL_textWithEntities.
                    # Мост принимает ТОЛЬКО объект этого класса, поэтому строку
                    # подставить нельзя («Cannot convert str object»). Пробуем
                    # заполнить поле через обычное присваивание (на части сборок
                    # оно работает), а если не вышло — оставляем пустой объект:
                    # проверяется РАСПОЗНАВАНИЕ режима, а не текст вопроса, а
                    # вопрос-объект без текста плагин переживёт (он читает через
                    # _to_str с фолбэком на пустую строку).
                    q = _real("TL_textWithEntities")
                    for _nm, _vl in (("text", "Вопрос?"), ("entities", None)):
                        if _vl is None:
                            continue
                        try:
                            setattr(q, _nm, _vl)
                        except Exception:
                            pass
                    poll.question = q
                    if kind == "quiz":
                        poll.quiz = True
                    a = _obj("TL_pollAnswer")
                    a.text = "Да"
                    a.option = bytes(b"\x00")
                    poll.answers = _jlist([a])
                    media = _obj("TL_messageMediaPoll")
                    media.poll = poll
                    tl.media = media
                    return _wrap(tl)
                if kind == "webpage":
                    tl = _tl(mid)
                    wp = _obj("TL_webPage")
                    wp.url = "https://example.com/art"
                    media = _obj("TL_messageMediaWebPage")
                    media.webpage = wp
                    tl.media = media
                    return _wrap(tl)
                if kind == "geo":
                    tl = _tl(mid)
                    g = _obj("TL_geoPoint")
                    g.lat = 55.7512
                    # В TLRPC.java поле называется **_long** (Java не даёт имя "long").
                    # Плагин перебирает long/_long/lon, поэтому носителю можно
                    # положить настоящее имя поля.
                    g._long = 37.6184
                    media = _obj("TL_messageMediaGeo")
                    media.geo = g
                    tl.media = media
                    return _wrap(tl)
                if kind == "venue":
                    tl = _tl(mid)
                    g = _obj("TL_geoPoint")
                    g.lat = 55.7512
                    # В TLRPC.java поле называется **_long** (Java не даёт имя "long").
                    # Плагин перебирает long/_long/lon, поэтому носителю можно
                    # положить настоящее имя поля.
                    g._long = 37.6184
                    media = _obj("TL_messageMediaVenue")
                    media.geo = g
                    media.title = "Кафе"
                    media.address = "ул. Тверская, 1"
                    tl.media = media
                    return _wrap(tl)
                if kind == "contact":
                    tl = _tl(mid)
                    media = _obj("TL_messageMediaContact")
                    media.phone_number = "+79001234567"
                    media.first_name = "Иван"
                    media.last_name = "Петров"
                    tl.media = media
                    return _wrap(tl)
                if kind == "dice":
                    tl = _tl(mid)
                    media = _obj("TL_messageMediaDice")
                    media.emoticon = "🎲"
                    media.value = 4
                    tl.media = media
                    return _wrap(tl)
                if kind == "game":
                    tl = _tl(mid)
                    game = _sub("TL_game", id=909, title="Игра")
                    media = _obj("TL_messageMediaGame")
                    media.game = game
                    tl.media = media
                    return _wrap(tl)
                if kind == "story":
                    tl = _tl(mid)
                    peer = _obj("TL_peerUser")
                    peer.user_id = 4242
                    media = _obj("TL_messageMediaStory")
                    media.peer = peer
                    media.id = 77
                    tl.media = media
                    return _wrap(tl)
                if kind == "invoice":
                    tl = _tl(mid)
                    media = _obj("TL_messageMediaInvoice")
                    media.title = "Товар"
                    media.currency = "RUB"
                    media.total_amount = 100
                    tl.media = media
                    return _wrap(tl)
                if kind == "giveaway":
                    tl = _tl(mid)
                    media = _obj("TL_messageMediaGiveaway")
                    media.quantity = 3
                    media.months = 1
                    media.until_date = 1900000000
                    media.channels = _jlist([111, 222])
                    tl.media = media
                    return _wrap(tl)
                if kind == "giveawayres":
                    tl = _tl(mid)
                    media = _obj("TL_messageMediaGiveawayResults")
                    media.channel_id = 111
                    media.launch_msg_id = 5
                    media.winners = _jlist([1, 2, 3])
                    tl.media = media
                    return _wrap(tl)
                if kind == "paidmedia":
                    tl = _tl(mid)
                    media = _obj("TL_messageMediaPaidMedia")
                    media.stars_amount = 50
                    em = _sub("TL_messageExtendedMedia")
                    sub = _obj("TL_messageMediaDocument")
                    d = _obj("TL_document")
                    d.id = 321
                    d.size = 10
                    sub.document = d
                    em.media = sub
                    media.extended_media = _jlist([em])
                    tl.media = media
                    return _wrap(tl)
                if kind == "todo":
                    tl = _tl(mid)
                    # TL_messageMediaToDo.todo — это TLRPC.TodoList, элементы
                    # лежат в его поле list (ArrayList). Питоновский объект в
                    # ArrayList.add не пройдёт: java-мосту нужен объект,
                    # который он принимает. Даём java-класс, а поля — через
                    # _sub (класс может отсутствовать в сборке).
                    media = _obj("TL_messageMediaToDo")
                    # media.todo — это TLRPC.TodoList (а не TL_todo): подставлять
                    # чужой класс java-мост отказывается.
                    todo = _real("TodoList")
                    it = _real("TodoItem")
                    _safe_set(it, "title", "Пункт 1")
                    try:
                        todo.list = _jlist([it])
                    except Exception:
                        # java не принял элемент — оставляем пустой список:
                        # проверяем распознавание режима, а не наполнение
                        todo.list = _jlist()
                    todo.title = "Список"
                    media.todo = todo
                    tl.media = media
                    return _wrap(tl)
                if kind == "videostream":
                    tl = _tl(mid)
                    # media.call в TLRPC — это InputGroupCall, а не groupCall.
                    # Отдавать туда groupCall — ровно то, что даёт
                    # «Cannot convert TL_groupCall to TLRPC$InputGroupCall».
                    call = _sub("TL_inputGroupCall")
                    call.id = 888
                    call.access_hash = 0
                    media = _obj("TL_messageMediaVideoStream")
                    media.call = call
                    tl.media = media
                    return _wrap(tl)
                if kind == "combo":
                    tl = _tl(mid, text="Подпись")
                    ph = _obj("TL_photo")
                    ph.id = 777
                    media = _obj("TL_messageMediaPhoto")
                    media.photo = ph
                    tl.media = media
                    return _wrap(tl)
                if kind == "album":
                    tl = _tl(mid)
                    ph = _obj("TL_photo")
                    ph.id = 444
                    media = _obj("TL_messageMediaPhoto")
                    media.photo = ph
                    tl.media = media
                    tl.grouped_id = 12345
                    return _wrap(tl)
                raise AssertionError("net fabriki dlya tipa " + kind)

            # ---------- режимы ----------
            # (ключ режима, тип сообщения, ожидаемый префикс, компаньоны)
            _MODE_CASES = [
                ("link",         "link",         "L|",  ()),
                ("text",         "text",         "T|",  ()),
                ("photo",        "photo",        "P|",  ()),
                ("video",        "video",        "V|",  ()),
                ("gif",          "gif",          "G|",  ()),
                ("doc",          "doc",          "D|",  ()),
                ("audio",        "audio",        "A|",  ()),
                ("voice",        "voice",        "O|",  ()),
                ("sticker",      "sticker",      "S|",  ()),
                ("stickerset",   "stickerset",   "N|",  ()),
                ("premium",      "premium",      "X|",  ()),
                ("roundv",       "roundv",       "R|",  ()),
                ("poll",         "poll",         "Q|",  ()),
                ("quiz",         "quiz",         "VQ|", ()),
                ("webpage",      "webpage",      "W|",  ()),
                ("geo",          "geo",          "Z|",  ()),
                ("venue",        "venue",        "E|",  ()),
                ("contact",      "contact",      "K|",  ()),
                ("dice",         "dice",         "I|",  ()),
                ("game",         "game",         "J|",  ()),
                ("story",        "story",        "Y|",  ()),
                ("invoice",      "invoice",      "B|",  ()),
                ("giveaway",     "giveaway",     "Z2|", ()),
                ("giveawayres",  "giveawayres",  "Z3|", ()),
                ("paidmedia",    "paidmedia",    "Z4|", ()),
                ("todo",         "todo",         "Z5|", ()),
                ("videostream",  "videostream",  "Z6|", ()),
                ("combo",        "combo",        "C|",  ("photo",)),
            ]

            _MODE_SAVED = dict(_MODE)

            def _restore_modes():
                for k in _MODE:
                    _MODE[k] = _MODE_SAVED.get(k, True)

            def _only(on_key, companions=()):
                for k in _MODE:
                    _MODE[k] = (k == on_key) or (k in companions)

            def _mode_prefix_has(msg, prefix):
                for k in _all_keys(msg):
                    if k.startswith(prefix):
                        return k
                return None

            def mode_each(case):
                key, kind, prefix, comps = case

                def check():
                    msg = mk(kind)
                    # 1) включён ТОЛЬКО этот режим -> ключ его типа ЕСТЬ
                    _only(key, comps)
                    got = _mode_prefix_has(msg, prefix)
                    if not got:
                        raise AssertionError(
                            "rezhim vklyuchen, a klyucha %s net (keys=%s)"
                            % (prefix, [k[:12] for k in _all_keys(msg)]))
                    # 2) режим выключен, остальные вкл. -> ключа его типа НЕТ
                    _only("__none__")
                    for k in _MODE:
                        _MODE[k] = (k != key)
                    for c in comps:
                        _MODE[c] = True
                    got2 = _mode_prefix_has(msg, prefix)
                    if got2:
                        raise AssertionError(
                            "rezhim VYKLYUCHEN, a klyuch %s est: %s" % (prefix, got2[:20]))
                    return prefix + " vklyuchen/vyklyuchen ok"
                return check

            for _case in _MODE_CASES:
                t("режим: " + _case[0], mode_each(_case))

            # album: ключ A| строится в _apply_albums через _process
            def mode_album_gate():
                import os as _os, tempfile as _tf
                _orig_index_path = self._index_path
                saved = (dict(getattr(self, "_seen", {})),
                         list(getattr(self, "_dups", [])),
                         set(getattr(self, "_dup_ids", set())),
                         dict(getattr(self, "_album_groups", {})),
                         dict(getattr(self, "_album_ids", {})),
                         getattr(self, "_keep_oldest", False),
                         getattr(self, "_log_line", None),
                         getattr(self, "_review_stage", None),
                         getattr(self, "_persist_log", None),
                         getattr(self, "_refresh_progress", None),
                         getattr(self, "_account", None))
                try:
                    # _process в конце зовёт _finalize_scan -> _save_index:
                    # индекс обязан уйти во ВРЕМЕННУЮ папку, а не в файл юзера.
                    self._index_path = lambda: _os.path.join(_tf.mkdtemp(), "album.json")
                    self._log_line = lambda *a, **k: None
                    self._persist_log = lambda *a, **k: None
                    self._review_stage = lambda *a, **k: None
                    self._refresh_progress = lambda *a, **k: None
                    self._keep_oldest = False
                    if getattr(self, "_account", None) is None:
                        self._account = _acc
                    from java.util import ArrayList

                    def _album_msg(mid, gid, pid):
                        tl = _tl(mid)
                        ph = _obj("TL_photo")
                        ph.id = pid
                        media = _obj("TL_messageMediaPhoto")
                        media.photo = ph
                        tl.media = media
                        tl.grouped_id = gid
                        return tl

                    def _run(gid_a, gid_b):
                        self._seen = {}
                        self._dups = []
                        self._dup_ids = set()
                        self._key_ids = {}
                        self._key_hits = {}
                        self._msg_ids = set()
                        self._album_groups = {}
                        self._album_ids = {}
                        self._quick = False
                        self._index = None
                        self._index_keys = set()
                        self._scanned = 0
                        self._total = 0
                        self._total_logged = True
                        self._first_id = 0
                        self._last_msg_id = 0
                        self._kind_seen = {}
                        self._cancelled = False
                        self._index_dup_seen = set()
                        self._from_index_dups = 0
                        arr = ArrayList()
                        for mid, gid, pid in (
                                (5000, gid_a, 1), (4999, gid_a, 2),
                                (1000, gid_b, 1), (999, gid_b, 2)):
                            arr.add(_album_msg(mid, gid, pid))
                        resp = TLRPC.TL_messages_messagesSlice()
                        resp.messages = arr
                        resp.count = 4
                        self._process(resp, None)
                        return [k for k in self._seen if _is_album_key(k)]

                    _MODE["album"] = True
                    _MODE["photo"] = True
                    keys_on = _run(101, 202)
                    if not keys_on:
                        raise AssertionError("albom vklyuchen, a klyucha A| net")
                    _MODE["album"] = False
                    keys_off = _run(101, 202)
                    if keys_off:
                        raise AssertionError("albom vyklyuchen, a klyuch A| est: "
                                             + keys_off[0][:20])
                    return "A| vklyuchen/vyklyuchen ok"
                finally:
                    (self._seen, self._dups, self._dup_ids, self._album_groups,
                     self._album_ids, self._keep_oldest, self._log_line,
                     self._review_stage, self._persist_log,
                     self._refresh_progress, self._account) = saved
                    try:
                        del self._index_path     # вернуть настоящий метод
                    except Exception:
                        self._index_path = _orig_index_path
                    _restore_modes()

            t("режим: album", mode_album_gate)
            _restore_modes()

            # ---------- тумблеры: обработчик + атрибут + set_setting ----------
            _set_calls = []
            _real_set = self.set_setting

            def _spy_set(key, value, *a, **kw):
                _set_calls.append((key, value))
                return _real_set(key, value, *a, **kw)

            self.set_setting = _spy_set
            try:
                def _toggle_case(handler_name, set_key, read_attr):
                    def check():
                        h = getattr(self, handler_name)
                        for want in (True, False):
                            del _set_calls[:]
                            h(want)
                            after = read_attr()
                            if after != want:
                                raise AssertionError(
                                    "%s(%s): sostoyanie=%s, ozhidali %s"
                                    % (handler_name, want, after, want))
                            exp = 1 if want else 0
                            if (set_key, exp) not in _set_calls:
                                raise AssertionError(
                                    "%s(%s): set_setting(%r, %d) NE vyzvan (calls=%r)"
                                    % (handler_name, want, set_key, exp, _set_calls))
                        return "handler+attr+set_setting ok"
                    return check

                for _mk_, _sk_ in (
                        ("link", "mode_link"), ("text", "mode_text"),
                        ("photo", "mode_photo"), ("video", "mode_video"),
                        ("combo", "mode_combo"), ("album", "mode_album"),
                        ("gif", "mode_gif"), ("doc", "mode_doc"),
                        ("audio", "mode_audio"), ("voice", "mode_voice"),
                        ("sticker", "mode_sticker"), ("stickerset", "mode_stickerset"),
                        ("roundv", "mode_roundv"), ("poll", "mode_poll"),
                        ("quiz", "mode_quiz"), ("webpage", "mode_webpage"),
                        ("geo", "mode_geo"), ("venue", "mode_venue"),
                        ("contact", "mode_contact"), ("dice", "mode_dice"),
                        ("game", "mode_game"), ("story", "mode_story"),
                        ("invoice", "mode_invoice"), ("giveaway", "mode_giveaway"),
                        ("giveawayres", "mode_giveawayres"), ("paidmedia", "mode_paidmedia"),
                        ("todo", "mode_todo"), ("videostream", "mode_videostream"),
                        ("premium", "mode_premium")):
                    t("тумблер режима: " + _mk_,
                      _toggle_case("_on_mode_" + _mk_, _sk_,
                                   (lambda k=_mk_: lambda: bool(_MODE.get(k)))()))

                def _attr(name, default=None):
                    return lambda: getattr(self, name, default)

                t("тумблер: skip_short_text",
                  _toggle_case("_on_skip_short_change", "skip_short_text",
                               _attr("_skip_short")))
                t("тумблер: keep_oldest",
                  _toggle_case("_on_keep_oldest_change", "keep_oldest",
                               _attr("_keep_oldest")))
                t("тумблер: mode_trace",
                  _toggle_case("_on_mode_trace", "mode_trace",
                               _attr("_trace")))
                t("тумблер: mode_trace_verbose",
                  _toggle_case("_on_mode_trace_verbose", "mode_trace_verbose",
                               _attr("_verbose")))

                def quick_scan_toggle():
                    for want in (True, False):
                        del _set_calls[:]
                        self._on_quick_scan_change(want)
                        exp = 1 if want else 0
                        if ("quick_scan", exp) not in _set_calls:
                            raise AssertionError(
                                "_on_quick_scan_change(%s): set_setting('quick_scan', %d) "
                                "NE vyzvan (calls=%r)" % (want, exp, _set_calls))
                    return "set_setting('quick_scan') ok"
                t("тумблер: quick_scan", quick_scan_toggle)
            finally:
                self.set_setting = _real_set
            _restore_modes()

            # ---------- карточка настроек ----------
            def settings_items():
                items = self.create_settings()
                if not items:
                    raise AssertionError("create_settings() vernul pusto")
                sw_keys = {}
                texts = []
                for it in items:
                    k = getattr(it, "key", None)
                    if k:
                        sw_keys[k] = it
                    if getattr(it, "on_click", None) is not None:
                        texts.append(it)
                missing = [m for m in _MODE if ("mode_" + m) not in sw_keys]
                if missing:
                    raise AssertionError("v nastroykah net tumblerov dlya rezhimov: "
                                         + repr(missing))
                for req in ("skip_short_text", "quick_scan", "mode_trace",
                            "mode_trace_verbose", "keep_oldest"):
                    if req not in sw_keys:
                        raise AssertionError("v nastroykah net tumblera " + req)
                for k, it in sw_keys.items():
                    if not callable(getattr(it, "on_change", None)):
                        raise AssertionError("net on_change u tumblera " + k)
                for it in texts:
                    if not callable(getattr(it, "on_click", None)):
                        raise AssertionError("nekorrektnyy on_click u punkta")
                return "%d tумблеров, %d knopok" % (len(sw_keys), len(texts))

            t("карточка настроек: строки/тумблеры/кнопки", settings_items)

            def modes_registry():
                n = len(_MODE)
                if n != 29:
                    raise AssertionError("rezhimov v _MODE: %d, a dolzhno 29" % n)
                miss = [m for m in _MODE
                        if not callable(getattr(self, "_on_mode_" + m, None))]
                if miss:
                    raise AssertionError("net obrabotchika dlya rezhimov: " + repr(miss))
                return "29 rezhimov, u vseh est obrabotchik"
            t("29 режимов и их обработчики", modes_registry)

            # ---------- диалоги и кнопки ----------
            import ui.alert as _ui_alert
            import ui.bulletin as _ui_bulletin
            _real_alert_mod = _ui_alert.AlertDialogBuilder
            _real_bull_mod = _ui_bulletin.BulletinHelper
            _real_alert_g = globals().get("AlertDialogBuilder")
            _real_bull_g = globals().get("BulletinHelper")
            _real_ui_run = globals().get("run_on_ui_thread")
            _real_frag = globals().get("get_last_fragment")

            def _ui_run_strict(fn):
                # run_on_ui_thread из android_utils ГЛОТАЕТ исключения — тогда
                # проверка ничего бы не заметила. Здесь исключение пробрасываем.
                return fn()

            class _Rec(object):
                def __init__(self, *a, **k):
                    self._real = _real_alert_mod(*a, **k)
                    self.calls = []
                    self.shown = False
                def __getattr__(self, name):
                    def _call(*a, **k):
                        self.calls.append(name)
                        r = getattr(self._real, name)(*a, **k)
                        return self if (r is self._real or name in (
                            "set_title", "set_message", "set_positive_button",
                            "set_negative_button", "set_neutral_button",
                            "set_view", "set_items")) else r
                    return _call
                def show(self):
                    self.shown = True
                    self.calls.append("show")
                    return self

            try:
                _Rec.ALERT_TYPE_LOADING = _real_alert_mod.ALERT_TYPE_LOADING
            except Exception:
                _Rec.ALERT_TYPE_LOADING = 0
            try:
                _Rec.BUTTON_NEGATIVE = _real_alert_mod.BUTTON_NEGATIVE
                _Rec.BUTTON_POSITIVE = _real_alert_mod.BUTTON_POSITIVE
                _Rec.BUTTON_NEUTRAL = _real_alert_mod.BUTTON_NEUTRAL
            except Exception:
                _Rec.BUTTON_NEGATIVE = _Rec.BUTTON_POSITIVE = _Rec.BUTTON_NEUTRAL = 0

            class _BullRec(object):
                def __init__(self):
                    self.seen = []
                def show_info(self, t):
                    self.seen.append(("info", t)); return True
                def show_error(self, t):
                    self.seen.append(("error", t)); return True
                def show_success(self, t):
                    self.seen.append(("ok", t)); return True

            _fake_frag = type("_Frag", (), {
                "getParentActivity": staticmethod(lambda: object())})()

            _ui_alert.AlertDialogBuilder = _Rec
            _ui_bulletin.BulletinHelper = _BullRec()
            globals()["AlertDialogBuilder"] = _Rec
            globals()["BulletinHelper"] = _ui_bulletin.BulletinHelper
            globals()["run_on_ui_thread"] = _ui_run_strict
            globals()["get_last_fragment"] = lambda: _fake_frag
            try:
                def dialogs_imports():
                    from android.widget import CheckBox, LinearLayout, ScrollView, TextView
                    from android.os import Bundle
                    return "alert/bulletin/widget/Bundle"
                t("диалоги и виджеты (импорты)", dialogs_imports)

                def review_dialog():
                    saved = (getattr(self, "_dups", None), getattr(self, "_selected", None),
                             getattr(self, "_review", None), dict(getattr(self, "_kind_seen", {})),
                             getattr(self, "_msg_ids", None), getattr(self, "_total", 0),
                             getattr(self, "_scanned", 0), getattr(self, "_quick", False),
                             getattr(self, "_checkboxes", None))
                    built = None
                    try:
                        self._dups = [{"id": 1000, "kind": "text", "text": "a"},
                                      {"id": 3000, "kind": "text", "text": "a"}]
                        self._selected = {d["id"]: True for d in self._dups}
                        self._kind_seen = {"text": 2}
                        self._msg_ids = {1000, 3000, 5000}
                        self._total = 3
                        self._scanned = 3
                        self._quick = False
                        self._review = None
                        self._checkboxes = []
                        try:
                            self._build_review()
                        except Exception as _be:
                            self._last_build_exc = "%s: %s" % (type(_be).__name__, _be)
                            raise
                        built = self._review
                        n_checks = len(getattr(self, "_checkboxes", []))
                    finally:
                        (self._dups, self._selected, self._review, self._kind_seen,
                         self._msg_ids, self._total, self._scanned, self._quick,
                         self._checkboxes) = saved
                    if not isinstance(built, _Rec):
                        raise AssertionError("_build_review ne postroil dialog (%r)"
                                             % (getattr(self, "_last_build_exc", None),))
                    need = ("set_title", "set_negative_button", "set_positive_button", "show")
                    miss = [n for n in need if n not in built.calls]
                    if miss:
                        raise AssertionError("v okne dublei net: " + repr(miss))
                    if n_checks != 2:
                        raise AssertionError("chekboksov %d vmesto 2" % n_checks)
                    return "okno dubei: 2 stroki + Udaliт/Otmena + show()"
                t("окно дублей: кнопки и строки", review_dialog)

                def progress_dialog():
                    saved = (getattr(self, "_progress", "___M___"),
                             getattr(self, "_total", 0), getattr(self, "_scanned", 0),
                             getattr(self, "_dups", None), getattr(self, "_msg_ids", None),
                             getattr(self, "_page_no", 0), getattr(self, "_cancelled", False))
                    built = None
                    try:
                        self._progress = None
                        self._dups = []
                        self._msg_ids = set()
                        self._total = 100
                        self._scanned = 10
                        self._page_no = 1
                        self._cancelled = False
                        self._show_progress()
                        built = self._progress
                    finally:
                        if saved[0] != "___M___":
                            self._progress = saved[0]
                        self._total, self._scanned, self._dups = saved[1], saved[2], saved[3]
                        self._msg_ids, self._page_no, self._cancelled = saved[4], saved[5], saved[6]
                    if not isinstance(built, _Rec):
                        raise AssertionError("_show_progress ne postroil dialog")
                    if "set_negative_button" not in built.calls:
                        raise AssertionError("net knopki Otmena v okne progressa")
                    return "okno progressa: Otmena + show()"
                t("окно прогресса", progress_dialog)

                def about_dialog():
                    n_before = len(_ui_bulletin.BulletinHelper.seen)
                    self._on_about(None)
                    return None
                t("экран «О плагине»", about_dialog)

                def log_viewer():
                    self._log_line("[selftest] proverka loga")
                    txt = self._full_log_text()
                    if not txt:
                        raise AssertionError("_full_log_text pust")
                    self._on_show_log(None)
                    return "%d simvolov v loge" % len(_to_str("\n".join(txt)))
                t("просмотр лога", log_viewer)

                def log_copy_clear():
                    self._log_line("[selftest] dlya kopirovaniya")
                    self._log_line("[selftest] vtoraya stroka")
                    self._on_copy_log(None)
                    if not any(x[0] == "info" for x in _ui_bulletin.BulletinHelper.seen):
                        raise AssertionError("kopirovanie ne otchitalos")
                    n_before = len(getattr(self, "_log", []) or [])
                    self._on_clear_log(None)
                    n_after = len(getattr(self, "_log", []) or [])
                    if n_before and n_after:
                        raise AssertionError("ochistka loga ne ochistila (%d -> %d)"
                                             % (n_before, n_after))
                    return "kopirovanie/ochistka ok (%d -> %d)" % (n_before, n_after)
                t("лог: копировать и очистить", log_copy_clear)

                def cancel_button():
                    saved = (getattr(self, "is_processing", False),
                             getattr(self, "_cancelled", False),
                             getattr(self, "_progress", "___M___"),
                             getattr(self, "_log_line", None))
                    try:
                        self._log_line = lambda *a, **k: None
                        self._progress = None
                        self.is_processing = True
                        self._cancelled = False
                        self._cancel()
                        if not getattr(self, "_cancelled", False):
                            raise AssertionError("_cancel ne vystavil _cancelled")
                        if getattr(self, "is_processing", True):
                            raise AssertionError("_cancel ne snul is_processing")
                    finally:
                        self.is_processing, self._cancelled = saved[0], saved[1]
                        if saved[2] != "___M___":
                            self._progress = saved[2]
                        self._log_line = saved[3]
                    return "otmena: _cancelled=True, is_processing=False"
                t("кнопка Отмена", cancel_button)

                def settings_run_button():
                    started = []
                    orig = self._start_scan
                    try:
                        self._start_scan = lambda *a, **k: started.append(a)
                        self._on_settings_run(None)
                    finally:
                        self._start_scan = orig
                    if not started:
                        raise AssertionError("_on_settings_run ne zapustil skan")
                    if len(started[0]) != 2:
                        raise AssertionError("_start_scan(account, my_id) — argumenty: %r"
                                             % (started[0],))
                    return "zapusk iz kartochki: _start_scan(account, my_id)"
                t("кнопка «Найти дубликаты»", settings_run_button)
            finally:
                if _real_frag is not None:
                    globals()["get_last_fragment"] = _real_frag
                if _real_ui_run is not None:
                    globals()["run_on_ui_thread"] = _real_ui_run
                _ui_alert.AlertDialogBuilder = _real_alert_mod
                _ui_bulletin.BulletinHelper = _real_bull_mod
                if _real_alert_g is not None:
                    globals()["AlertDialogBuilder"] = _real_alert_g
                if _real_bull_g is not None:
                    globals()["BulletinHelper"] = _real_bull_g

            # ---------- keep_oldest в ОБЕ стороны ----------
            _PROC_ATTRS = ("_seen", "_dups", "_dup_ids", "_msg_ids", "_key_ids",
                           "_key_hits", "_quick", "_index", "_index_keys",
                           "_scan_complete", "_scanned", "_total", "_total_logged",
                           "_first_id", "_last_msg_id", "_kind_seen", "_keep_oldest",
                           "_cancelled", "_index_dup_seen", "_from_index_dups",
                           "_account", "_album_groups", "_album_ids",
                           "_review_stage", "_persist_log", "_refresh_progress")

            def _proc_state():
                return dict((n, getattr(self, n, "___M___")) for n in _PROC_ATTRS)

            def _proc_restore(st):
                for n, v in st.items():
                    if v == "___M___":
                        try:
                            delattr(self, n)
                        except Exception:
                            pass
                    else:
                        try:
                            setattr(self, n, v)
                        except Exception:
                            pass

            def _clean_proc():
                self._seen = {}
                self._dups = []
                self._dup_ids = set()
                self._msg_ids = set()
                self._key_ids = {}
                self._key_hits = {}
                self._quick = False
                self._index = None
                self._index_keys = set()
                self._scan_complete = False
                self._scanned = 0
                self._total = 0
                self._total_logged = True
                self._first_id = 0
                self._last_msg_id = 0
                self._kind_seen = {}
                self._cancelled = False
                self._index_dup_seen = set()
                self._from_index_dups = 0
                self._album_groups = {}
                self._album_ids = {}
                self._review_stage = lambda *a, **k: None
                self._persist_log = lambda *a, **k: None
                self._refresh_progress = lambda *a, **k: None

            def keep_oldest_both():
                import os as _os, tempfile as _tf
                _orig_path = self._index_path
                st = _proc_state()
                try:
                    self._index_path = lambda: _os.path.join(_tf.mkdtemp(), "k.json")
                    if getattr(self, "_account", None) is None:
                        self._account = _acc

                    def _run(keep_oldest):
                        _clean_proc()
                        self._keep_oldest = keep_oldest
                        from java.util import ArrayList
                        arr = ArrayList()
                        arr.add(_tl(5000, "Дубль"))   # свежее
                        arr.add(_tl(1000, "Дубль"))   # старее
                        resp = TLRPC.TL_messages_messagesSlice()
                        resp.messages = arr
                        resp.count = 2
                        self._process(resp, None)
                        key = "T|" + _md5(_text_norm("Дубль"))
                        return _safe_int(self._seen.get(key)), \
                            sorted(_safe_int(d["id"]) for d in self._dups)

                    kept_new, drop_new = _run(False)
                    if kept_new != 5000:
                        raise AssertionError("keep_newest: ostalsya %d, zhdali 5000" % kept_new)
                    if drop_new != [1000]:
                        raise AssertionError("keep_newest: udalit %r, zhdali [1000]" % (drop_new,))
                    kept_old, drop_old = _run(True)
                    if kept_old != 1000:
                        raise AssertionError("keep_oldest: ostalsya %d, zhdali 1000" % kept_old)
                    if drop_old != [5000]:
                        raise AssertionError("keep_oldest: udalit %r, zhdali [5000]" % (drop_old,))
                    return "svezhee=%d, starое=%d" % (kept_new, kept_old)
                finally:
                    self._index_path = _orig_path
                    _proc_restore(st)
                    _restore_modes()

            t("keep_oldest: свежее и старое (обе стороны)", keep_oldest_both)

            # ---------- прочие прочные проверки ----------
            def live_keys():
                s1 = set(_all_keys(live("Я")))
                s2 = set(_all_keys(live("я")))
                s3 = set(_all_keys(live("Я ")))
                if not s1:
                    raise AssertionError("tekst ne dal ni odnogo klucha")
                if not (s1 == s2 == s3):
                    raise AssertionError("registr/probel lomaut kluch")
                if _all_keys(live("")):
                    raise AssertionError("pustoy tekst dal kluch")
                return "kluch stabilen, pustoe bez klucha"
            t("ключи на живых объектах", live_keys)

            def live_dupes():
                a = set(_all_keys(live("Дубль", 100)))
                b = set(_all_keys(live("Дубль", 200)))
                c = set(_all_keys(live("Другое", 300)))
                if not (a & b):
                    raise AssertionError("odinakovyy tekst NE dal obschiy kluch")
                if a & c:
                    raise AssertionError("raznyy tekst dal obschiy kluch")
                return "dubl naiden, lozhnogo net"
            t("дубли на живых объектах", live_dupes)

            def java_types():
                from java.lang import Integer
                from java.util import ArrayList
                if _safe_int(Integer(42)) != 42:
                    raise AssertionError("_safe_int na java.lang.Integer sloman")
                lst = ArrayList()
                for v in (1, 2, 3):
                    lst.add(Integer(v))
                if self._java_size(lst) != 3:
                    raise AssertionError("_java_size sloman")
                if len(_iter_java(lst)) != 3:
                    raise AssertionError("_iter_java sloman")
                return "Integer/ArrayList chitayutsya"
            t("java-типы", java_types)

            def index_rt():
                import os as _os, tempfile as _tf
                real_path = self._index_path
                tmp = _os.path.join(_tf.mkdtemp(), "selftest_index.json")
                saved = (getattr(self, "_seen", None), getattr(self, "_key_ids", None),
                         getattr(self, "_msg_ids", None), getattr(self, "_quick", None),
                         getattr(self, "_index", None), getattr(self, "_scan_complete", None),
                         getattr(self, "_index_dup_seen", None), getattr(self, "_from_index_dups", None))
                try:
                    self._index_path = lambda: tmp
                    self._seen = {"T|selftest": 999, "T|two": 500}
                    self._key_ids = {"T|selftest": {111, 999}, "T|two": {500}}
                    self._msg_ids = {111, 999, 500}
                    self._quick = False
                    self._index = None
                    self._scan_complete = True
                    self._index_dup_seen = set()
                    self._from_index_dups = 0
                    self._save_index(999)
                    if not _os.path.exists(tmp):
                        raise AssertionError("fayl indeksa ne sozdan")
                    self._index = None
                    data = self._load_index()
                    if not data:
                        raise AssertionError("index ne chitaetsya obratno")
                    v = (data.get("keys") or {}).get("T|selftest")
                    if not isinstance(v, list) or set(v) != {111, 999}:
                        raise AssertionError("v indekse ne vse id: " + repr(v))
                    if not data.get("complete"):
                        raise AssertionError("complete ne vystavilsja")
                    res = "v=" + str(data.get("v")) + " complete=" + str(data.get("complete"))
                finally:
                    self._index_path = real_path
                    (self._seen, self._key_ids, self._msg_ids, self._quick,
                     self._index, self._scan_complete,
                     self._index_dup_seen, self._from_index_dups) = saved
                    try:
                        _os.remove(tmp)
                    except Exception:
                        pass
                return res
            t("индекс: запись/чтение", index_rt)

            t("снятие id из индекса",
              lambda: (self._drop_ids_from_index([1]), "vychischeno bez oshibok")[1])

            def text_fmt():
                from java.lang import String
                if _to_str("stroka") != "stroka":
                    raise AssertionError("_to_str na str sloman")
                if _to_str(None) != "":
                    raise AssertionError("_to_str(None) dolzhen byt pustym")
                if _to_str(String("java")) != "java":
                    raise AssertionError("_to_str na CharSequence sloman")
                return "str/None/CharSequence"
            t("приведение строк", text_fmt)

            def log_rt():
                self._log_line("[selftest] proverka")
                txt = self._full_log_text()
                if not txt:
                    raise AssertionError("log pust")
                return "%d zapisey" % len(txt)
            t("лог", log_rt)

            def index_real_path():
                """Индекс по РЕАЛЬНОМУ пути (как в бою), но БЕЗ записи в файл
                пользователя: подменяем только имя файла в реальной папке и
                дополнительно убеждаемся, что настоящий индекс не изменился."""
                import os as _os
                real = self._index_path()
                probe = real + ".selftest_tmp"
                backup = None
                if _os.path.exists(real):
                    with open(real, "r", encoding="utf-8") as f:
                        backup = f.read()
                saved = (getattr(self, "_seen", None), getattr(self, "_key_ids", None),
                         getattr(self, "_msg_ids", None), getattr(self, "_quick", None),
                         getattr(self, "_index", None), getattr(self, "_scan_complete", None),
                         getattr(self, "_index_dup_seen", None), getattr(self, "_from_index_dups", None))
                try:
                    self._index_path = lambda: probe
                    self._seen = {"T|selftest_rt": 999}
                    self._key_ids = {"T|selftest_rt": {999}}
                    self._msg_ids = {999}
                    self._quick = False
                    self._index = None
                    self._scan_complete = True
                    self._index_dup_seen = set()
                    self._from_index_dups = 0
                    self._save_index(999)
                    if not _os.path.exists(probe):
                        raise AssertionError("fayl ne sozdan po realnomu puti")
                    self._index = None
                    d = self._load_index()
                    if not d:
                        raise AssertionError("ne chitaetsya po realnomu puti")
                    v = (d.get("keys") or {}).get("T|selftest_rt")
                    if v != 999:
                        raise AssertionError("klyuch ne sovpal: " + repr(v))
                    return "put: " + _os.path.basename(real)
                finally:
                    (self._seen, self._key_ids, self._msg_ids, self._quick,
                     self._index, self._scan_complete,
                     self._index_dup_seen, self._from_index_dups) = saved
                    try:
                        del self._index_path        # вернуть настоящий метод
                    except Exception:
                        pass
                    try:
                        if _os.path.exists(probe):
                            _os.remove(probe)
                    except Exception:
                        pass
                    # реальный индекс пользователя обязан остаться прежним
                    now = None
                    if _os.path.exists(real):
                        with open(real, "r", encoding="utf-8") as f:
                            now = f.read()
                    if now != backup:
                        raise AssertionError("samoтест IZMENIL realnyy indeks polzovatelya")
            t("индекс по РЕАЛЬНОМУ пути", index_real_path)

            def cancel_no_save():
                import os as _os, tempfile as _tf
                _orig = self._index_path
                real = _os.path.join(_tf.mkdtemp(), "cancel.json")
                saved = _proc_state()
                try:
                    self._index_path = lambda: real
                    _clean_proc()
                    self._persist_log = lambda *a, **k: None
                    self._cancelled = True
                    self._scan_complete = False
                    self._first_id = 12345
                    self._finalize_scan()
                    if _os.path.exists(real):
                        raise AssertionError("otmenennyy progon SOZDAL indeks")
                    return "otmena indeks ne trogaet"
                finally:
                    self._index_path = _orig
                    _proc_restore(saved)
            t("отмена не пишет индекс", cancel_no_save)

            def full_process_cycle():
                import os as _os, tempfile as _tf
                real_path = self._index_path
                tmp = _os.path.join(_tf.mkdtemp(), "cycle.json")
                st = _proc_state()
                try:
                    self._index_path = lambda: tmp
                    if getattr(self, "_account", None) is None:
                        self._account = _acc
                    _clean_proc()
                    self._keep_oldest = False
                    from java.util import ArrayList
                    arr = ArrayList()
                    for tlx in (_tl(5000, "Я"), _tl(4500, "Мы"),
                                _tl(3000, "Я"), _tl(1000, "Я")):
                        arr.add(tlx)
                    resp = TLRPC.TL_messages_messagesSlice()
                    resp.messages = arr
                    resp.count = 4
                    _cap = []
                    _orig_log = self._log_line

                    def _cap_log(s):
                        _cap.append(str(s))
                        try:
                            _orig_log(str(s))
                        except Exception:
                            pass
                    self._log_line = _cap_log
                    try:
                        self._process(resp, None)
                    finally:
                        self._log_line = _orig_log

                    if self._scanned != 4:
                        _why = [x for x in _cap if ("warn" in x or "skip" in x
                                                    or x.startswith("EXC"))]
                        raise AssertionError(
                            "prochitano %d vmesto 4; log: %s"
                            % (self._scanned, " | ".join(_why[:3]) or "(log pust)"))
                    if len(self._dups) != 2:
                        raise AssertionError("dublov %d vmesto 2 (log: %s)"
                                             % (len(self._dups), " | ".join(_cap[-3:])))
                    drop = sorted(_safe_int(d["id"]) for d in self._dups)
                    if drop != [1000, 3000]:
                        raise AssertionError("udalyayutsya %r, a nuzhno [1000, 3000]" % (drop,))
                    kept = self._seen.get("T|" + _md5(_text_norm("Я")))
                    if _safe_int(kept) != 5000:
                        raise AssertionError("ostalsya ne svezhiy id: " + repr(kept))
                    return "prochitano=4 dublei=2 ostalos=5000"
                finally:
                    self._index_path = real_path
                    _proc_restore(st)
                    _restore_modes()
                    try:
                        _os.remove(tmp)
                    except Exception:
                        pass
            t("ПОЛНЫЙ ЦИКЛ _process (живые TLRPC)", full_process_cycle)

            def save_after_delete_top():
                import os as _os, json as _json, tempfile as _tf
                _orig = self._index_path
                tmp = _os.path.join(_tf.mkdtemp(), "afterdel.json")
                saved = (getattr(self, "_seen", None), getattr(self, "_key_ids", None),
                         getattr(self, "_msg_ids", None), getattr(self, "_quick", None),
                         getattr(self, "_index", None), getattr(self, "_scan_complete", None),
                         getattr(self, "_first_id", None), getattr(self, "_index_dup_seen", None),
                         getattr(self, "_from_index_dups", None), getattr(self, "_total", 0))
                try:
                    self._index_path = lambda: tmp
                    self._seen = {"T|keep": 139013}
                    self._key_ids = {"T|keep": {139013}}
                    self._msg_ids = {139013}
                    self._quick = True
                    self._index = None
                    self._scan_complete = True
                    self._index_dup_seen = set()
                    self._from_index_dups = 0
                    self._first_id = 139013
                    self._save_index(139013, complete=True)
                    with open(tmp, "r", encoding="utf-8") as f:
                        raw = _json.load(f)
                    if _safe_int(raw.get("top_id")) != 139013:
                        raise AssertionError("top_id=" + repr(raw.get("top_id")))
                    return "top_id sohranen: " + str(raw.get("top_id"))
                finally:
                    self._index_path = _orig
                    (self._seen, self._key_ids, self._msg_ids, self._quick,
                     self._index, self._scan_complete, self._first_id,
                     self._index_dup_seen, self._from_index_dups,
                     self._total) = saved
                    try:
                        _os.remove(tmp)
                    except Exception:
                        pass
            t("top_id не обнуляется после удаления", save_after_delete_top)

            def only_saved_support():
                saved = getattr(self, "_my_id", None)
                try:
                    self._my_id = 4242
                    p1 = self._self_input_peer(0)
                    if p1 is None:
                        raise AssertionError("_self_input_peer vernul None")
                    _nm = type(p1).__name__
                    if "inputPeerSelf" not in _nm:
                        raise AssertionError("peer ne inputPeerSelf: " + _nm)
                    return "tolko Izbranное: peer=" + _nm
                finally:
                    if saved is not None:
                        self._my_id = saved
            t("работа только с Избранным (peer)", only_saved_support)

            def rejects_foreign_chat():
                started = []
                orig = self._start_scan
                saved_log = getattr(self, "_log_line", None)
                try:
                    self._log_line = lambda *a, **k: None
                    self._start_scan = lambda *a, **k: started.append(a)
                    self._on_menu_click_inner({"account": 0,
                                               "dialog_id": -1001234567890})
                    if started:
                        raise AssertionError("v chuzhom chate START poshel")
                    self._on_menu_click_inner({"account": 0})
                    if not started:
                        raise AssertionError("v menu START ne poshel")
                    return "chuzhoy chat -> otkaz, menu -> start"
                finally:
                    self._start_scan = orig
                    self._log_line = saved_log
            t("чужой чат отказывает", rejects_foreign_chat)

            def quick_request_shape():
                saved = dict((n, getattr(self, n, "___M___"))
                             for n in ("_scan_from", "_last_msg_id", "_account",
                                       "_cancelled", "_page_no", "_retrying",
                                       "_persist_log", "_first_id", "_log_line"))
                sent = {}

                def fake_send(req, cb, account=0):
                    for f in ("offset_id", "add_offset", "min_id", "limit", "max_id"):
                        sent[f] = getattr(req, f, None)
                    return 1
                _orig_send = globals().get("send_request")
                try:
                    self._account = 0
                    self._cancelled = False
                    self._page_no = 1
                    self._retrying = False
                    self._first_id = 0
                    self._persist_log = lambda: None
                    self._log_line = lambda *a, **k: None
                    self._scan_from = 139017
                    self._last_msg_id = 0
                    globals()["send_request"] = fake_send
                    self._scan_page()
                finally:
                    if _orig_send is not None:
                        globals()["send_request"] = _orig_send
                    for n, v in saved.items():
                        if v == "___M___":
                            try:
                                delattr(self, n)
                            except Exception:
                                pass
                        else:
                            try:
                                setattr(self, n, v)
                            except Exception:
                                pass
                oid = _safe_int(sent.get("offset_id"))
                aof = _safe_int(sent.get("add_offset"))
                if oid != 139017:
                    raise AssertionError("offset_id=%s, nuzhno 139017" % oid)
                if aof != -PAGE_SIZE:
                    raise AssertionError("add_offset=%s, nuzhno %d" % (aof, -PAGE_SIZE))
                if _safe_int(sent.get("min_id")) != 139017:
                    raise AssertionError("min_id=%s" % sent.get("min_id"))
                return "bystryy skan: offset_id=top_id, add_offset=-%d" % PAGE_SIZE
            t("быстрый скан тянет НОВЫЕ (запрос)", quick_request_shape)

            def quick_zero_verdict():
                saved = dict((n, getattr(self, n, "___M___"))
                             for n in ("_last_new_id", "_scan_from", "_log_line"))
                logs = []
                try:
                    self._log_line = lambda s: logs.append(str(s))
                    self._scan_from = 139017
                    self._last_new_id = 139013
                    v1 = self._quick_zero_verdict()
                    if v1 != "none":
                        raise AssertionError("ozhidali 'none', poluchili %r" % (v1,))
                    self._last_new_id = 139100
                    v2 = self._quick_zero_verdict()
                    if v2 != "missed":
                        raise AssertionError("ozhidali 'missed', poluchili %r" % (v2,))
                    if not any("потеря" in x for x in logs):
                        raise AssertionError("net zapisi o potere v loge")
                    return "0 novyh: 'net' i 'poteryali' razlichayutsya"
                finally:
                    for n, v in saved.items():
                        if v == "___M___":
                            try:
