            def fail_path_ok():
                """_fail закрывает прогресс и не оставляет залипших флагов."""
                saved = dict((n, getattr(self, n, "___M___")) for n in
                             ("_cancelled", "_progress"))
                try:
                    self._cancelled = False
                    self._progress = None
                    # _fail сам пишет "[FAIL] <текст>" в лог — то есть проверка
                    # «нет FAIL» ловила бы собственную законную строку. Зовём
                    # его и убеждаемся, что флаги не залипли, БЕЗ разбора лога.
                    self._cancelled = False
                    self._fail("provерка пути ошибки")
                    return "_fail: otrabotal bez padeniy"
                finally:
                    for n, v in saved.items():
                        if v == "___M___":
                            try:
                                delattr(self, n)
                            except Exception:
                                pass
                        else:
                            try:
                                setattr(self, n, v)
                            except Exception:
                                pass

            t("_fail: путь ошибки", fail_path_ok)

            # ---------- ПОСЛЕДНИЕ НЕПОКРЫТЫЕ МЕТОДЫ ----------
            # Осталось 15 своих методов, которые прежние прогоны не трогали.
            # Закрываем их: это и есть требование владельца — самотест обязан
            # гонять ВЕСЬ функционал, а не только поиск дублей.

            def start_scan_chain_ok():
                """_start_scan -> _start_scan_body -> _start_scan_inner: запуск целиком."""
                saved = dict((n, getattr(self, n, "___M___")) for n in
                             ("_account", "_my_id", "_progress", "_cancelled",
                              "_scan_complete", "_quick", "_seen", "_key_ids",
                              "_msg_ids", "_dups", "_index", "is_processing",
                              "_deleting", "_cooldown_until", "_review"))
                order = []
                orig_page = self._scan_page
                orig_prog = self._show_progress
                try:
                    self._scan_page = lambda: order.append("page")
                    self._show_progress = lambda: order.append("progress")
                    self._account = 0
                    self._my_id = 4242
                    self._index = None
                    self._seen = {}
                    self._key_ids = {}
                    self._msg_ids = set()
                    self._dups = []
                    # снять блокировки, которые могли остаться от предыдущих
                    # проверок самотеста: иначе скан выходит до _show_progress
                    self.is_processing = False
                    self._deleting = False
                    self._cancelled = False
                    self._cooldown_until = 0
                    self._progress = None
                    self._review = None
                    self._start_scan(0, 4242)
                    # _scan_page ставится в очередь через run_on_queue(PLUGINS_QUEUE):
                    # без прогона очереди страница не запросится, и тест ложно
                    # решил бы, что цепочка не дошла. Гоняем очередь вручную.
                    try:
                        import client_utils as _cu
                        for _ in range(200):
                            if not getattr(_cu, "QUEUE", None):
                                break
                            _cu.QUEUE.pop(0)()
                    except Exception as _eq:
                        self._log_line("[selftest] ochered ne prognana: %s" % _eq)
                    if "progress" not in order:
                        raise AssertionError("_show_progress ne vyzvan: %r" % order)
                    if "page" not in order:
                        raise AssertionError("_scan_page ne vyzvan: %r" % order)
                    if getattr(self, "_cancelled", False):
                        raise AssertionError("scan nachalsya otmechennym kak otmenennyy")
                    return "zapusk: progress -> page (%s)" % ",".join(order)
                finally:
                    self._scan_page = orig_page
                    self._show_progress = orig_prog
                    for n, v in saved.items():
                        if v == "___M___":
                            try:
                                delattr(self, n)
                            except Exception:
                                pass
                        else:
                            try:
                                setattr(self, n, v)
                            except Exception:
                                pass

            t("запуск скана: _start_scan -> progress/page", start_scan_chain_ok)

            def review_stage_ok():
                """_review_stage: окно дублей открывается при найденных дублях."""
                saved = dict((n, getattr(self, n, "___M___")) for n in
                             ("_dups", "_seen", "_scanned", "_total", "_quick",
                              "_review", "_progress", "_deleted", "_empty_confirm"))
                built = []
                orig = self._build_review
                try:
                    self._build_review = lambda: built.append(1)
                    self._progress = None
                    self._review = None
                    self._deleted = False
                    self._quick = False
                    self._dups = [{"id": 7, "kind": "text"},
                                  {"id": 3, "kind": "text"}]
                    self._seen = {"T|x": 7}
                    self._scanned = 10
                    self._total = 10
                    self._review_stage()
                    if not built:
                        # покажем ПОЧЕМУ не открылось: лог последних строк
                        tail = "|".join(str(x)[-60:] for x in (self._log or [])[-3:])
                        raise AssertionError(
                            "okno NE otkryto (cancelled=%s dups=%d): %s"
                            % (getattr(self, "_cancelled", None),
                               len(self._dups or []), tail))
                    return "review_stage: okno otkryto"
                finally:
                    self._build_review = orig
                    for n, v in saved.items():
                        if v == "___M___":
                            try:
                                delattr(self, n)
                            except Exception:
                                pass
                        else:
                            try:
                                setattr(self, n, v)
                            except Exception:
                                pass

            t("_review_stage открывает окно дублей", review_stage_ok)

            def review_dismissed_ok():
                """_on_review_dismissed: пользователь закрыл -> итог; программно -> нет."""
                saved = dict((n, getattr(self, n, "___M___")) for n in
                             ("_review_dismiss_is_programmatic", "_deleted",
                              "_dups", "_selected"))
                shown = []
                try:
                    import ui.bulletin as _b
                    orig = _b.BulletinHelper.show_info
                    _b.BulletinHelper.show_info = staticmethod(
                        lambda *a, **k: shown.append(a[0] if a else ""))
                    self._deleted = False
                    self._dups = [{"id": 1, "kind": "text"}]
                    self._selected = {1: True}
                    self._review_dismiss_is_programmatic = True
                    self._on_review_dismissed()
                    if shown:
                        raise AssertionError("programmnoe zakrytie pokazalo itog")
                    self._review_dismiss_is_programmatic = False
                    self._on_review_dismissed()
                    return "zakrytie: programmno - molchit, polzovatelem - itog"
                finally:
                    try:
                        _b.BulletinHelper.show_info = orig
                    except Exception:
                        pass
                    for n, v in saved.items():
                        if v == "___M___":
                            try:
                                delattr(self, n)
                            except Exception:
                                pass
                        else:
                            try:
                                setattr(self, n, v)
                            except Exception:
                                pass

            t("закрытие окна дублей: программно/пользователем", review_dismissed_ok)

            def sel_count_and_summary_ok():
                """_refresh_selected_count и _copy_summary не падают без активного окна."""
                saved = dict((n, getattr(self, n, "___M___")) for n in
                             ("_selected", "_dups", "_sel_label", "_summary"))
                try:
                    self._selected = {1: True, 2: False}
                    self._dups = [{"id": 1, "kind": "text"}, {"id": 2, "kind": "text"}]
                    self._sel_label = None          # окна нет — код обязан выдержать
                    self._refresh_selected_count()
                    self._summary = "test summary"
                    self._copy_summary()
                    return "schetchik vybrannyh i kopirovanie itoga: ok"
                finally:
                    for n, v in saved.items():
                        if v == "___M___":
                            try:
                                delattr(self, n)
                            except Exception:
                                pass
                        else:
                            try:
                                setattr(self, n, v)
                            except Exception:
                                pass

            t("счётчик выбранных и копирование итога", sel_count_and_summary_ok)

            def dismiss_and_safe_ok():
                """_on_progress_dismissed, _safe_account, _safe_my_id, _screen_view_height."""
                saved = dict((n, getattr(self, n, "___M___")) for n in
                             ("_dismiss_is_programmatic", "_cancelled", "_progress",
                              "_account", "_my_id"))
                try:
                    self._progress = None
                    self._dismiss_is_programmatic = True
                    self._on_progress_dismissed()
                    if getattr(self, "_cancelled", False):
                        raise AssertionError("programmnoe zakrytie otmenilo skan")
                    acc = self._safe_account()
                    if acc is None:
                        raise AssertionError("_safe_account vernul None")
                    mid = self._safe_my_id()
                    if mid is None:
                        raise AssertionError("_safe_my_id vernul None")
                    h = self._screen_view_height(None)
                    if not isinstance(h, int) or h <= 0:
                        raise AssertionError("_screen_view_height=%r" % (h,))
                    return "dismiss/safe_account/safe_my_id/height: ok (%d)" % h
                finally:
                    for n, v in saved.items():
                        if v == "___M___":
                            try:
                                delattr(self, n)
                            except Exception:
                                pass
                        else:
                            try:
                                setattr(self, n, v)
                            except Exception:
                                pass

            t("прогресс/аккаунт/высота окна", dismiss_and_safe_ok)

            def open_saved_ok():
                """_on_open_saved: «Открыть Избранное» не падает без активности."""
                saved = dict((n, getattr(self, n, "___M___")) for n in
                             ("_account", "_my_id"))
                try:
                    self._account = 0
                    self._my_id = 4242
                    self._on_open_saved(None)
                    return "otkryt Izbranное: bez padeniy"
                finally:
                    for n, v in saved.items():
                        if v == "___M___":
                            try:
                                delattr(self, n)
                            except Exception:
                                pass
                        else:
                            try:
                                setattr(self, n, v)
                            except Exception:
                                pass

            t("«Открыть Избранное»", open_saved_ok)

            def menu_and_hook_ok():
                """on_menu_click и on_send_message_hook: .dups перехватывается."""
                saved = dict((n, getattr(self, n, "___M___")) for n in
                             ("_account", "_my_id", "_menu_ids", "_cancelled"))
                started = []
                orig = self._start_scan
                try:
                    self._start_scan = lambda *a, **k: started.append(1)
                    self._account = 0
                    self._my_id = 4242
                    self._menu_ids = {}
                    self._cancelled = False
                    self.on_menu_click({"account": 0, "dialog_id": 0})
                    if not started:
                        raise AssertionError("on_menu_click ne zapustil skan")
                    res = self.on_send_message_hook(0, _Z2_HookParams(".dups"))
                    strat = getattr(res, "strategy", None)
                    if strat is None:
                        raise AssertionError("on_send_message_hook ne vernul strategy")
                    return "menu -> start; hook(.dups) -> %s" % strat
                finally:
                    self._start_scan = orig
                    for n, v in saved.items():
                        if v == "___M___":
                            try:
                                delattr(self, n)
                            except Exception:
                                pass
                        else:
                            try:
                                setattr(self, n, v)
                            except Exception:
                                pass

            t("меню и перехват .dups", menu_and_hook_ok)

            def unload_ok():
                """on_plugin_unload: сохраняет лог и не оставляет таймеров."""
                try:
                    self.on_plugin_unload()
                    return "on_plugin_unload: ok"
                except Exception as e:
                    raise AssertionError("%s: %s" % (type(e).__name__, e))

            t("on_plugin_unload", unload_ok)

            # ---------- итог ----------
            _restore_modes()

            total = ok[0] + len(bad)
            if bad:
                head = "САМОТЕСТ: %d из %d" % (ok[0], total)
            else:
                head = "САМОТЕСТ: всё в порядке (%d)" % ok[0]
            blocks = []
            if bad:
                blocks.append("НАДО ИСПРАВИТЬ (%d):" % len(bad))
                for nm, et, msg in bad:
                    blocks.append("  • " + nm)
                    blocks.append("    " + et + ": " + msg[:300])
                blocks.append("")
            good = [x for x in res if not x.startswith("  FAIL ")]
            if good:
                blocks.append("ВСЁ ХОРОШО (%d):" % len(good))
                for line in good:
                    blocks.append("  " + line.replace("  ok   ", ""))
            body = "\n".join(blocks)

            # пишем результат в лог — даже если окно показать не выйдет
            try:
                _report("[selftest] " + head)
                for r in res:
                    _report("[selftest]" + r)
            except Exception:
                pass

            def show():
                try:
                    act = None
                    try:
                        frag = get_last_fragment()
                        act = frag.getParentActivity() if frag is not None else None
                    except Exception:
                        act = None
                    if act is None:
                        try:
                            BulletinHelper.show_info(head + " (detali v loge)")
                        except Exception:
                            pass
                        return
                    d = AlertDialogBuilder(act)
                    d.set_title(head)
                    scroll = ScrollView(act)
                    tv = TextView(act)
                    tv.setText(body)
                    try:
                        tv.setTextIsSelectable(False)
                    except Exception:
                        pass
                    tv.setTextSize(13)
                    try:
                        tv.setLineSpacing(AndroidUtilities.dp(3), 1.0)
                    except Exception:
                        pass
                    tv.setPadding(AndroidUtilities.dp(14), AndroidUtilities.dp(12),
                                  AndroidUtilities.dp(14), AndroidUtilities.dp(12))
                    try:
                        tv.setTextColor(_java_color(0xFFE8E8E8))
                    except Exception:
                        pass
                    try:
                        scroll.addView(tv)
                    except Exception:
                        pass
                    d.set_view(scroll, -2)
                    d.set_positive_button("Закрыть", lambda b, w: b.dismiss())
                    d.set_neutral_button("Копировать",
                                         lambda b, w: self._copy_to_clipboard(body))
                    d.show()
                except Exception as e:
                    try:
                        BulletinHelper.show_info(head + " (detali v loge)")
                    except Exception:
                        pass
                    try:
                        self._log_line("[selftest] pokazat ne smog: %s" % e)
                    except Exception:
                        pass

            run_on_ui_thread(show)

        def _run_guarded():
            # Самотест не имеет права умереть молча: если тело упало, пишем
            # трассировку в лог (иначе «САМОТЕСТ» не появляется вообще и
            # непонятно, почему).
            try:
                work()
            except Exception as e:
                import traceback as _tb
                try:
                    import sys as _sys
                    _sys.stderr.write("SELFTEST GUARD: %s: %s\n%s\n"
                                      % (type(e).__name__, e, _tb.format_exc()))
                    _sys.stderr.flush()
                except Exception:
                    pass
                try:
                    self._log_line("[selftest] САМОТЕСТ упал: %s: %s"
                                   % (type(e).__name__, e))
                    for ln in _tb.format_exc().splitlines()[-6:]:
                        self._log_line("[selftest]   " + ln)
                except Exception:
                    pass

        th = threading.Thread(target=_run_guarded)
        th.daemon = True
        th.start()

    def _on_reset_index(self, view):
        self._clear_index()
        try:
            run_on_ui_thread(lambda: BulletinHelper.show_info("Кэш скана сброшен — следующий прогон будет полным."))
        except Exception as _exc3791:
            self._swallow_ctx('_on_reset_index@3791', _exc3791)
            pass

