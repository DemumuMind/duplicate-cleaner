PAGE_SIZE = 100

# Сколько строк лога держим в памяти и сколько символов показываем в окне.
# 5000 строк при подробном трейсе вытеснялись за один скан (только вход в
# _dup_key на 6700 сообщениях даёт 6700 строк), и начало прогона терялось.
MAX_LOG_LINES = 50000
# Шаг батч-обрезки кольцевого буфера лога. Резать del _log[:1] на каждой
# строке сверх потолка — это O(n) на строку (O(n^2) в сумме). Копим
# переполнение до этого шага и обрезаем пачкой: буфер остаётся в пределах
# [MAX_LOG_LINES, MAX_LOG_LINES + _LOG_TRIM_STEP), то есть «последние 50000
# строк» выполняются с точностью до шага, а стоимость амортизируется.
_LOG_TRIM_STEP = 1000
# Ограничение TextView: десятки тысяч символов Android не отрисовывает.
# Показываем ТОЛЬКО ХВОСТ в LOG_SHOW_CHARS символов (полный текст остаётся
# в памяти и уходит в «Копировать»). 120000 было слишком много: TextView
# с сотней килобайт текста на слабом устройстве не открывался/подвисал.
# 60000 символов ≈ 1.5-2 тыс. строк — хватает, чтобы увидеть конец прогона.
LOG_SHOW_CHARS = 60000
# Как часто (сек) _log_line сбрасывает буфер на диск. Чаще нельзя: запись
# файла целиком на каждую строку — это O(n^2) на буфере в 50000 строк.
LOG_FLUSH_SEC = 2.0
MAX_DRAW = 60   # сколько строк рисуем в окне (400 виджетов = ANR)


def _java_color(argb):
    argb &= 0xFFFFFFFF
    return argb - 0x100000000 if argb > 0x7FFFFFFF else argb


def _iter_java(coll):
    """Итерация по Java-списку: на ArrayList питоновский for может падать."""
    if coll is None:
        return []
    try:
        n = _safe_int(coll.size())
        # size() может вернуть мусор (битый объект/упаковка) — range(10**9)
        # съел бы память и уронил сканирование. Разумный потолок.
        if 0 <= n <= 100000:
            return [coll.get(i) for i in range(n)]
        if n > 100000:
            return [coll.get(i) for i in range(100000)]
    except Exception as _exc88:
        _swallow_log('_iter_java@88', _exc88)
        pass
    # Строка/число — не коллекция: поэлементный разбор строки дал бы мусор
    # (заголовки из отдельных букв). Это всегда ошибка вызова, не данные.
    # java.lang.String не проходит isinstance(x, str), поэтому проверяем ещё
    # и по имени Java-класса: иначе такая строка разложилась бы по символам.
    if isinstance(coll, (str, bytes, bytearray, int, float, bool)):
        return []
    try:
        if "String" in type(coll).__name__ or "CharSequence" in type(coll).__name__:
            return []
    except Exception as _exc99:
        _swallow_log('_iter_java@99', _exc99)
        pass
    try:
        out = list(coll)
        return out[:100000] if len(out) > 100000 else out
    except Exception:
        return []


def _to_str(value):
    """ВСЕГДА питоновская строка.

    Java-объекты (SpannableStringBuilder, CharSequence, String) не имеют
    питоновских методов (.strip/.split/len). Приводим через toString().

    ВАЖНО: если toString() не сработал, возвращаем ПУСТУЮ строку, а не str().
    str() на голом Java-объекте даёт адрес в памяти («<... at 0x7f...>»),
    который меняется при каждом запуске: ключ дубля стал бы случайным и
    настоящие дубли не находились бы. Пустая строка безопаснее — такое
    сообщение просто не даст текстового ключа.
    """
    if value is None:
        return ""
    if isinstance(value, str):
        return value
    try:
        s = value.toString()
        if s is not None:
            return s if isinstance(s, str) else str(s)
    except Exception as _exc128:
        _swallow_log('_to_str@128', _exc128)
        pass
    # Числа/булевы — единственные типы, где str() осмыслен.
    if isinstance(value, (int, float, bool)):
        return str(value)
    return ""


# FLOOD_WAIT_N в ошибке сервера. Ждём и продолжаем с той же страницы.
_FLOOD_RE = re.compile(r"FLOOD_WAIT_(\d+)")


# Индекс быстрого скана живёт сутки. Дальше он опасен: хранит только самый
# свежий id на ключ, и если чат чистили в обход плагина, старые дубли
# не найдутся, а отчёт скажет «всё чисто».
_INDEX_MAX_AGE_H = 24

# Версия формата индекса. v1 — один id на ключ (старые дубли терялись),
# v2 — список всех id на ключ.
_INDEX_VERSION = 4


def _md5_or_empty(text):
    """md5(text), но для ПУСТОГО текста — пустая строка.

    Иначе md5("") = d41d8cd98f00b204e9800998ecf8427e совпадает у всех
    сообщений с нечитаемым полем, и плагин предлагает удалить РАЗНЫЕ
    сообщения как «дубли». Пустое поле не должно создавать ключ.
    """
    t = _to_str(text).strip()
    if not t:
        return ""
    return _md5(t)


def _md5(text):
    return hashlib.md5(_to_str(text).encode("utf-8", "ignore")).hexdigest()


def _msg_text(msg):
    """Текст/подпись сообщения как ПИТОНОВСКАЯ строка.

    У MessageObject поле называется `messageText` и это SpannableStringBuilder.
    """
    for attr in ("messageText", "message", "caption"):
        try:
            v = getattr(msg, attr, None)
            if v is None:
                continue
            s = _to_str(v)
            if s:
                return s
        except Exception as _exc180:
            _swallow_log('_msg_text@180', _exc180)
            continue
    return ""


def _msg_media(msg):
    """MessageMedia сообщения: пробуем messageOwner.media, затем media."""
    try:
        owner = getattr(msg, "messageOwner", None)
        if owner is not None:
            m = getattr(owner, "media", None)
            if m is not None:
                return m
    except Exception as _exc193:
        _swallow_log('_msg_media@193', _exc193)
        pass
    try:
        return getattr(msg, "media", None)
    except Exception:
        return None


def _msg_id(msg):
    """id сообщения из чего угодно: MessageObject, TLRPC-объект, Java-обёртка.

    Порядок: getId() (у MessageObject) -> поле id -> поле _id.
    int() на java.lang.Integer может не сработать, поэтому есть третий шаг
    через toString()/intValue().
    """
    if msg is None:
        return 0
    for getter in ("getId",):
        try:
            fn = getattr(msg, getter, None)
            if callable(fn):
                return _safe_int(fn())
        except Exception as _exc215:
            _swallow_log('_msg_id@215', _exc215)
            pass
    for attr in ("id", "_id"):
        try:
            v = getattr(msg, attr, None)
            if v is not None:
                n = _safe_int(v)
                if n:
                    return n
        except Exception as _exc224:
            _swallow_log('_msg_id@224', _exc224)
            pass
    return 0


def _attr_is_sticker(a):
    """Это TLRPC.DocumentAttributeSticker?

    Стикер в Telegram определяется НАЛИЧИЕМ этого атрибута в document.attributes,
    а не отдельным булевым полем документа: поля `sticker` у TLRPC.Document нет.
    Плагин раньше смотрел только флаги и потому на сборках без поля-флага не
    распознавал ни стикеры, ни наборы, ни премиум-стикеры.
    """
    try:
        if isinstance(a, TLRPC.TL_documentAttributeSticker):
            return True
    except Exception:
        pass
    return "documentattributesticker" in type(a).__name__.lower()


def _attr_sticker_gift(a):
    """Премиум/подарочный стикер: alt = 'premium' или отдельный атрибут."""
    try:
        alt = _to_str(getattr(a, "alt", "")).lower()
        if alt in ("premium", "gift"):
            return True
        if _read_flag(a, "premium", "isPremium"):
            return True
    except Exception:
        pass
    return False


def _read_flag(a, *names):
    """Читает булев флаг. Возвращает True/False, или None если поля нет вообще."""
    for nm in names:
        try:
            v = getattr(a, nm, None)
        except Exception as _exc234:
            _swallow_log('_read_flag@234', _exc234)
            continue
        if v is None:
            continue
        # bool() на java.lang.Boolean/Integer может бросить (нет __bool__) —
        # тогда флаг терялся, и gif/premium/quiz не распознавались. Читаем
        # booleanValue()/intValue(), а через bool() идём в последнюю очередь.
        for getter in ("booleanValue", "intValue", "longValue"):
            fn = getattr(v, getter, None)
            if callable(fn):
                try:
                    return bool(fn())
                except Exception as _exc246:
                    _swallow_log('_read_flag@246', _exc246)
                    pass
        try:
            return bool(v)
        except Exception:
            try:
                return bool(_safe_int(v))
            except Exception as _exc253:
                _swallow_log('_read_flag@253', _exc253)
                continue
    return None


def _has_attached_stickers(doc):
    """Принадлежит ли стикер НАБОРУ.

    В TLRPC.java у Document НЕТ поля attached_stickers (проверено по исходникам
    Telegram) — поэтому прежняя проверка не срабатывала НИКОГДА, и режим
    «наборы стикеров» не находил ничего. Верный признак: у атрибута
    DocumentAttributeSticker есть НЕПУСТОЙ stickerset (TL_inputStickerSetID либо
    TL_inputStickerSetShortName) — именно так стикер и привязан к набору.
    """
    try:
        for a in _iter_java(getattr(doc, "attributes", None)):
            if not _attr_is_sticker(a):
                continue
            ss = getattr(a, "stickerset", None)
            if ss is None:
                continue
            # непустой stickerset: у ID-варианта есть id, у short-name — short_name
            if _safe_int(getattr(ss, "id", 0)):
                return True
            if _to_str(getattr(ss, "short_name", "")).strip():
                return True
            if _to_str(getattr(ss, "name", "")).strip():
                return True
    except Exception as _exc276:
        _swallow_log('_has_attached_stickers@276', _exc276)
        pass
    # исторический фолбэк: если сборка всё-таки отдаёт список
    try:
        lst = getattr(doc, "attached_stickers", None)
        if lst is None:
            lst = getattr(doc, "stickers", None)
        if lst is not None:
            # bool(java.util.List) может бросить — считаем размер явно
            if hasattr(lst, "size"):
                try:
                    return _safe_int(lst.size()) > 0
                except Exception as _exc269:
                    _swallow_log('_has_attached_stickers@269', _exc269)
                    pass
            try:
                return bool(lst)
            except Exception:
                return bool(_iter_java(lst))
    except Exception as _exc275:
        _swallow_log('_has_attached_stickers@275', _exc275)
        pass
    return False


def _attr_is_audio(a):
    n = type(a).__name__.lower()
    return "attributeaudio" in n


def _attr_is_video(a):
    n = type(a).__name__.lower()
    return "attributevideo" in n


def _safe_int(v, default=0):
    """Число из чего угодно, БЕЗ падения и без потери значения.

    ВАЖНО: java.lang.Integer/Long/Double НЕ приводятся питоновским int().
    Раньше здесь был только int()/float(), и на Java-обёртке функция молча
    возвращала default — то есть 0. Это хуже исключения: ключи становились
    пустыми, и дубли просто не находились.

    Порядок: int() -> intValue()/longValue()/doubleValue() -> float() -> разбор
    строки -> default.
    """
    if v is None:
        return default
    if isinstance(v, bool):
        return int(v)
    # 1) питоновские числа и всё, что умеет int()
    try:
        return int(v)
    except Exception as _exc308:
        _swallow_log('_safe_int@308', _exc308)
        pass
    # 2) Java-обёртки (Chaquopy даёт методы, но не операторы)
    for getter in ("intValue", "longValue", "doubleValue", "floatValue"):
        fn = getattr(v, getter, None)
        if callable(fn):
            try:
                return int(fn())
            except Exception as _exc316:
                _swallow_log('_safe_int@316', _exc316)
                pass
    # 3) через float / строку
    try:
        return int(float(v))
    except Exception as _exc321:
        _swallow_log('_safe_int@321', _exc321)
        pass
    try:
        return int(float(_to_str(v).strip()))
    except Exception as _exc325:
        _swallow_log('_safe_int@325', _exc325)
        pass
    return default


# ---- Named, capped reporting for swallowed exceptions --------------------
# Молчаливое «except: pass/continue» превращает настоящий сбой в «прочитано 0»
# без причины в логе. Каждый поглощённый сбой обязан назвать СВОЙ контекст.
# Повторы гасим: первые CAP строк пишем полностью, дальше — одна строка-счётчик,
# чтобы сбой в цикле на 7000 сообщений не забил буфер лога.
_SWALLOW_N = {}
_SWALLOW_SINK = [None]   # сюда плагин кладёт свой _log_line


def _swallow_log(tag, exc, cap=8):
    """Записать поглощённое исключение с именем контекста (с ограничением).

    Первые cap повторов пишем целиком, на (cap+1)-м — одну строку-итог и
    дальше молчим: иначе сбой в цикле на 7000 сообщений забьёт весь лог.
    """
    try:
        n = _SWALLOW_N.get(tag, 0) + 1
        _SWALLOW_N[tag] = n
        if n == 1:
            line = "[swallow] %s: %s: %s" % (tag, type(exc).__name__, exc)
        elif n <= cap:
            line = "[swallow] %s: %s: %s (повтор %d)" % (
                tag, type(exc).__name__, exc, n)
        elif n == cap + 1:
            line = ("[swallow] %s: %s — дальше повторы молча "
                    "(показаны 1..%d)" % (tag, type(exc).__name__, cap))
        else:
            return
        sink = _SWALLOW_SINK[0]
        if sink is not None:
            sink(line)
        else:
            # Раньше здесь стоял вызов log(line) — функции log в модуле НЕТ,
            # поэтому fallback молча падал в свой же except и строка терялась.
            # Пока плагин не установил _SWALLOW_SINK (до on_plugin_load),
            # пишем в stdout — он попадает в лог клиента.
            try:
                print(line)
            except Exception:
                pass
    except Exception:
        pass


def _fnum(obj, *names):
    """Число с плавающей точкой по нескольким именам (для координат).

    Java-обёртка (java.lang.Double) через float() может не привестись —
    тогда координаты молча становились 0.0, и все гео-точки склеивались
    в один ключ. Пробуем doubleValue()/floatValue() до обычного float().
    """
    for nm in names:
        try:
            v = getattr(obj, nm, None)
        except Exception as _exc380:
            _swallow_log('_fnum@380', _exc380)
            continue
        if v is None:
            continue
        for getter in ("doubleValue", "floatValue", "longValue", "intValue"):
            fn = getattr(v, getter, None)
            if callable(fn):
                try:
                    return float(fn())
                except Exception as _exc389:
                    _swallow_log('_fnum@389', _exc389)
                    pass
        try:
            return float(v)
        except Exception:
            try:
                return float(_to_str(v))
            except Exception as _exc396:
                _swallow_log('_fnum@396', _exc396)
                continue
    return 0.0


def _kind_of(msg):
    """Универсальный тип содержимого.

    text / photo / video / gif / voice / audio / sticker / doc / poll /
    quiz / geo / venue / contact / webpage / dice / game / gift / premium
    """
    media = _msg_media(msg)
    if media is None or isinstance(media, TLRPC.TL_messageMediaEmpty):
        return "text" if _msg_text(msg).strip() else "other"

    nm = type(media).__name__.lower()

    if isinstance(media, TLRPC.TL_messageMediaPhoto):
        return "photo"

    # --- типы, у которых нет TL_messageMedia*-класса в наборе версии ---
    # проверяем по имени класса (мост может отдавать любые варианты)
    if "webpage" in nm:
        return "webpage"
    if "venue" in nm:
        return "venue"
    if "geo" in nm:           # geo / geolive
        return "geo"
    if "contact" in nm:
        return "contact"
    if "dice" in nm:
        return "dice"
    if "game" in nm:
        return "game"
    if "story" in nm:
        return "story"
    if "invoice" in nm:
        return "invoice"
    if "giveawayresults" in nm:
        return "giveawayres"
    if "giveaway" in nm:
        return "giveaway"
    if "paidmedia" in nm:
        return "paidmedia"
    if "todo" in nm:
        return "todo"
    if "videostream" in nm:
        return "videostream"
    if "unsupported" in nm:
        return "unsupported"

    if isinstance(media, TLRPC.TL_messageMediaDocument):
        doc = getattr(media, "document", None)
        if doc is None:
            return "other"
        # Стикер — это флаг документа ИЛИ (что вернее) наличие атрибута
        # DocumentAttributeSticker в списке attributes: отдельного булева поля
        # `sticker` у TLRPC.Document нет, поэтому опора только на флаг давала
        # «стикеры не распознаются» на живых сборках.
        _attrs = list(_iter_java(getattr(doc, "attributes", None)))
        _sticker_attr = None
        for _a in _attrs:
            if _attr_is_sticker(_a):
                _sticker_attr = _a
                break
        if _sticker_attr is not None or _read_flag(doc, "sticker", "isSticker", "_sticker"):
            # премиум-подарок/коллекционный стикер vs обычный
            _prem = _read_flag(doc, "premium", "isPremium", "_premium")
            # премиум может стоять НЕ в первом стикер-атрибуте: проверяем все,
            # иначе альбомный/обычный атрибут перекрывал бы подарочный.
            if not _prem:
                for _a2 in _attrs:
                    if _attr_is_sticker(_a2) and _attr_sticker_gift(_a2):
                        _prem = True
                        break
            if _prem:
                return "premium"
            # НАБОР стикеров: у документа есть список прикреплённых стикеров
            if _has_attached_stickers(doc):
                return "stickerset"
            return "sticker"
        mime = _to_str(getattr(doc, "mime_type", "")).lower()

        voice = False
        round_video = False
        has_audio_attr = False
        voice_flag_readable = False
        for a in _iter_java(getattr(doc, "attributes", None)):
            if _attr_is_audio(a):
                has_audio_attr = True
                fv = _read_flag(a, "voice", "isVoice", "_voice")
                if fv is not None:
                    voice_flag_readable = True
                    if fv:
                        voice = True
            if _attr_is_video(a):
                rv = _read_flag(a, "round_message", "isRound", "_round_message")
                if rv:
                    round_video = True

        # Fallback ТОЛЬКО если флаг вообще не читается (мост не отдал поле)
        if (not voice_flag_readable) and has_audio_attr and mime in ("audio/ogg", "audio/opus"):
            voice = True

        if voice:
            return "voice"
        # bool() на Java-объекте может упасть -> читаем флаг через _read_flag
        # (он в try) и только потом сравниваем mime.
        if _read_flag(doc, "gif", "isGif", "_gif") or mime == "image/gif":
            return "gif"
        if round_video:
            return "roundv"      # кружок — отдельный тип
        if mime.startswith("video/"):
            return "video"
        if mime.startswith("audio/"):
            return "audio"
        return "doc"

    if isinstance(media, TLRPC.TL_messageMediaPoll):
        poll = getattr(media, "poll", None)
        if poll is not None and _read_flag(poll, "quiz", "isQuiz", "_quiz"):
            return "quiz"
        return "poll"

    return "other"


def _dup_key(msg):
    """Стабильный ключ. '' = сообщение в дедупе не участвует.

    Текст   -> нормализованный текст (все пробелы в один), md5
    Фото    -> photo.id  (то же фото, даже пересланное = дубликат)
    Видео/gif/voice/audio/doc -> document.id + размер
    Стикер  -> document.id
    Опрос   -> вопрос + варианты
    Подписи (caption) в ключ НЕ входят -> одно фото с разными подписями = дубликат.
    """
    kind = _kind_of(msg)

    if kind == "text":
        # та же нормализация, что и в комбо (_text_norm): пробелы + регистр вниз.
        # Иначе «Привет» и «привет» считались бы РАЗНЫМИ в режиме текст,
        # но ДУБЛЯМИ в комбо — противоречивое поведение.
        norm = _text_norm(_msg_text(msg))
        return ("T|" + _md5(norm)) if norm else ""

    if kind == "photo":
        media = _msg_media(msg)
        photo = getattr(media, "photo", None) if media is not None else None
        pid = getattr(photo, "id", 0) if photo is not None else 0
        return ("P|%d" % _safe_int(pid)) if _safe_int(pid) else ""

    if kind == "sticker":
        media = _msg_media(msg)
        doc = getattr(media, "document", None) if media is not None else None
        did = getattr(doc, "id", 0) if doc is not None else 0
        return ("S|%d" % _safe_int(did)) if _safe_int(did) else ""

    if kind == "premium":
        media = _msg_media(msg)
        doc = getattr(media, "document", None) if media is not None else None
        did = getattr(doc, "id", 0) if doc is not None else 0
        return ("X|%d" % _safe_int(did)) if _safe_int(did) else ""

    if kind == "stickerset":
        media = _msg_media(msg)
        doc = getattr(media, "document", None) if media is not None else None
        did = getattr(doc, "id", 0) if doc is not None else 0
        return ("N|%d" % _safe_int(did)) if _safe_int(did) else ""

    # --- гео / место / контакт / веб-страница / дайс / игра ---
    if kind == "geo":
        media = _msg_media(msg)
        geo = getattr(media, "geo", None)
        lat = _fnum(geo, "lat", "_lat")
        lon = _fnum(geo, "long", "_long", "lon")
        acc = _fnum(geo, "accuracy_radius", "accuracyRadius")
        if lat == 0.0 and lon == 0.0:
            return ""   # нулевые координаты: у всех таких было бы "Z|0.0,0.0" -> ложный дубль
        return "Z|%.6f,%.6f,%d" % (lat, lon, _safe_int(acc))

    if kind == "venue":
        media = _msg_media(msg)
        geo = getattr(media, "geo", None)
        lat = _fnum(geo, "lat", "_lat")
        lon = _fnum(geo, "long", "_long", "lon")
        title = " ".join(_to_str(getattr(media, "title", "")).split())
        addr = " ".join(_to_str(getattr(media, "address", "")).split())
        if lat == 0.0 and lon == 0.0 and not title and not addr:
            return ""   # нечего сравнивать: пустой venue дал бы ложный дубль
        return "E|%.6f,%.6f|%s|%s" % (lat, lon, _md5_or_empty(title), _md5_or_empty(addr))

    if kind == "contact":
        media = _msg_media(msg)
        _ph = getattr(media, "phone_number", None)
        if _ph is None:
            _ph = getattr(media, "phone", "")
        phone = _to_str(_ph)
        fn = " ".join(_to_str(getattr(media, "first_name", "")).split())
        ln = " ".join(_to_str(getattr(media, "last_name", "")).split())
        phone = "".join(ch for ch in phone if ch.isdigit() or ch == "+")
        # Без телефона два РАЗНЫХ контакта с одним именем («Иван») дали бы
        # одинаковый ключ, и один из них удалился бы как «дубль». Поэтому:
        #  - учитываем user_id и vcard, если они есть;
        #  - без телефона ключ строим только когда есть И имя, И фамилия
        #    (одного имени для совпадения мало).
        uid = _safe_int(getattr(media, "user_id", 0))
        vcard = _to_str(getattr(media, "vcard", "")).strip()
        if not phone and not uid and not (fn and ln):
            return ""
        return "K|%s|%s|%s|%d|%s" % (_md5_or_empty(phone), _md5_or_empty(fn),
                                     _md5_or_empty(ln), uid, _md5_or_empty(vcard))

    if kind == "webpage":
        media = _msg_media(msg)
        wp = getattr(media, "webpage", None)
        url = _normalize_url(_to_str(getattr(wp, "url", "")) if wp is not None else "")
        if url:
            return "W|" + url
        wid = getattr(wp, "id", 0) if wp is not None else 0
        # если id нет — пробуем текст сообщения как ссылку
        ul = _extract_links(_msg_text(msg))
        if ul:
            return "W|" + ul[0]
        return ("W|id:%d" % _safe_int(wid)) if _safe_int(wid) else ""

    if kind == "dice":
        media = _msg_media(msg)
        _em = getattr(media, "emoticon", None)
        if _em is None:
            _em = getattr(media, "emoji", "")
        emoji = _to_str(_em)
        val = _safe_int(getattr(media, "value", None), -1)
        if not emoji and val <= 0:
            return ""   # нечитаемый кубик -> ложный дубль
        return "I|%s|%d" % (emoji, val)

    if kind == "game":
        media = _msg_media(msg)
        game = getattr(media, "game", None)
        gid = getattr(game, "id", 0) if game is not None else 0
        title = " ".join(_to_str(getattr(game, "title", "")).split()) if game is not None else ""
        return ("J|%d|%s" % (_safe_int(gid), _md5(title))) if _safe_int(gid) else ""

    # --- прочие типы по официальному списку MessageMedia ---
    if kind == "story":
        media = _msg_media(msg)
        peer = getattr(media, "peer", None)
        sid = getattr(media, "id", 0)
        # user_id/channel_id — java.lang.Integer/long: проверка истинности
        # через `if not` бросает TypeError, и история теряла ключ (не дедуплицировалась).
        pid = _safe_int(getattr(peer, "user_id", 0)) or _safe_int(getattr(peer, "channel_id", 0))
        if not _safe_int(pid) and not _safe_int(sid):
            return ""   # нечитаемая история -> ложный дубль со всеми такими
        return "Y|%d|%d" % (_safe_int(pid), _safe_int(sid))

    if kind == "invoice":
        media = _msg_media(msg)
        title = " ".join(_to_str(getattr(media, "title", "")).split())
        cur = _to_str(getattr(media, "currency", ""))
        amt = _safe_int(getattr(media, "total_amount", 0))
        if not title and not cur and not amt:
            return ""
        return "B|%s|%s|%d" % (_md5_or_empty(title), cur, amt)

    if kind == "giveaway":
        media = _msg_media(msg)
        qty = _safe_int(getattr(media, "quantity", 0))
        months = _safe_int(getattr(media, "months", 0))
        until = _safe_int(getattr(media, "until_date", 0))
        # КАНАЛЫ розыгрыша (Vector<long>), порядок не важен -> сортировка
        chans = []
        for c in _iter_java(getattr(media, "channels", None)):
            # int() на java.lang.Long может не сработать -> канал терялся бы,
            # и розыгрыш не дедуплицировался вовсе. _safe_int приводит безопасно.
            _c = _safe_int(c)
            if _c:
                chans.append(str(_c))
        if not _safe_int(qty) and not _safe_int(months) and not _safe_int(until) and not chans:
            return ""
        return "Z2|%d|%d|%d|%s" % (qty, months, until, _md5_or_empty("|".join(sorted(set(chans)))))

    if kind == "giveawayres":
        media = _msg_media(msg)
        cid = _safe_int(getattr(media, "channel_id", 0))
        launch = _safe_int(getattr(media, "launch_msg_id", 0))
        # ПОБЕДИТЕЛИ (Vector<long>), порядок не важен -> сортировка
        wins = []
        for w in _iter_java(getattr(media, "winners", None)):
            _w = _safe_int(w)
            if _w:
                wins.append(str(_w))
        if not _safe_int(cid) and not _safe_int(launch) and not wins:
            return ""
        return "Z3|%d|%d|%s" % (cid, launch, _md5_or_empty("|".join(sorted(set(wins)))))

    if kind == "paidmedia":
        media = _msg_media(msg)
        stars = _safe_int(getattr(media, "stars_amount", 0))
        # СОСТАВ вложений (id каждого), порядок не важен -> сортировка.
        # Одного количества мало: два разных набора из 3 фото дали бы ложный дубль.
        sigs = []
        for em in _iter_java(getattr(media, "extended_media", None)):
            sg = _media_sig(getattr(em, "media", None))
            if sg:
                sigs.append(sg)
        sigs = sorted(set(sigs))
        if not stars and not sigs:
            return ""
        return "Z4|%d|%d|%s" % (stars, len(sigs), _md5_or_empty("|".join(sigs)))

    if kind == "todo":
        media = _msg_media(msg)
        todo = getattr(media, "todo", None)
        title = " ".join(_to_str(getattr(todo, "title", "")).split()) if todo is not None else ""
        items = []
        if todo is not None:
            # НЕ `a or b`: для Java-коллекции `or` вызывает bool() -> len(),
            # которого у ArrayList нет -> TypeError и краш скана.
            coll = getattr(todo, "list", None)
            if coll is None:
                coll = getattr(todo, "items", None)
            for it in _iter_java(coll):
                items.append(_to_str(getattr(it, "title", "")))
        # порядок пунктов не важен -> сортировка
        if not title and not items:
            return ""
        return "Z5|%s|%s" % (_md5_or_empty(title), _md5_or_empty("|".join(sorted(items))))

    if kind == "videostream":
        media = _msg_media(msg)
        call = getattr(media, "call", None)
        cid = _safe_int(getattr(call, "id", 0) if call is not None else 0)
        return ("Z6|%d" % cid) if cid else ""

    if kind == "unsupported":
        # клиент не умеет читать этот тип — дедуплицировать нечего
        return ""

    if kind in ("video", "gif", "voice", "audio", "doc", "roundv"):
        media = _msg_media(msg)
        doc = getattr(media, "document", None) if media is not None else None
        did = getattr(doc, "id", 0) if doc is not None else 0
        if not _safe_int(did):
            return ""
        # префиксы РАЗНЫЕ: V=video, G=gif, D=doc, A=audio, O=voice.
        # В ключ входит ТОЛЬКО server id + размер — имя файла не участвует,
        # поэтому два разных файла с одинаковым именем НЕ склеятся.
        pfx = {"video": "V", "gif": "G", "doc": "D",
               "audio": "A", "voice": "O", "roundv": "R"}[kind]
        return "%s|%d|%d" % (pfx, _safe_int(did), _safe_int(getattr(doc, "size", 0)))

    if kind == "poll" or kind == "quiz":
        media = _msg_media(msg)
        poll = getattr(media, "poll", None) if media is not None else None
        if poll is None:
            return ""
        q = " ".join(_to_str(getattr(poll, "question", "")).split())
        # порядок ответов не важен -> сортировка
        answers = sorted(_to_str(getattr(a, "text", "")) for a in _iter_java(getattr(poll, "answers", None)))
        pfx = "VQ" if kind == "quiz" else "Q"
        return pfx + "|" + _md5(q + "|" + "|".join(answers))

    return ""


